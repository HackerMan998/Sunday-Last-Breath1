:: Unit_408 {"position":"0,650","size":"100,100"}
<!-- ======================================================= -->
<!-- INITIALIZATION & SETUP                                  -->
<!-- ======================================================= -->
<<nobr>>
    /* AUDIO: Ticking Clock Room Tone */
    <<run setup.sound.play("ticking_clock", "audio/sfx/tick.mp3", true, 0.2)>>

    <<set $currentLocation to "408">>
    
    /* Variable Defaults */
    <<if not $room408_opened>><<set $room408_opened to false>><</if>>
    <<if not $failed_408_attempts>><<set $failed_408_attempts to 0>><</if>>
    <<if not $studied_408_mechanics>><<set $studied_408_mechanics to false>><</if>>
    <<if not $studied_408_anatomy>><<set $studied_408_anatomy to false>><</if>>
    <<if not $looted_408>><<set $looted_408 to false>><</if>>
    <<if not $read_408_journal>><<set $read_408_journal to false>><</if>>
    <<if not $looted_408_kitchen>><<set $looted_408_kitchen to false>><</if>>

    /* Setup Physical Bypass Costs */
    <<set _baseCost to 15>>
    <<set _halfCost to Math.round(_baseCost / 2)>>
<</nobr>>

<<nobr>>
<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">

        <!-- ======================================================= -->
        <!-- PHASE 1: EXTERIOR (THE KEYPAD)                          -->
        <!-- ======================================================= -->
        <<if not $room408_opened>>
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                UNIT 408 - THE KEYPAD
            </div>

            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                Professor Harmon taught history and behavioral sociology at the university. You'd chatted with him in the elevator a few times — he always smelled like old paper and peppermint tea. He talked about the psychology of collapsing civilizations the way most people talked about the weather. <i>Inevitable. Fascinating. Nothing personal.</i>
                <br><br>
                The door is sealed with a heavy electronic lock. A small keypad glows faintly in the dark hallway, its LEDs casting a cold blue light across your fingers. Four blank digits. Waiting.
                <br><br>
                Someone has taped a yellowed index card above the scanner. The handwriting is spidery, hurried, and precise:

                <div style="padding:10px; background:#0a0a0a; border:1px solid #333; color:#aaa; font-style:italic; margin:10px 0; text-align:center;">
                    "If I'm not answering, I'm either dead or I finally took my own advice and ran.<br>Either way, you're not getting in."
                </div>

                You almost smile. Almost.
                <br><br>
                <<chat "You" "image/avatars/player.gif" "left" "Dark sense of humor. I hope you made it out of the city, Professor.">>
            </div>

            <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
                
                <!-- WRAPPER UNTUK MENYEMBUNYIKAN MENU SAAT MINIGAME AKTIF -->
                <div id="room408-interactions">
                
                    <!-- KEYPAD STATE: BRICKED -->
                    <<if $room408_locked_out>>
                        <div style="padding:10px; background:rgba(138,28,28,0.3); border:1px solid var(--accent-red); color:#ff6b6b; margin-bottom:15px; text-align:center;">
                            ⛔ <b>PERMANENTLY LOCKED OUT.</b> The keypad triggered its security failsafe after three wrong attempts. The software is sealed. You will have to bypass it physically.
                        </div>
                        <<chat "You" "image/avatars/player.gif" "left" "Damn it. It bricked itself. Time to do this the hard way.">>
                    
                    <!-- KEYPAD STATE: ACTIVE -->
                    <<else>>
                        <div style="margin-bottom:20px; padding:15px; background:rgba(0,0,0,0.3); border-left:3px solid var(--accent-blue);">
                            <b style="color:var(--accent-blue);">⚙️ HOW DO YOU PROCEED?</b><br><br>

                            <!-- SECRET LORE CHECK: HIDDEN PATH KEPT -->
                            <<if visited("Prologue_Phone")>>
                                <button>
                                    <<link "📱 Enter the code you saw on your phone (8445)">>
                                        <<set $room408_opened to true>>
                                        <<goto "Unit_408">>
                                    <</link>>
                                    <span class="btn-sub">1 Minute | You saw a text from him earlier. You didn't know what it was for at the time. Now you do.</span>
                                </button>
                            <</if>>

                            <!-- FAILED ATTEMPT WARNING -->
                            <<if $failed_408_attempts > 0>>
                                <div style="padding:8px; background:rgba(138,28,28,0.2); border:1px solid #8a1c1c; color:#ff9999; margin-bottom:10px;">
                                    ⚠️ <b>WRONG CODE.</b> Attempts remaining: <<print 3 - $failed_408_attempts>>. Three failures trigger the lockout permanently.
                                </div>
                            <</if>>

                            <!-- MANUAL ENTRY -->
                            <div style="margin-bottom: 10px;">
                                <<textbox "$player_code_attempt" "" autofocus>>
                            </div>
                            <button>
                                <<link "🔢 Enter a code manually">>
                                    <<if $player_code_attempt == "8445">>
                                        <<set $room408_opened to true>>
                                        <<goto "Unit_408">>
                                    <<else>>
                                        <<addTime 1>>
                                        <<set $failed_408_attempts += 1>>
                                        <<if $failed_408_attempts >= 3>>
                                            <<set $room408_locked_out to true>>
                                        <</if>>
                                        <<goto "Unit_408">>
                                    <</if>>
                                <</link>>
                                <span class="btn-sub">1 Minute | Four digits. Think carefully — you only get three attempts before the failsafe triggers.</span>
                            </button>
                        </div>
                    <</if>>

                    <!-- HARDWARE BYPASS GRID (Always available) -->
                    <div style="margin-top:10px; padding:15px; background:rgba(80,0,0,0.2); border-left:3px solid var(--accent-gold);">
                        <b style="color:var(--accent-gold);">⚠️ HARDWARE BYPASS</b><br><br>

                        <!-- FAILED BRUTE FORCE WARNING MESSAGE -->
                        <<if $room408_bruteforce_fail>>
                            <div style="padding:10px; background:rgba(138,28,28,0.3); border:1px solid var(--accent-red); color:#ff6b6b; margin-bottom:15px; text-align:center;">
                                ❌ <b>BRUTE FORCE FAILED.</b> You battered the housing, but the internal deadbolt didn't budge. Your hands are bleeding, and you just wasted precious energy. 
                            </div>
                            <<unset $room408_bruteforce_fail>>
                        <</if>>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">

                            <!-- 1. PLAYER JOB: BURGLAR -->
                            <<if $job == "Burglar">>
                                <button style="height: 100%;">
                                    <<link "Override the electronic latch">>
                                        <<addTime 2>><<exert _halfCost>><<set $room408_opened to true>><<goto "Unit_408">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[BURGLAR]</b> Cost: <<print _halfCost>> STAMINA. You've cracked tougher systems than this apartment lock.</span>
                                </button>
                            <<else>>
                                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                    <span style="text-decoration: line-through;">Override the electronic latch</span><br>
                                    <span class="btn-sub" style="color: #666;">[REQUIRES BURGLAR] You lack the specialized knowledge to trick the mechanism.</span>
                                </button>
                            <</if>>

                            <!-- 2. PLAYER TRAIT: LOCKSMITH -->
                            <<if hasTrait("LOCKSMITH")>>
                                <button style="height: 100%;">
                                    <<link "Exploit the mechanical failsafe">>
                                        <<addTime 3>><<exert _halfCost>><<set $room408_opened to true>><<goto "Unit_408">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[LOCKSMITH]</b> Cost: <<print _halfCost>> STAMINA. Every electronic lock has a physical override pin. You find it.</span>
                                </button>
                            <<else>>
                                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                    <span style="text-decoration: line-through;">Exploit the failsafe</span><br>
                                    <span class="btn-sub" style="color: #666;">[REQUIRES LOCKSMITH] You don't know where the physical override pin is located.</span>
                                </button>
                            <</if>>

                            <!-- 3. PLAYER SKILL: TECH 2 -->
                            <<if $skills.tech >= 2>>
                                <button style="height: 100%;">
                                    <<link "Bypass the keypad circuit">>
                                        <<addTime 4>><<exert _halfCost>><<set $room408_opened to true>><<goto "Unit_408">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[TECH 2]</b> Cost: <<print _halfCost>> STAMINA. You pull the panel and bridge the latch relay wire.</span>
                                </button>
                            <<else>>
                                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                    <span style="text-decoration: line-through;">Bypass the keypad circuit</span><br>
                                    <span class="btn-sub" style="color: #666;">[REQUIRES TECH 2] You lack the knowledge to safely hotwire the board.</span>
                                </button>
                            <</if>>

                            <!-- 4. PLAYER ITEM: MULTI-TOOL -->
                            <<if $inventory.find(i => i.id === "Multi-Tool")>>
                                <button style="height: 100%;">
                                    <<link "Disassemble the housing">>
                                        <<addTime 3>><<exert _halfCost>><<set $room408_opened to true>><<goto "Unit_408">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[MULTI-TOOL]</b> Cost: <<print _halfCost>> STAMINA. You unscrew the faceplate and retract the deadbolt.</span>
                                </button>
                            <<else>>
                                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                    <span style="text-decoration: line-through;">Disassemble the housing</span><br>
                                    <span class="btn-sub" style="color: #666;">[REQUIRES MULTI-TOOL] You don't have tools to take the faceplate off.</span>
                                </button>
                            <</if>>

                            <!-- 5. PLAYER ATTRIBUTE: PERCEPTION 6 -->
                            <<if $per >= 6 and not $room408_locked_out>>
                                <button style="height: 100%;">
                                    <<link "Read the finger smudges">>
                                        <<exert 0>><<set $room408_opened to true>><<goto "Unit_408">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[PER 6]</b> Cost: 0 STAMINA. The 8, 4, and 5 keys have heavy smudges. You guess the sequence.</span>
                                </button>
                            <<else>>
                                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                    <span style="text-decoration: line-through;">Read the finger smudges</span><br>
                                    <span class="btn-sub" style="color: #666;">[REQUIRES PER 6] Your eyes aren't sharp enough to pick up wear patterns.</span>
                                </button>
                            <</if>>

                            <!-- 6. LAST RESORT: BRUTE FORCE (MINIGAME SCALING) -->
                            <<if $str >= 6>>
                                <button style="grid-column: span 2; border-left-color: var(--accent-gold) !important;">
                                    <<link "Smash the keypad housing [STR 6/6]">>
                                        <<addTime 3>><<exert _baseCost>><<set $room408_opened to true>><<goto "Unit_408">>
                                    <</link>>
                                    <span class="btn-sub">
                                        <b style="color:var(--accent-gold);">[STR <<print $str>>/6]</b> Cost: <<print _baseCost>> STAMINA. Your high Strength guarantees you can shatter the housing easily without triggering the alarm.
                                    </span>
                                </button>
                            <<else>>
                                <button style="grid-column: span 2; border-left-color: var(--accent-red) !important;">
                                    <<link "Smash the keypad housing [MINIGAME]">>
                                        <<run $("#room408-interactions").hide(); $("#qte-wrapper-408").fadeIn(300);>>
                                    <</link>>
                                    <span class="btn-sub">
                                        <b style="color:var(--accent-red);">[STR <<print $str>>/6]</b> You aren't strong enough to just rip it off. You'll have to time your strikes perfectly to hit the weak point.
                                    </span>
                                </button>
                            <</if>>

                        </div>
                    </div>

                    <hr style="border-color: #333; margin: 20px 0;">
                    <button style="background: rgba(255,255,255,0.05) !important; border-color: #555 !important;">
                        <<link "🚪 Give up and return to the hallway">>
                            <<unset $room408_bruteforce_fail>>
                            <<run setup.sound.fade("ticking_clock", 1000)>>
                            <<set $hallwaySection to 1>>
                            <<goto "Hallway">>
                        <</link>>
                    </button>
                </div> <!-- END OF ROOM 408 INTERACTIONS -->

                <!-- PEMANGGILAN WIDGET MINIGAME UNTUK 408 (STRENGTH) -->
                <div id="qte-wrapper-408" style="display: none; padding-top: 15px;">
                    
                    <!-- Kalkulasi Dinamis Berdasarkan Kekuatan (Target STR = 6) -->
                    <<set _statDiff to (6 - $str)>>
                    <!-- Kecepatan dasar 2.0. Setiap kekurangan 1 STR menambah kecepatan 0.8 -->
                    <<set _qteSpeed to 2.0 + (_statDiff * 0.8)>>
                    <!-- Lebar dasar 30%. Setiap kekurangan 1 STR mengurangi lebar 5% -->
                    <<set _qteWidth to 30 - (_statDiff * 5)>>

                    <!-- Panggil Widget dengan hasil kalkulasi -->
                    <<Minigame_QTE _qteSpeed _qteWidth>>
                    
                    <span style="display:none;">
                        <span id="qte-win-trigger">
                            <<link "WIN">>
                                <<addTime 3>><<exert _baseCost>><<set $room408_opened to true>><<goto "Unit_408">>
                            <</link>>
                        </span>
                        <span id="qte-lose-trigger">
                            <<link "LOSE">>
                                <<addTime 3>><<exert _baseCost>><<set $room408_bruteforce_fail to true>><<goto "Unit_408">>
                            <</link>>
                        </span>
                    </span>
                </div>

            </div>

        <!-- ======================================================= -->
        <!-- PHASE 2: INSIDE THE STUDY (OPENED)                      -->
        <!-- ======================================================= -->
        <<else>>
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                UNIT 408 - THE PROFESSOR'S STUDY
            </div>

            <!-- TAMBAHKAN GAMBAR DI SINI -->
            <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
                <img src="image/unit408.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
            </div>

            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                The heavy door swings open into darkness.
                <br><br>
                The smell reaches you first: old paper, dust, and something faintly sweet like peppermint. But there is also the stark emptiness of a room that has been hastily abandoned.
                <br><br>
                The Professor is gone. Drawers are pulled open. His heavy winter coat and hiking backpack are missing from the coat rack. But he couldn't take the books. Floor-to-ceiling shelves line all four walls. Journals and monographs are stacked three deep on the coffee table. 
                <br><br>
                His reading glasses sit folded on an open book — <i>The Fall of Rome</i>, marked with a yellow sticky note:

                <div style="padding:10px; background:#0a0a0a; border:1px solid #333; color:#aaa; font-style:italic; margin:10px 0; text-align:center;">
                    "Every empire ends. We're just living in the intermission. Take what you need."
                </div>

                <<chat "You" "image/avatars/player.gif" "left" "He didn't just see this coming. He packed up and left before the alarms even started.">>
            </div>

            <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
                <div style="margin-bottom:20px; padding:15px; background:rgba(0,0,0,0.3); border-left:3px solid var(--accent-blue);">
                    <b style="color:var(--accent-blue);">📚 WHAT DO YOU DO?</b><br><br>
                    <div style="font-family: 'Courier Prime', monospace; color: #aaa; font-size: 0.85em; margin-bottom: 15px;">
                        You don't have time to read entire books while the city burns outside. But Harmon didn't just leave books—he left survival manuals with frantic, handwritten notes shoved between the pages.
                    </div>

                    <!-- ACTION: STUDY MECHANICS -->
                    <<if not $studied_408_mechanics>>
                        <button>
                            <<link "📖 Skim 'Advanced Mechanics' notes (20 minutes)">>
                                <<addTime 19>>
                                <<set $studied_408_mechanics to true>>
                                <<set $skills.tech += 1>>
                                <<goto "Unit_408">>
                            <</link>>
                            <span class="btn-sub"><b style="color:var(--accent-green);">[TECH +1]</b> You flip through the bookmarked pages. His notes on jury-rigging engines and bypassing civilian security systems are brilliant. You memorize what you can.</span>
                        </button>
                    <<else>>
                        <div style="padding:8px; background:rgba(255,255,255,0.05); color:#888; font-style:italic; font-size:0.85em; margin-bottom:10px; text-align:center;">
                            📖 You've already stripped the engineering textbook of all its useful notes.
                        </div>
                    <</if>>

                    <!-- ACTION: STUDY ANATOMY -->
                    <<if not $studied_408_anatomy>>
                        <button>
                            <<link "📖 Skim 'Gray's Anatomy' notes (20 minutes)">>
                                <<addTime 19>>
                                <<set $studied_408_anatomy to true>>
                                <<set $skills.medicine += 1>>
                                <<goto "Unit_408">>
                            <</link>>
                            <span class="btn-sub"><b style="color:var(--accent-green);">[MEDICINE +1]</b> He aggressively highlighted chapters on trauma care, blood-borne pathogens, and the central nervous system. You commit the diagrams to memory.</span>
                        </button>
                    <<else>>
                        <div style="padding:8px; background:rgba(255,255,255,0.05); color:#888; font-style:italic; font-size:0.85em; margin-bottom:10px; text-align:center;">
                            📖 You've already absorbed the highlighted trauma care procedures.
                        </div>
                    <</if>>

                    <!-- ACTION: READ LORE JOURNAL -->
                    <<if not $read_408_journal>>
                        <button>
                            <<link "📓 Read his personal journal (10 minutes)">>
                                <<set $read_408_journal to true>>
                                <<set $per += 1>>
                                <<addTime 9>>
                                <<run window.addLore("Professor Harmon's Journal", "His handwriting degrades into a frantic scrawl toward the end. He documented unmarked FEMA transports operating at night and the CDC's total blackout protocols. His last entry reads: 'The state lies because panic moves faster than infection. But cognitive dissonance is the real plague. My neighbors ignore the sirens, convinced the Guard has it handled. We are actively choosing not to see the end.'")>>
                                <<goto "Unit_408">>
                            <</link>>
                            <span class="btn-sub"><b style="color:var(--accent-green);">[PER +1]</b> His handwriting degrades into a frantic scrawl toward the end. He documented unmarked FEMA transports operating at night and the CDC's blackout protocols.</span>
                        </button>
                    <<else>>
                        <div style="padding:8px; background:rgba(255,255,255,0.05); color:#888; font-style:italic; font-size:0.85em; margin-bottom:10px; text-align:center;">
                            📓 You've already read the journal and added the intel to your PDA.
                        </div>
                    <</if>>

                    <!-- ACTION: LOOT KITCHEN -->
                    <<if not $looted_408_kitchen>>
                        <button>
                            <<link "🍵 Search the abandoned kitchen (5 minutes)">>
                                <<set $looted_408_kitchen to true>>
                                <<addTime 4>>
                                <<run setup.addItem("Canned Food", 1)>>
                                <<run setup.addItem("Energy Bar", 1)>>
                                <<run setup.addItem("Bottled Water", 2)>>
                                <<goto "Unit_408">>
                            <</link>>
                            <span class="btn-sub">He packed light, leaving the heavier items behind. You find canned food, an energy bar, and sealed bottles of water.</span>
                        </button>
                    <</if>>

                    <!-- ACTION: LOOT STUDY -->
                    <<if not $looted_408>>
                        <button>
                            <<link "🔍 Raid the desk drawers (5 minutes)">>
                                <<addTime 4>>
                                <<set $looted_408 to true>>
                                <<run setup.addItem("Encyclopedia", 1)>>
                                <<run setup.addItem("Flashlight", 1)>>
                                <<goto "Unit_408">>
                            <</link>>
                            <span class="btn-sub">You find a heavy, hard-bound Encyclopedia (could be used for blunt force) and a fully charged Flashlight.</span>
                        </button>
                    <</if>>
                </div>

                <!-- COMPLETION STATE -->
                <<if $studied_408_mechanics and $studied_408_anatomy and $read_408_journal and $looted_408_kitchen and $looted_408>>
                    <div style="padding:15px; background:rgba(0,100,0,0.1); border-left:3px solid var(--accent-green); text-align:center; color:#99cc99; margin-bottom:20px;">
                        <i>You've stripped the room of everything valuable — knowledge and supplies both. The rest is just dead weight.</i>
                    </div>
                <</if>>

                <hr style="border-color: #333; margin: 20px 0;">
                <button style="background: rgba(255,255,255,0.05) !important; border-color: #555 !important;">
                    <<link "🚪 Leave the study and return to the hallway">>
                        <<run setup.sound.fade("ticking_clock", 1000)>>
                        <<set $hallwaySection to 1>>
                        <<goto "Hallway">>
                    <</link>>
                </button>
            </div>
        <</if>>

    </div>
</div>
<</nobr>>