:: PassageFooter {"position":"0,100","size":"100,100"}
<<nobr>>
/* =================================================================
   DYNAMIC FLOOR LOOT UI - SLIDING DRAWER OVERLAY
================================================================= */

/* 1. SETUP: Identify current location */
<<set _currentRoom to passage()>>

/* 2. VALIDATION: Check if the floor array exists and has items */
<<if def $floorItems[_currentRoom] and $floorItems[_currentRoom].length > 0>>

    /* --- 3. FLOATING BADGE (Top Right, Floating) --- */
    <div id="floor-items-toggle" onclick="document.getElementById('floor-items-drawer').classList.add('open')">
        📦 Floor Items (<<print $floorItems[_currentRoom].length>>)
    </div>

    /* --- 4. SLIDING OVERLAY DRAWER --- */
    <div id="floor-items-drawer">
        
        /* Drawer Header & Close Button */
        <div class="drawer-header">
            <span>⚠️ ITEMS ON GROUND</span>
            <span class="drawer-close-btn" onclick="document.getElementById('floor-items-drawer').classList.remove('open')">✖</span>
        </div>

        <div id="drawer-item-list">
            /* 5. GENERATION: Loop through room items using your existing logic */
            <<for _i, _item range $floorItems[_currentRoom]>>
                
                /* Pull master data from setup.items database */
                <<set _db to setup.items[_item.id]>>
                
                /* --- Your Existing Item Card Layout --- */
                <div class="loot-item">
                    
                    /* Visual: Item Icon */
                    <div class="loot-icon">
                        <<print _db.icon>>
                    </div>
                    
                    /* Text: Item Name and Quantity */
                    <div class="loot-name">
                        <<print _db.name or _item.id>><br>
                        (x<<print _item.qty>>)
                    </div>
                    
                    /* 6. ACTION: Your Existing Pickup Function */
                    <<capture _i>>
                        <button class="loot-btn" @onclick="'window.pickupItem(' + _i + ')'">
                            GRAB
                        </button>
                    <</capture>>
                    
                </div> /* End loot-item */
                
            <</for>>
        </div>
        
    </div> /* End floor-items-drawer */

<</if>>
<</nobr>>