:: Debug_Panel {"position":"875,425","size":"100,100"}
<<nobr>>
    <<set $returnPassage to previous()>>
<</nobr>>

<style>
    #dbg { 
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; 
        color: #e0e0e0; 
        width: 100%;
        max-width: 900px; 
        margin: 0 auto; 
        background: #0b0b0b; 
        border: 1px solid #282828;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.9);
        display: flex;
        flex-direction: column;
        height: 82vh;
        max-height: 780px;
        min-height: 520px;
        overflow: hidden;
        position: relative;
        isolation: isolate; 
        box-sizing: border-box !important;
    }
    
    #dbg, #dbg * { 
        text-decoration: none !important; 
        text-shadow: none !important; 
        box-sizing: border-box !important;
    }

    #dbg button {
        width: auto !important;
        margin-bottom: 0 !important;
        position: relative !important;
        overflow: visible !important;
        box-sizing: border-box !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        float: none !important;
    }
    #dbg button::after {
        display: none !important;
    }

    /* TOP TOOLBAR */
    .dbg-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #141414;
        border-bottom: 1px solid #2a2a2a;
        padding: 8px 12px;
        gap: 10px;
        flex-shrink: 0;
        z-index: 10;
        width: 100%;
    }

    .dbg-toolbar-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dbg-toggle-btn {
        background: #1e1e1e;
        border: 1px solid #3a3a3a;
        color: #aaa;
        border-radius: 4px;
        padding: 5px 9px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.76rem;
        font-family: inherit;
        transition: all 0.15s ease;
        width: auto !important;
        margin-bottom: 0 !important;
        flex-shrink: 0;
    }
    .dbg-toggle-btn:hover {
        background: #282828;
        color: #ff6b35;
        border-color: #ff6b35;
    }

    .dbg-title {
        font-weight: 700;
        font-size: 0.88rem;
        letter-spacing: 0.05em;
        color: #f0f0f0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dbg-badge {
        background: rgba(255, 107, 53, 0.15);
        border: 1px solid rgba(255, 107, 53, 0.4);
        color: #ff6b35;
        font-size: 0.68em;
        padding: 2px 6px;
        border-radius: 3px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .dbg-toolbar-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .dbg-toolbar-actions .db {
        width: auto !important;
        margin-bottom: 0 !important;
        flex-shrink: 0;
    }

    /* SPLIT VIEW CONTAINER */
    .dbg-split-container {
        display: flex;
        flex: 1;
        overflow: hidden;
        position: relative;
        width: 100%;
    }

    /* SIDEBAR PANE */
    
    
    .dbg-sidebar {
        width: 200px;
        min-width: 130px;
        max-width: 280px;
        background: #101010;
        border-right: 1px solid #222;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        transition: margin-left 0.2s ease;
        overflow-y: auto;
    }

    .dbg-sidebar.collapsed {
        margin-left: -200px;
    }

    .dbg-sidebar-header {
        font-size: 0.65em;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #666;
        padding: 12px 14px 6px;
        font-weight: bold;
    }

    .dbg-nav {
        display: flex;
        flex-direction: column;
        gap: 3px;
        padding: 0 8px 12px;
    }

    .dbg-nav-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 9px;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 5px;
        color: #aaa;
        font-size: 0.78rem;
        font-family: inherit;
        cursor: pointer;
        text-align: left;
        transition: all 0.12s ease;
        width: 100% !important;
        margin-bottom: 0 !important;
    }

    .dbg-nav-item:hover {
        background: #1a1a1a;
        color: #fff;
    }

    .dbg-nav-item.active {
        background: #24140a;
        color: #ff6b35;
        border-color: rgba(255, 107, 53, 0.4);
        font-weight: 600;
    }

    .dbg-nav-icon {
        font-size: 1.1em;
        width: 20px;
        text-align: center;
    }

    /* SPLITTER DIVIDER */
    .dbg-divider {
        width: 6px;
        background: #161616;
        cursor: col-resize;
        position: relative;
        flex-shrink: 0;
        transition: background 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        border-left: 1px solid #222;
        border-right: 1px solid #222;
        z-index: 5;
    }

    .dbg-divider:hover, .dbg-divider.dragging {
        background: #ff6b35;
    }

    .dbg-divider-handle {
        width: 2px;
        height: 24px;
        background: #444;
        border-radius: 1px;
    }

    /* CONTENT PANE */
    .dbg-content {
        flex: 1;
        min-width: 0;
        background: #080808;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
    }

    .dbg-section {
        display: none;
        width: 100%;
    }

    .dbg-section.active {
        display: block;
        animation: dbgFadeIn 0.15s ease-out;
    }

    @keyframes dbgFadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .dbg-section-header {
        font-size: 0.88rem;
        font-weight: 700;
        color: #ff6b35;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding-bottom: 8px;
        border-bottom: 1px solid #242424;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* CONTROL ELEMENTS STYLING */
    .dr { 
        display: flex; 
        align-items: center; 
        gap: 8px; 
        margin-bottom: 8px; 
        background: #121212;
        padding: 5px 8px;
        border-radius: 5px;
        border: 1px solid #1e1e1e;
        width: 100%;
        min-width: 0;
    }
    
    .dl { 
        width: 105px; 
        font-size: .76em; 
        color: #aaa; 
        flex-shrink: 0; 
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .ds { 
        flex: 1; 
        min-width: 0;
        width: 100%;
        accent-color: #ff6b35; 
        cursor: pointer; 
        height: 14px;
        margin: 0;
    }
    
    .dv { 
        width: 36px; 
        flex-shrink: 0;
        text-align: center; 
        color: #ff6b35; 
        font-weight: bold; 
        font-size: .82em; 
        background: #1c0f08;
        padding: 2px 4px;
        border-radius: 4px;
        border: 1px solid rgba(255, 107, 53, 0.3);
    }
    
    #dbg .dbr { 
        display: flex !important; 
        flex-wrap: wrap !important; 
        gap: 6px !important; 
        margin-bottom: 12px !important; 
        width: 100% !important;
        align-items: center !important;
    }
    
    .dgrid { 
        display: grid; 
        grid-template-columns: repeat(2, minmax(0, 1fr)); 
        gap: 8px 12px; 
        width: 100%;
    }
    
    .dsep { 
        border: none; 
        border-top: 1px solid #222; 
        margin: 14px 0; 
    }
    
    #dbg .db, #dbg .dbr button, #dbg button.db { 
        background: #141414 !important; 
        border: 1px solid #333 !important; 
        color: #ccc !important; 
        padding: 5px 10px !important; 
        font-size: .76em !important; 
        font-family: inherit !important; 
        cursor: pointer !important; 
        border-radius: 4px !important;
        transition: all 0.12s ease !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 4px !important;
        min-height: 28px !important;
        line-height: 1.3 !important;
        width: auto !important;
        flex: 0 0 auto !important;
        margin-bottom: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }
    
    .db:hover { 
        border-color: #ff6b35; 
        color: #ff6b35; 
        background: #1a0f08;
    }
    
    .db.on { 
        border-color: #ff6b35; 
        background: #281206; 
        color: #ff6b35; 
        font-weight: bold;
        box-shadow: 0 0 8px rgba(255, 107, 53, 0.2);
    }
    
    .db.neg { 
        border-color: #444; 
        color: #888; 
    }
    
    .db.neg:hover { 
        border-color: #c0392b; 
        color: #c0392b; 
    }
    
    .db.neg.on { 
        border-color: #c0392b; 
        background: #220000; 
        color: #e74c3c; 
    }
    
    .db.go { 
        border-color: #27ae60; 
        color: #27ae60; 
    }
    
    .db.go:hover { background: #04200d; }
    
    .db.bad { 
        border-color: #c0392b; 
        color: #c0392b; 
    }
    
    .db.bad:hover { background: #220000; }
    
    .dsel, .dinput { 
        background: #141414; 
        border: 1px solid #333; 
        color: #ddd; 
        padding: 5px 8px; 
        font-family: inherit; 
        font-size: .78em; 
        border-radius: 4px;
        min-width: 0;
    }
    
    .item-row { 
        display: flex; 
        align-items: center; 
        gap: 8px; 
        margin-bottom: 8px; 
        width: 100%;
    }
    
    .item-row select { 
        flex: 1; 
        min-width: 0;
    }
    
    .item-row input[type=number] { 
        width: 60px; 
        flex-shrink: 0;
    }
    
    .dnotice { 
        background: #1a0e00; 
        border-left: 3px solid #ff6b35; 
        padding: 8px 12px; 
        font-size: .78em; 
        color: #aaa; 
        margin-bottom: 12px; 
        border-radius: 0 4px 4px 0;
    }
    
    .dskv { 
        min-width: 26px; 
        text-align: center; 
        color: #ff6b35; 
        font-weight: bold; 
        font-size: .85em; 
        background: #1c0f08;
        padding: 2px 4px;
        border-radius: 4px;
        border: 1px solid rgba(255, 107, 53, 0.3);
    }
    
    .dlabel { 
        font-size: .72em; 
        color: #ff6b35; 
        text-transform: uppercase; 
        letter-spacing: 0.08em; 
        margin: 10px 0 5px; 
        font-weight: bold;
    }

    @media (max-width: 680px) {
        #dbg { height: 90vh; max-height: none; border-radius: 0; }
        .dgrid { grid-template-columns: minmax(0, 1fr); }
        .dbg-sidebar { width: 140px; }
        .dbg-sidebar.collapsed { margin-left: -140px; }
        .dl { width: 95px; }
    }

    .dbg-sidebar {
        resize: horizontal; overflow-x: hidden;
    }
    
    
    .dbg-list-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 8px;
        margin-bottom: 20px;
    }
    .dbg-list-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.05);
        padding: 10px 12px;
        border-radius: 6px;
        cursor: pointer;
        text-align: left;
        width: 100%;
        color: #ccc;
        transition: all 0.15s ease;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }
    .dbg-list-btn:hover {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.1);
    }
    .dbg-list-btn.on {
        background: rgba(255, 107, 53, 0.1);
        border: 1px solid rgba(255, 107, 53, 0.4);
    }
    .dbg-list-btn.on .list-title {
        color: #ff6b35;
    }
    .dbg-list-btn.neg.on {
        background: rgba(231, 76, 60, 0.1);
        border: 1px solid rgba(231, 76, 60, 0.4);
    }
    .dbg-list-btn.neg.on .list-title {
        color: #e74c3c;
    }
    
    .list-icon {
        font-size: 1.2em;
        width: 24px;
        text-align: center;
        opacity: 0.8;
    }
    
    .list-content {
        display: flex;
        flex-direction: column;
        gap: 3px;
        flex: 1;
    }
    .list-title {
        font-size: 0.8rem;
        font-weight: 700;
        color: #ddd;
        letter-spacing: 0.02em;
    }
    .list-sub {
        font-size: 0.65rem;
        color: #888;
        line-height: 1.2;
    }
    .list-sub strong {
        color: #aaa;
    }


</style>

<div id="dbg">
    <!-- TOOLBAR HEADER -->
    <div class="dbg-toolbar">
        <div class="dbg-toolbar-left">
            <button class="dbg-toggle-btn" id="dbg-toggle-sidebar" title="Collapse / Expand Navigation Pane">
                <span>☰</span>
                <span style="font-size: 0.85em;">Sidebar</span>
            </button>
            <div class="dbg-title">
                <span>🛠️ DEBUG PANEL</span>
                <span class="dbg-badge">STATE EDITOR</span>
            </div>
        </div>
        <div class="dbg-toolbar-actions">
            <button class="db go" onclick="document.getElementById('p-max').click()">MAX ALL</button>
            <button class="db bad" onclick="document.getElementById('p-min').click()">MIN ALL</button>
            <button class="db go" onclick="document.getElementById('nav-return').click()">↩ Game</button>
        </div>
    </div>

    <!-- MAIN SPLIT VIEW -->
    <div class="dbg-split-container">
        <!-- SIDEBAR -->
        <div class="dbg-sidebar" id="dbg-sidebar">
            <div class="dbg-sidebar-header">NAV PANES</div>
            <nav class="dbg-nav">
                <button class="dbg-nav-item active" data-target="sec-presets">
                    <span class="dbg-nav-icon">⚡</span>
                    <span class="dbg-nav-label">Presets</span>
                </button>
                <button class="dbg-nav-item" data-target="sec-vitals">
                    <span class="dbg-nav-icon">📊</span>
                    <span class="dbg-nav-label">Vitals &amp; Stats</span>
                </button>
                <button class="dbg-nav-item" data-target="sec-loadout">
                    <span class="dbg-nav-icon">🎒</span>
                    <span class="dbg-nav-label">Loadout &amp; Items</span>
                </button>
                <button class="dbg-nav-item" data-target="sec-companions">
                    <span class="dbg-nav-icon">👥</span>
                    <span class="dbg-nav-label">Companions</span>
                </button>
                <button class="dbg-nav-item" data-target="sec-flags">
                    <span class="dbg-nav-icon">🚩</span>
                    <span class="dbg-nav-label">Quest &amp; Story</span>
                </button>
                <button class="dbg-nav-item" data-target="sec-fasttravel">
                    <span class="dbg-nav-icon">🚀</span>
                    <span class="dbg-nav-label">Fast-Travel</span>
                </button>
                <button class="dbg-nav-item" data-target="sec-all">
                    <span class="dbg-nav-icon">📄</span>
                    <span class="dbg-nav-label">Show All</span>
                </button>
            </nav>
        </div>

        <!-- DRAGGABLE DIVIDER -->
        <div class="dbg-divider" id="dbg-divider" title="Drag divider to resize sidebar">
            <div class="dbg-divider-handle"></div>
        </div>

        <!-- CONTENT AREA -->
        <div class="dbg-content" id="dbg-content">

            <!-- 1. PRESETS -->
            <div class="dbg-section active" id="sec-presets">
                <div class="dbg-section-header">
                    <span>⚡ Quick Character Presets</span>
                </div>
                <div class="dnotice">Select an archetype preset to immediately configure stats, skills, and gear.</div>
                <div class="dbr">
                    <button class="db go" id="p-max">MAX ALL STATS</button>
                    <button class="db" id="p-combat">Combat Build</button>
                    <button class="db" id="p-talker">Diplomat Build</button>
                    <button class="db" id="p-agility">Agility Build</button>
                    <button class="db" id="p-cop">Police Officer</button>
                    <button class="db" id="p-doc">Doctor</button>
                    <button class="db bad" id="p-min">MIN ALL STATS</button>
                </div>
            </div>

                        <!-- 2. VITALS & STATS -->
            <div class="dbg-section" id="sec-vitals">
                <div class="dbg-section-header">
                    <span>📊 Core Vitals, Attributes &amp; Skills</span>
                </div>
                <div class="dgrid">
                    <div>
                        <div class="dr">
                            <span class="dl">HP Health</span> 
                            <input type="range" class="ds" id="sl-hp" min="1" max="100">
                            <span class="dv" id="vl-hp">?</span>
                        </div>
                        <div class="dr">
                            <span class="dl">STR Strength</span> 
                            <input type="range" class="ds" id="sl-str" min="1" max="10">
                            <span class="dv" id="vl-str">?</span>
                        </div>
                        <div class="dr">
                            <span class="dl">AGI Agility</span> 
                            <input type="range" class="ds" id="sl-agi" min="1" max="10">
                            <span class="dv" id="vl-agi">?</span>
                        </div>
                        <div class="dr">
                            <span class="dl">END Endurance</span> 
                            <input type="range" class="ds" id="sl-end" min="1" max="10">
                            <span class="dv" id="vl-end">?</span>
                        </div>
                        <div class="dr">
                            <span class="dl">PER Perception</span> 
                            <input type="range" class="ds" id="sl-per" min="1" max="10">
                            <span class="dv" id="vl-per">?</span>
                        </div>
                        <div class="dr">
                            <span class="dl">Hunger</span> 
                            <input type="range" class="ds" id="sl-hunger" min="0" max="100">
                            <span class="dv" id="vl-hunger">?</span>
                        </div>
                    </div>
                    <div>
                        <div class="dr">
                            <span class="dl">CHA Charisma</span> 
                            <input type="range" class="ds" id="sl-cha" min="1" max="10">
                            <span class="dv" id="vl-cha">?</span>
                        </div>
                        <div class="dr">
                            <span class="dl">INT Intelligence</span>
                            <input type="range" class="ds" id="sl-int" min="1" max="10">
                            <span class="dv" id="vl-int">?</span>
                        </div>
                        <div class="dr">
                            <span class="dl">HUM Humanity</span> 
                            <input type="range" class="ds" id="sl-hum" min="0" max="100">
                            <span class="dv" id="vl-hum">?</span>
                        </div>
                        <div class="dr">
                            <span class="dl">Stamina</span> 
                            <input type="range" class="ds" id="sl-stamina" min="0" max="200">
                            <span class="dv" id="vl-stamina">?</span>
                        </div>
                        <div class="dr">
                            <span class="dl">Thirst</span> 
                            <input type="range" class="ds" id="sl-thirst" min="0" max="100">
                            <span class="dv" id="vl-thirst">?</span>
                        </div>
                    </div>
                </div>
                
                <div class="dlabel" style="margin-top: 20px;">Core Skills (0 - 5 Scale)</div>
                <div class="dgrid">
                    <div>
                        <div class="dr">
                            <span class="dl">Shooting</span> 
                            <button class="db" id="sk-sh-d">-</button>
                            <span class="dskv" id="sk-sh-v">0</span>
                            <button class="db" id="sk-sh-u">+</button>
                        </div>
                        <div class="dr">
                            <span class="dl">Melee</span> 
                            <button class="db" id="sk-me-d">-</button>
                            <span class="dskv" id="sk-me-v">0</span>
                            <button class="db" id="sk-me-u">+</button>
                        </div>
                        <div class="dr">
                            <span class="dl">Medicine</span> 
                            <button class="db" id="sk-md-d">-</button>
                            <span class="dskv" id="sk-md-v">0</span>
                            <button class="db" id="sk-md-u">+</button>
                        </div>
                    </div>
                    <div>
                        <div class="dr">
                            <span class="dl">Stealth</span> 
                            <button class="db" id="sk-st-d">-</button>
                            <span class="dskv" id="sk-st-v">0</span>
                            <button class="db" id="sk-st-u">+</button>
                        </div>
                        <div class="dr">
                            <span class="dl">Scavenge</span> 
                            <button class="db" id="sk-sc-d">-</button>
                            <span class="dskv" id="sk-sc-v">0</span>
                            <button class="db" id="sk-sc-u">+</button>
                        </div>
                        <div class="dr">
                            <span class="dl">Tech</span> 
                            <button class="db" id="sk-tc-d">-</button>
                            <span class="dskv" id="sk-tc-v">0</span>
                            <button class="db" id="sk-tc-u">+</button>
                        </div>
                    </div>
                </div>

                <div class="dlabel" style="margin-top: 20px;">Survivor Identity (Roles)</div>
                <div class="dbg-list-grid">
                    <button class="dbg-list-btn job-btn" data-trait1="STEADY HANDS" data-trait2="AUTHORITY">
    <div class="list-icon">👮</div>
    <div class="list-content">
        <div class="list-title">POLICE OFFICER</div>
        <div class="list-sub"><strong>PERKS:</strong> STEADY HANDS &amp; AUTHORITY</div>
    </div>
</button>
<button class="dbg-list-btn job-btn" data-trait1="BREACHER" data-trait2="IRON GRIP">
    <div class="list-icon">👷</div>
    <div class="list-content">
        <div class="list-title">CONSTRUCTION</div>
        <div class="list-sub"><strong>PERKS:</strong> BREACHER &amp; IRON GRIP</div>
    </div>
</button>
<button class="dbg-list-btn job-btn" data-trait1="LOCKSMITH" data-trait2="GHOST">
    <div class="list-icon">🥷</div>
    <div class="list-content">
        <div class="list-title">BURGLAR</div>
        <div class="list-sub"><strong>PERKS:</strong> LOCKSMITH &amp; GHOST</div>
    </div>
</button>
<button class="dbg-list-btn job-btn" data-trait1="FIELD MEDIC" data-trait2="ANATOMIST">
    <div class="list-icon">👨‍⚕️</div>
    <div class="list-content">
        <div class="list-title">DOCTOR</div>
