                    <button class="db" data-flag="weapons_confiscated">Weapons Confiscated at Gate</button>
                    <button class="db" data-flag="helped_sadie">Act 3: Helped Sadie (Canteen)</button>
                    <button class="db" data-flag="sadie_quest_active">Act 3: Sadie Quest Active</button>
                    <button class="db" data-flag="helped_thorne">Act 3: Helped Dr. Thorne (Infirmary)</button>
                    <button class="db" data-flag="thorne_quest_active">Act 3: Thorne Quest Active</button>
                    <button class="db" data-flag="helped_chloe">Act 3: Helped Chloe (Comms)</button>
                    <button class="db" data-flag="chloe_quest_active">Act 3: Chloe Quest Active</button>
                </div>
            </div>

            <!-- 7. FAST-TRAVEL TELEPORTER -->
            <div class="dbg-section" id="sec-fasttravel">
                <div class="dbg-section-header">
                    <span>🚀 Fast-Travel Teleporter</span>
                </div>

                <div class="dbr" style="align-items: center; gap: 8px; margin-bottom: 12px;">
                    <input type="text" class="dinput" id="nav-input" placeholder="Type passage name..." style="flex: 1;">
                    <button class="db go" id="nav-go">Teleport</button>
                </div>
                
                <div class="dlabel">Act 2 Scenes</div>
                <div class="dbr">
                    <button class="db go" id="nav-act2-street">The Street Escape</button>
                    <button class="db go" id="nav-act2-road">The Road (Anchor)</button>
                    <button class="db go" id="nav-act2-gas">Route 9 Gas Station</button>
                    <button class="db go" id="nav-act2-highway">I-5 Highway Gridlock</button>
                    <button class="db go" id="nav-act2-cabin">Act 2.5: Marcus's Cabin</button>
                    <button class="db go" id="nav-act2-crash">Act 2.5: Maya's Crash</button>
                </div>

                <div class="dlabel">Act 3 Scenes &amp; Safehouse</div>
                <div class="dbr">
                    <button class="db go" id="nav-act3-arrival">Act 3: Outskirts Arrival</button>
                    <button class="db go" id="nav-act3-sheriff">Substation 4</button>
                    <button class="db go" id="nav-act3-home">Suburban Home</button>
                    <button class="db go" id="nav-act3-safe">High School Gates</button>
                    <button class="db go" id="nav-act3-hub" style="border-color:var(--accent-gold); color:var(--accent-gold);">Act 3: Ground Floor Hub</button>
                </div>

                <div class="dsep"></div>

                <div class="dbr">
                    <button class="db go" id="nav-lobby">Reset &amp; Warp to Lobby Entrance</button>
                    <button class="db go" id="nav-return" title="Return to current passage">Return to Game</button>
                </div>
            </div>
        </div>
    </div>
</div>

