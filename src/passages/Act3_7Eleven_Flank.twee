:: Act3_7Eleven_Flank {"position":"750,2050","size":"100,100"}
<<nobr>>
<<if ndef $firstName or $firstName == "???">>
    <<set $firstName to "Neal">>
<</if>>
<<set $currentLocation to "seven_eleven_back">>
<<set _arrivedLate to (visited("Act2_5_MarcusCabin"))>>

/* DYNAMIC LEADER CONFIGURATION */
<<set _leaderName to "Commander Hayes">>
<<set _leaderAvatar to "image/avatars/leader_default_hayes.gif">>
<<set _leaderRef to "Commander Hayes">>

<<if $anchor == "partner_f">>
    <<set _leaderName to $anchor_name>>
    <<set _leaderAvatar to "image/avatars/leader_f.gif">>
    <<set _leaderRef to "your girlfriend, " + $anchor_name>>
<<elseif $anchor == "partner_m">>
    <<set _leaderName to $anchor_name>>
    <<set _leaderAvatar to "image/avatars/leader_m.gif">>
    <<set _leaderRef to "your boyfriend, " + $anchor_name>>
<<elseif $anchor == "partner_nb">>
    <<set _leaderName to $anchor_name>>
    <<set _leaderAvatar to "image/avatars/leader_nb.gif">>
    <<set _leaderRef to "your partner, " + $anchor_name>>
<<elseif $anchor == "parents">>
    <<set _leaderName to "Dad">>
    <<set _leaderAvatar to "image/avatars/leader_dad.gif">>
    <<set _leaderRef to "your father">>
<</if>>
<</nobr>>

<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">
        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            7-ELEVEN — BACK STORAGE ROOM FLANK
        </div>

        <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
            <img src="image/Act2GasStation/InteriorGasStation.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-gold); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            <span id="vn-711-flank-main">
                You silently slip past the overflowing service dumpster in the alley, jimmying open the rusted metal rear door with fluid ease.
                <br><br>
                Inside the cramped storage room, stacks of cardboard soda flats and paper goods provide deep shadows. Two scavengers lean through the doorway, blindly firing at the walk-in cooler.
                <br><br>
                <<chat "Reyes (Whispering)" "image/avatars/reyes.gif" "right" "Flawless approach. On my mark, drop the shooter near the ice machine!">>
                <br><br>
                In two synchronized, muffled shots, you and Reyes neutralize both hostiles before they can even scream!
                <br><br>
                The heavy steel latch of the walk-in cooler clicks loose. <<print _leaderName>> pushes the door open, wiping blood and condensation from their forehead, holding a shotgun and a reinforced container of fuel.
                <br><br>
                <<if $anchor == "parents">>
                    <<chat "Dad" "image/avatars/leader_dad.gif" "right" "$firstName?! Holy Christ... you took them from behind without a sound! Your mother told me you made it to Timberline... you're both alive!">>
                <<elseif $anchor == "partner_f" or $anchor == "partner_m" or $anchor == "partner_nb">>
                    <<chat _leaderName _leaderAvatar "right" "$firstName?! I knew you were out there... only you could pull off a flank like that. You came for me!">>
                <<else>>
                    <<chat "Commander Hayes" "image/avatars/leader_default_hayes.gif" "right" "Flawless flank. You caught those scavengers completely off guard, $firstName. Masterclass in silent tactical clearance.">>
                <</if>>
                <br><br>
                <<if _arrivedLate>>
                    <<chat _leaderName _leaderAvatar "right" "Evelyn told me over the radio that you got into base late after daybreak. To pull off a coordinated ambush this fast proves you are second to none.">>
                <<else>>
                    <<chat _leaderName _leaderAvatar "right" "Evelyn told me you made it through the midnight storms. Speed, cunning, and nerves of steel. Exactly what our people need to survive.">>
                <</if>>
                <br><br>
                <div style="padding: 12px; background: rgba(100, 75, 0, 0.3); border: 1px solid var(--accent-gold); border-radius: 6px; text-align: center;">
                    <b style="color: var(--accent-gold); font-size: 1.1em;">[+60 XP] &bull; [+30 TRUST] &bull; [STEALTH AMBUSH BONUS]</b>
                </div>

                /* REWARDS & OBJECTIVE COMPLETION */
                <<run window.gainXP(60)>>
                <<run window.gainTrust(30)>>
                <<completeObjective "rescue_leader_711">>
                <<set $leader_rescued to true>>
                <<purgeCompleted>>
            </span>
        </div>

        <div class="choice-menu">
            <button style="border-left-color: var(--accent-green) !important; background: rgba(0, 100, 0, 0.25);">
                <<link "🚗 Escort Leader & Fuel Back to Timberline High School [MISSION COMPLETE]">>
                    <<run $(".vn-dialogue-box").scrollTop(0)>>
                    <<addTime 15>>
                    <<goto "Act3_7Eleven_RescueSuccess">>
                <</link>>
                <span class="btn-sub"><b style="color:var(--accent-green);">[MISSION COMPLETE]</b> Secure the fuel canisters and escort the Sanctuary Leader back to base.</span>
            </button>
        </div>
    </div>
</div>
