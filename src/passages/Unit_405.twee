:: Unit_405 {"position":"0,750","size":"100,100"}
<!-- ======================================================= -->
<!-- INITIALIZATION & SETUP                                  -->
<!-- ======================================================= -->
<<nobr>>
    /* AUDIO: Low ambient tension */
    <<run setup.sound.play("tension_drone", "audio/bgm/tension.mp3", true, 0.3)>>

    <<set $currentLocation to "405">>
    
    /* Variable Defaults */
    <<if not $room405_opened>><<set $room405_opened to false>><</if>>
    <<if not $room405_trap_triggered>><<set $room405_trap_triggered to false>><</if>>
    <<if not $read_marcus_log>><<set $read_marcus_log to false>><</if>>
    <<if not $looted_405_bench>><<set $looted_405_bench to false>><</if>>
    <<if not $looted_405_safe>><<set $looted_405_safe to false>><</if>>

    /* Setup Action Costs */
    <<set _trapCost to 20>>
    <<set _halfTrapCost to Math.round(_trapCost / 2)>>
<</nobr>>

<<nobr>>
<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">

        <!-- ======================================================= -->
        <!-- PHASE 1: EXTERIOR (THE BOOBY TRAP)                      -->
        <!-- ======================================================= -->
        <<if not $room405_opened>>
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                UNIT 405 - THE BOOBY TRAP
            </div>

            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-red); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                This is Marcus's place. The guy was a fanatic. An ex-military survivalist who spent his weekends hunting in the mountains and his weeknights reinforcing his walls. 
                <br><br>
                The door is heavy solid core steel, but strangely, it's unlocked. It sits ajar by a fraction of an inch. The sharp, acidic smell of cordite and gun oil leaks into the hallway.
                <br><br>
                You push the door gently. It stops with a faint metallic <i>*clink*</i>. 
                <br><br>
                You shine your light down. A near-invisible monofilament fishing line is tied from the doorknob to the pin of a flashbang grenade and a makeshift 12-gauge blank shell rigged to the doorframe. If you open this door normally, it will blow your eardrums out and alert every infected within a three-mile radius.

                <br><br>
                <<chat "You" "image/avatars/player.gif" "left" "Paranoid bastard. He left a welcome present.">>
            </div>

            <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
                <div style="margin-bottom:20px; padding:15px; background:rgba(0,0,0,0.3); border-left:3px solid var(--accent-gold);">
                    <b style="color:var(--accent-gold);">⚙️ DISARM THE TRAP</b><br><br>

                    <!-- WARNING IF TRAP ALREADY TRIGGERED PREVIOUSLY -->
                    <<if $room405_trap_triggered>>
                        <div style="padding:10px; background:rgba(138,28,28,0.3); border:1px solid var(--accent-red); color:#ff6b6b; margin-bottom:15px; text-align:center;">
                            ❌ <b>TRAP TRIGGERED.</b> Your ears are ringing. The blank shell detonated, and the noise echoed down the entire floor. The wire is gone now.
                        </div>
                    <</if>>

                    <!-- BUTTONS CONTAINER -->
                    <div id="trap-buttons" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">

                        <!-- 1. BURGLAR / LOCKSMITH -->
                        <<if $job == "Burglar" or hasTrait("LOCKSMITH")>>
                            <button style="height: 100%;">
                                <<link "Block the firing pin">>
                                    <<addTime 2>><<exert _halfTrapCost>><<set $room405_opened to true>><<goto "Unit_405">>
                                <</link>>
                                <span class="btn-sub"><b style="color:var(--accent-gold);">[BURGLAR/LOCKSMITH]</b> Cost: <<print _halfTrapCost>> STAMINA. You know tension rigs. You slide a card to jam the striker mechanism safely.</span>
                            </button>
                        <<else>>
                            <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                <span style="text-decoration: line-through;">Block the firing pin</span><br>
                                <span class="btn-sub" style="color: #666;">[REQUIRES BURGLAR/LOCKSMITH] You lack the steady hands to jam the mechanism.</span>
                            </button>
                        <</if>>

                        <!-- 2. TECH 2 -->
                        <<if $skills.tech >= 2>>
                            <button style="height: 100%;">
                                <<link "Release the tension spring">>
                                    <<addTime 3>><<exert _halfTrapCost>><<set $room405_opened to true>><<goto "Unit_405">>
                                <</link>>
                                <span class="btn-sub"><b style="color:var(--accent-gold);">[TECH 2]</b> Cost: <<print _halfTrapCost>> STAMINA. You dismantle the anchor point without pulling the wire.</span>
                            </button>
                        <<else>>
                            <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                <span style="text-decoration: line-through;">Release the tension spring</span><br>
                                <span class="btn-sub" style="color: #666;">[REQUIRES TECH 2] You don't understand how the spring mechanism is anchored.</span>
                            </button>
                        <</if>>

                        <!-- 3. MULTI-TOOL -->
                        <<if $inventory.find(i => i.id === "Multi-Tool")>>
                            <button style="height: 100%;">
                                <<link "Cut and hold the wire [MULTI-TOOL]">>
                                    <<addTime 2>><<exert _halfTrapCost>><<set $room405_opened to true>><<goto "Unit_405">>
                                <</link>>
                                <span class="btn-sub"><b style="color:var(--accent-gold);">[ITEM]</b> Cost: <<print _halfTrapCost>> STAMINA. You grip the wire with pliers, snip it, and slowly release the tension.</span>
                            </button>
                        <<else>>
                            <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                <span style="text-decoration: line-through;">Cut the wire</span><br>
                                <span class="btn-sub" style="color: #666;">[REQUIRES MULTI-TOOL] You don't have wire cutters to snip it cleanly.</span>
                            </button>
                        <</if>>

                        <!-- 4. PERCEPTION 6 (AUTO SUCCESS OR MINIGAME SCALING) -->
                        <<if $per >= 6>>
                            <button style="grid-column: span 2; border-left-color: var(--accent-gold) !important;">
                                <<link "Squeeze through the gap [PER 6/6]">>
                                    <<addTime 4>><<exert _trapCost>><<set $room405_opened to true>><<goto "Unit_405">>
                                <</link>>
                                <span class="btn-sub"><b style="color:var(--accent-gold);">[PER <<print $per>>/6]</b> Cost: <<print _trapCost>> STAMINA. Your sharp eyes map the tripwire perfectly. You contort your body and slide through safely.</span>
                            </button>
                        <<else>>
                            <button style="grid-column: span 2; border-left-color: var(--accent-red) !important;">
                                <<link "Squeeze through the gap [MINIGAME]">>
                                    <<run $("#trap-buttons").hide(); $("#qte-wrapper-405").fadeIn(300);>>
                                <</link>>
                                <span class="btn-sub"><b style="color:var(--accent-red);">[PER <<print $per>>/6]</b> You can barely see the wire in the dark. It's going to require immense focus and steady nerves to avoid touching it.</span>
                            </button>
                        <</if>>

                    </div> <!-- End of trap-buttons grid -->

                    <!-- PEMANGGILAN WIDGET MINIGAME -->
                    <div id="qte-wrapper-405" style="display: none; padding-top: 15px;">
                        
                        <!-- Kalkulasi Dinamis Berdasarkan Persepsi (Target PER = 6) -->
                        <<set _statDiff to (6 - $per)>>
                        <!-- Kecepatan dasar 2.2. Tambah 0.6 untuk setiap kekurangan 1 PER -->
                        <<set _qteSpeed to 2.2 + (_statDiff * 0.6)>>
                        <!-- Lebar dasar 25%. Kurangi 4% untuk setiap kekurangan 1 PER -->
                        <<set _qteWidth to 25 - (_statDiff * 4)>>
                        
                        /* Panggil widget */
                        <<Minigame_QTE _qteSpeed _qteWidth>>
                        
                        /* HIDDEN TRIGGERS: Trik untuk menghubungkan JS ke Makro Twine */
                        <span style="display:none;">
                            <span id="qte-win-trigger">
                                <<link "WIN">>
                                    <<addTime 4>><<exert _trapCost>><<set $room405_opened to true>><<goto "Unit_405">>
                                <</link>>
                            </span>
                            
                            <span id="qte-lose-trigger">
                                <<link "LOSE">>
                                    <<set $hp -= 15>>
                                    <<set $room405_opened to true>>
                                    <<set $room405_trap_triggered to true>>
                                    <<run setup.sound.play("explosion", "audio/sfx/glass_break.mp3", false, 0.8)>>
                                    <<goto "Unit_405">>
                                <</link>>
                            </span>
                        </span>

                    </div>

                </div> <!-- End of Phase 1 choices box -->

                <hr style="border-color: #333; margin: 20px 0;">
                <button style="background: rgba(255,255,255,0.05) !important; border-color: #555 !important;">
                    <<link "🚪 Step back and return to the hallway">>
                        <<run setup.sound.fade("tension_drone", 1000)>>
                        <<set $hallwaySection to 2>>
                        <<goto "Hallway">>
                    <</link>>
                </button>
            </div>

        <!-- ======================================================= -->
        <!-- PHASE 2: INSIDE THE HUNTER's ROOM (OPENED)              -->
        <!-- ======================================================= -->
        <<else>>
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                UNIT 405 - THE HUNTER'S SANCTUARY
            </div>

            <!-- AI GENERATED IMAGE HERE -->
            <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
                <img src="image/unit405.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
            </div>

            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                You step into Marcus's apartment. 
                <br><br>
                It looks like a staging ground. A heavy wooden table in the center acts as a reloading bench, dusted with gunpowder and brass shavings. In the corner, a massive steel gun safe sits with its door wide open—completely stripped of the rifles you know he owned. 
                <br><br>
                He didn't die here. He geared up.
                <br><br>
                On the wall above the bench is a topographical map of the state. A thick red marker traces a route avoiding the highways, ending at a circled location labeled <i>'Oakhaven Cabin'</i>. Underneath the map is a HAM radio, turned off, with a notepad resting on the microphone.
                <br><br>
                Near the empty safe, a small wooden toy car lies forgotten on the rug. The silence in this room feels entirely different from the Professor's study. This is the silence of someone who chose to fight.
            </div>

            <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
                <div style="margin-bottom:20px; padding:15px; background:rgba(0,0,0,0.3); border-left:3px solid var(--accent-blue);">
                    <b style="color:var(--accent-blue);">🎒 SECURE THE AREA</b><br><br>

                    <!-- ACTION: READ THE RADIO LOG -->
                    <<if not $read_marcus_log>>
                        <button>
                            <<link "📝 Read the notepad by the radio (5 minutes)">>
                                <<set $read_marcus_log to true>>
                                <<addTime 4>>
                                <<run window.addLore("Marcus's Extraction Log", "Sarah and the twin boys made it to Oakhaven Cabin safely. Marcus packed his heavy ordnance and followed them through the backroads to avoid the military blockade. He left the apartment rigged to slow down looters.")>>
                                <<goto "Unit_405">>
                            <</link>>
                            <span class="btn-sub"><b style="color:var(--accent-green);">[LORE]</b> <i>"Sarah, received your ping. Thank God you and the boys made it to Oakhaven. Radio silence protocol is now active. I'm taking the heavy ordnance and taking the backroads. I'm coming home."</i></span>
                        </button>
                    <<else>>
                        <div style="padding:8px; background:rgba(255,255,255,0.05); color:#888; font-style:italic; font-size:0.85em; margin-bottom:10px; text-align:center;">
                            📝 They made it out. Sarah and the twins are at the cabin. Marcus is on his way to them.
                        </div>
                    <</if>>

                    <!-- ACTION: LOOT BENCH -->
                    <<if not $looted_405_bench>>
                        <button>
                            <<link "🔍 Sweep the reloading bench (5 minutes)">>
                                <<set $looted_405_bench to true>>
                                <<addTime 4>>
                                <<run setup.addItem("Pistol Ammo", 12)>>
                                <<run setup.addItem("Scrap Metal", 3)>>
                                <<goto "Unit_405">>
                            <</link>>
                            <span class="btn-sub">Marcus took the big guns, but left the loose items. You can scavenge handfuls of Pistol Ammo (12x) and some Scrap Metal.</span>
                        </button>
                    <<else>>
                        <div style="padding:8px; background:rgba(255,255,255,0.05); color:#888; font-style:italic; font-size:0.85em; margin-bottom:10px; text-align:center;">
                            🔍 The workbench is cleared. Only brass shavings remain.
                        </div>
                    <</if>>

                    <!-- ACTION: LOOT SAFE -->
                    <<if not $looted_405_safe>>
                        <button>
                            <<link "🔪 Check the bottom of the gun safe (3 minutes)">>
                                <<addTime 2>>
                                <<set $looted_405_safe to true>>
                                <<run setup.addItem("Hunting Knife", 1)>>
                                <<goto "Unit_405">>
                            <</link>>
                            <span class="btn-sub">The rifles are gone, but tucked in the corner is a high-carbon Hunting Knife. A reliable weapon.</span>
                        </button>
                    <<else>>
                        <div style="padding:8px; background:rgba(255,255,255,0.05); color:#888; font-style:italic; font-size:0.85em; margin-bottom:10px; text-align:center;">
                            🔪 The safe is completely empty.
                        </div>
                    <</if>>
                </div>

                <!-- COMPLETION STATE -->
                <<if $read_marcus_log and $looted_405_bench and $looted_405_safe>>
                    <div style="padding:15px; background:rgba(0,100,0,0.1); border-left:3px solid var(--accent-green); text-align:center; color:#99cc99; margin-bottom:20px;">
                        <i>You've armed yourself with what Marcus left behind. Seeing that toy car on the floor gives you a strange sense of relief. At least one family made it out.</i>
                    </div>
                <</if>>

                <hr style="border-color: #333; margin: 20px 0;">
                <button style="background: rgba(255,255,255,0.05) !important; border-color: #555 !important;">
                    <<link "🚪 Leave the apartment and return to the hallway">>
                        <<run setup.sound.fade("tension_drone", 1000)>>
                        <<set $hallwaySection to 2>>
                        <<goto "Hallway">>
                    <</link>>
                </button>
            </div>
        <</if>>

    </div>
</div>
<</nobr>>