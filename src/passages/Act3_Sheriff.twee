:: Act3_Sheriff {"position":"450,1500","size":"100,100"}
<<nobr>>
<<if ndef $sheriff_phase>>
    <<set $sheriff_phase    to 1>>
    <<set $looted_booking   to false>>
    <<set $looted_evidence  to false>>
    <<set $looted_armory    to false>>
    <<set $zombie_alerted   to false>>
    <<set $made_noise       to false>>
    <<set $stranger_met     to false>>
    <<set $met_reyes        to false>>
    <<set $stranger_trust   to "none">>
    <<set $companion_reyes  to false>>
<</if>>

/* ─── TIME OF DAY CHECK (DAY 0 / EARLY OUTBREAK) ─── */
<<set _arrivedLate to (visited("Act2_5_MarcusCabin"))>>

/* ─── COMPANIONS CHECKS ─── */
<<set _hasVane  to ($vane_status == "joined" or (def $companions and $companions.includes("Vane")))>>
<<set _hasMaya  to ($maya_status == "joined" or (def $companions and $companions.includes("Maya")))>>
<<set _hasDiane to ($diane_status == "joined" or (def $companions and $companions.includes("Diane")))>>

/* ─── WEAPON & EQUIPMENT DETECTION ─── */
<<set _isGun      to (setup.ammoMap && setup.ammoMap[$equip.weapon])>>
<<set _isBlade    to ["Combat Knife","Hunting Knife","Kitchen Knife","Scalpel","Machete"].includes($equip.weapon)>>
<<set _isBlunt    to ["Baseball Bat","Golf Club","Sledgehammer","Cane","Tire Iron","Crowbar","Lead Pipe","Fire Axe"].includes($equip.weapon)>>
<<set _isUnarmed  to ($equip.weapon == "none")>>
<<set _hasMultiTool to ($inventory.find(i => i.id === "Multi-Tool") or $equip.weapon === "Multi-Tool")>>

/* Check if any bladed weapon exists in the inventory */
<<set _inventoryBlade to ($inventory.find(i => ["Combat Knife", "Hunting Knife", "Kitchen Knife", "Scalpel", "Machete"].includes(i.id)) !== undefined)>>
<<set _hasBlade to (_isBlade or _inventoryBlade)>>

/* ─── VEHICLE CAPACITY CHECKS ─── */
<<set _carCount to 1>>
<<if _hasVane>>  <<set _carCount to _carCount + 1>><</if>>
<<if _hasMaya>>  <<set _carCount to _carCount + 2>><</if>> /* Maya + Lily */
<<if _hasDiane>> <<set _carCount to _carCount + 3>><</if>> /* Diane + 2 Boys */
<<set _carFull to (_carCount >= 4)>>
<<set _hasKids to (_hasMaya or _hasDiane)>>

<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">

/*
══════════════════════════════════════════════════════════════════════════
     PHASE 1 — THE APPROACH
══════════════════════════════════════════════════════════════════════════
*/
<<if $sheriff_phase == 1>>

        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            KING COUNTY SHERIFF — SUBSTATION 4
        </div>

        <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
            <img src="image/Act3/substation_exterior.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            <span id="vn-text-approach">
                The tires crunch softly against wet gravel as the car rolls to a halt behind the dark building. Up close, a cracked plastic sign on the wall reads <b style="color:var(--accent-blue);">KING COUNTY SHERIFF — SUBSTATION 4</b>.
                <br><br>
                Only a few hours ago, this was an ordinary, quiet town. Now the gravel lot looks like a war zone. Two patrol cruisers sit smashed together against the perimeter fence, their windshields spiderwebbed with bullet holes. Spent brass casings glint in the wet mud alongside burnt-out road flares and scattered paperwork.
                <br><br>
                <<if _arrivedLate>>
                    The morning fog hangs heavy and gray over the scene. A faint, dying red emergency strobe flickers behind the barred windows—weak, like a failing heartbeat in the damp chill. The bodies piled near the shattered front entrance are stiffening under a thin layer of morning frost.
                    <br><br>
                    Somewhere around the side of the building, a mechanical engine gives a dry, sputtering rattle—an emergency generator running on its very last drops of gas.
                <<else>>
                    The freezing rain pours down in sheets against the dark concrete. The emergency strobe behind the front windows pulses violently—a blinding red flash that paints the wet pavement in bloody reflections every two seconds.
                    <br><br>
                    Somewhere in the utility alley, a heavy generator roars with a steady, deafening drone, keeping the building's circuits buzzing in the pitch-black night.
                <</if>>

                <div class="choice-menu" style="margin-top:20px;">
                    <button style="border-left-color: var(--accent-blue) !important; background: rgba(255,255,255,0.05);">
                        <<link "Look around and listen ▼">>
                            <<run $(".vn-dialogue-box").scrollTop(0)>>
                            <<replace "#vn-text-approach">>
                                <<if _hasVane and _hasMaya>>
                                    Vane cuts the ignition, his hands trembling slightly on the steering wheel as he stares through the rain at the bloodstained cruiser doors. In the backseat, Maya gathers seven-year-old Lily against her chest, turning the little girl's head into her jacket so she won't see the bodies outside.
                                    <br><br>
                                    <<chat "Maya" "image/avatars/maya.gif" "right" "God... not even the police? They had body armor, rifles, radios... what could have done this to them in just one night? If an entire squad of deputies couldn't hold their own station, what are we supposed to do?">>
                                    <br>
                                    <<chat "Vane" "image/avatars/vane.gif" "right" "Listen to that humming sound around the side. That's a generator. If there's power, maybe the desk computer or an emergency radio is still on... maybe someone left an evac notice or a frequency we can tune into. But look at those front doors. Whatever attacked them tore right through the glass.">>
                                    <br>
                                    <<chat "You" "image/avatars/player.gif" "left" "Maya, keep Lily down in the footwell and keep the doors locked. Vane, watch my back. If anything goes wrong—if you hear screams or gunshots—don't wait for me. Hit the gas and get the hell out of here.">>

                                <<elseif _hasVane and _hasDiane>>
                                    Vane kills the engine. In the back, Diane's hands rest tightly on the shoulders of her two boys. She stares out at the bullet-pocked brick with a cold, protective glare.
                                    <br><br>
                                    <<chat "Diane" "image/avatars/diane.gif" "right" "Look at those dead officers by the steps. If a dozen armed cops couldn't survive the night in a reinforced concrete bunker, whatever did this isn't human. We shouldn't be here. We should keep driving.">>
                                    <br>
                                    <<chat "Vane" "image/avatars/vane.gif" "right" "Diane, we're almost out of options. We don't even know where the military checkpoint is. That generator is still running—there might be an emergency log or a map on the desk inside before the fuel runs dry.">>
                                    <br>
                                    <<chat "You" "image/avatars/player.gif" "left" "Diane, stay with the boys. Keep the car in drive. If you hear anything go bad inside, step on the gas. We'll be as fast as we can.">>

                                <<elseif _hasVane>>
                                    Vane leans over the dashboard, his eyes wide as he clutches his Pelican camera case against his knees like a shield.
                                    <br><br>
                                    <<chat "Vane" "image/avatars/vane.gif" "right" "The front entrance is completely blocked by corpses and broken furniture. But look at the utility box on the side—the generator is humming. If the power's on, maybe their emergency dispatch terminal has information about where survivors are being sent.">>
                                    <br>
                                    <<chat "You" "image/avatars/player.gif" "left" "We can't use the front doors. We'll have to find a way in through the rear maintenance fence. Stay quiet, keep low.">>

                                <<elseif _hasMaya>>
                                    Maya's voice comes from the rear seat—a hushed, terrified whisper so as not to panic Lily.
                                    <br><br>
                                    <<chat "Maya" "image/avatars/maya.gif" "right" "Look at the bullet holes in the walls... they were shooting wildly in the dark. It looks like a slaughterhouse. Please be careful in there... Lily and I can't do this alone if something happens to you.">>
                                    <br>
                                    <<chat "You" "image/avatars/player.gif" "left" "I'll just grab what we need and come right back. Keep the doors locked. If you see anything move outside, stay down.">>

                                <<elseif _hasDiane>>
                                    Diane looks at the blood smeared across the cruiser windshields, her face pale but resolute.
                                    <br><br>
                                    <<chat "Diane" "image/avatars/diane.gif" "right" "The emergency alert went out only hours ago, and this town is already tearing itself apart. Don't be a hero in there. Get the supplies and get back out. My boys need living allies.">>
                                    <br>
                                    <<chat "You" "image/avatars/player.gif" "left" "Understood. I won't take any dumb risks.">>

                                <<else>>
                                    You sit in the driver's seat as the engine ticks cool. 
                                    <br><br>
                                    Only yesterday evening, life was normal. Now, in the dark pre-dawn hours, you're staring at the bloodied remains of a county sheriff substation. You have no idea how widespread this outbreak is, but if the local police couldn't hold their own precinct, the entire valley might be falling.
                                    <br><br>
                                    You check your weapon. The front entrance is blocked with bodies and overturned furniture. Your only way inside is through the rear maintenance fence.
                                <</if>>

                                <div class="choice-menu" style="margin-top:20px;">
                                    <button style="border-left-color: var(--accent-gold) !important; background: rgba(255,255,255,0.05);">
                                        <<link "Head toward the rear maintenance alley ▼">>
                                            <<set $sheriff_phase to 2>>
                                            <<goto "Act3_Sheriff">>
                                        <</link>>
                                        <span class="btn-sub">Slip into the dark alley running along the side of the building.</span>
                                    </button>
                                </div>
                            <</replace>>
                        <</link>>
                    </button>
                </div>
            </span>
        </div>

/*
══════════════════════════════════════════════════════════════════════════
     PHASE 2 — THE PERIMETER FENCE & ENTRY (DRAMATIC ACTION CHOICES)
══════════════════════════════════════════════════════════════════════════
*/
<<elseif $sheriff_phase == 2>>

        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            SUBSTATION — REAR MAINTENANCE PERIMETER
        </div>

        <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
            <img src="image/Act3/substation_exterior.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            <span id="vn-phase2-content">
                You slip through the dripping pine branches into the maintenance alley. A ten-foot chain-link fence topped with barbed wire seals off the rear loading dock and the heavy steel exit door.
                <br><br>
                Through the wire mesh, you can see a large metal trash dumpster shoved beneath the wall. About eight feet above the concrete, a narrow transom window sits unlatched and slightly ajar—probably left cracked for ventilation before the chaos erupted last night.

                <<if _hasVane>>
                    <br><br>
                    You help Vane over the fence and drop quietly onto the loading dock. The rear steel door is solid and has no exterior handle—locked from the inside.
                    <br><br>
                    <span style="color:var(--accent-blue);">"Look up there,"</span> Vane whispers nervously, pointing at the narrow open window. <span style="color:var(--accent-blue);">"I think I can squeeze through the transom gap if you give me a boost. I'll drop down on the other side and hit the emergency crash bar to let you in."</span>
                    <br><br>
                    You lace your fingers together and brace your back against the brick. Vane steps onto your hands, grabs the windowsill, and wriggles his slender frame through the narrow opening.
                    <br><br>
                    <i>*CRASH—CLATTER!*</i>
                    <br><br>
                    In the pitch darkness inside, his shoe catches a metal shelving unit. Steel filing trays and clipboards crash onto the floor with a deafening rattle that rings through the air vents.
                    <br><br>
                    <i style="color:#aaa;">"Oh god... sorry, I'm sorry,"</i> Vane's voice whispers in a panic through the window. <i style="color:#aaa;">"I couldn't see... but I think something outside heard that!"</i>
                    <br><br>
                    From the dark corner beside the dumpster, a figure in a torn police uniform stumbles into view. Its face is covered in dark, half-dried blood, its eyes milky and unfocused. It stops, head twitching wildly toward you, drawing in a sharp, guttural breath to shriek!

                    <<if not $zombie_alerted>>
                        <div style="margin-top:20px; padding:15px; background:rgba(80,0,0,0.3); border-left:3px solid var(--accent-red);">
                            <b style="color:var(--accent-red);">⚠️ DANGER:</b> Silence the turned deputy before its scream draws the horde from the front!
                        </div>
                        <<set $zombie_alerted to true>>
                    <</if>>

                    <div class="choice-menu" style="margin-top:20px;">
                        <<if $inventory.find(i => i.id === "Compound Bow") or $equip.weapon === "Compound Bow">>
                            <button style="border-left-color: var(--accent-green) !important;">
                                <<link "Draw, aim, and release. [COMPOUND BOW]">>
                                    <<run $(".vn-dialogue-box").scrollTop(0)>>
                                    <<replace "#vn-phase2-content">>
                                        You draw the heavy carbon string to your cheek, exhaling into the freezing mist. The fiber-optic sight settles between the turned deputy's milky eyes.
                                        <br><br>
                                        <i>*THWIP—CRACK!*</i>
                                        <br><br>
                                        The broadhead arrow punches through the skull with violent precision. The turned deputy collapses like a cut marionette, hitting the wet mud with a soft, dull thud.
                                        <br><br>
                                        From the open transom window above, Vane lets out a shaky, trembling breath: <span style="color:var(--accent-blue);">"Holy shit... you got it. Hold on, I'm hitting the manual release bar now!"</span>
                                        <br><br>
                                        A heavy metallic clunk echoes as the back security door pops unlocked.
                                        <div class="choice-menu" style="margin-top:20px;">
                                            <button style="border-left-color: var(--accent-gold) !important;">
                                                <<link "Slip through the rear security door ▼">>
                                                    <<set $sheriff_phase to 3>>
                                                    <<goto "Act3_Sheriff">>
                                                <</link>>
                                                <span class="btn-sub">Step inside the records room corridor.</span>
                                            </button>
                                        </div>
                                    <</replace>>
                                <</link>>
                                <span class="btn-sub"><b style="color:var(--accent-green);">[COMPOUND BOW]</b> Carbon arrow kill. <b style="color:var(--accent-green);">Zero noise.</b></span>
                            </button>
                        <</if>>

                        <<if ($skills.stealth >= 2 or hasTrait("GHOST")) and _hasBlade>>
                            <button style="border-left-color: var(--accent-gold) !important;">
                                <<link "Step from the shadows and strike the base of the skull. [STEALTH 2 / GHOST + BLADE]">>
                                    <<run $(".vn-dialogue-box").scrollTop(0)>>
                                    <<replace "#vn-phase2-content">>
                                        You ghost across the wet asphalt, slipping into the creature's peripheral blind spot with zero sound. Just as its chest expands to scream, your arm hooks around its jaw, yanking its head back while your blade drives upward into the base of its skull!
                                        <br><br>
                                        A wet crunch. The creature instantly goes dead weight. You guide the heavy corpse down onto the asphalt without a sound.
                                        <br><br>
                                        Vane peers down from the window, his eyes wide in awe: <span style="color:var(--accent-blue);">"You took it down like a ghost... hold on, pushing the crash bar now!"</span>
                                        <br><br>
                                        The heavy door latch unseals with a dull click.
                                        <div class="choice-menu" style="margin-top:20px;">
                                            <button style="border-left-color: var(--accent-gold) !important;">
                                                <<link "Slip through the rear security door ▼">>
                                                    <<set $sheriff_phase to 3>>
                                                    <<goto "Act3_Sheriff">>
                                                <</link>>
                                                <span class="btn-sub">Step inside the records room corridor.</span>
                                            </button>
                                        </div>
                                    <</replace>>
                                <</link>>
                                <span class="btn-sub"><b style="color:var(--accent-gold);">[STEALTH 2 / GHOST + BLADE]</b> Silent execution. <b style="color:var(--accent-green);">Zero noise.</b></span>
                            </button>
                        <<else>>
                            <button disabled style="opacity:0.4; cursor:not-allowed; border-color:#333;">
                                <span style="text-decoration:line-through;">Stealth blade takedown</span><br>
                                <span class="btn-sub" style="color:#666;">
                                    <<if not ($skills.stealth >= 2 or hasTrait("GHOST"))>>
                                        [REQUIRES STEALTH 2 / GHOST] You lack the speed to close the distance quietly in time.
                                    <<else>>
                                        [REQUIRES BLADED WEAPON] You need a knife or blade equipped to execute silently.
                                    <</if>>
                                </span>
                            </button>
                        <</if>>

                        <<if $str >= 6 or $skills.melee >= 2>>
                            <button style="border-left-color: var(--accent-gold) !important;">
                                <<link "Lunge forward and slam it into the pavement. [STR 6 / MELEE 2]">>
                                    <<run $(".vn-dialogue-box").scrollTop(0)>>
                                    <<replace "#vn-phase2-content">>
                                        You cross the distance in two powerful strides. Before the turned deputy can draw breath into its lungs, both your hands clamp onto its collar and throat, using your full body momentum to slam it skull-first into the concrete!
                                        <br><br>
                                        <i>*CRACK!*</i>
                                        <br><br>
                                        The bone fractures against the curb. The creature twitches once and goes limp.
                                        <br><br>
                                        From the window above, Vane exhales a shaky gasp: <span style="color:var(--accent-blue);">"Damn... that was close. Pushing the bar now!"</span>
                                        <br><br>
                                        The rear security door clicks open.
                                        <div class="choice-menu" style="margin-top:20px;">
                                            <button style="border-left-color: var(--accent-gold) !important;">
                                                <<link "Slip through the rear security door ▼">>
                                                    <<set $sheriff_phase to 3>>
                                                    <<goto "Act3_Sheriff">>
                                                <</link>>
                                                <span class="btn-sub">Step inside the records room corridor.</span>
                                            </button>
                                        </div>
                                    <</replace>>
                                <</link>>
                                <span class="btn-sub"><b style="color:var(--accent-gold);">[STR 6 / MELEE 2]</b> Violent slam. <b style="color:var(--accent-gold);">Low noise.</b></span>
                            </button>
                        <<else>>
                            <button disabled style="opacity:0.4; cursor:not-allowed; border-color:#333;">
                                <span style="text-decoration:line-through;">Tackle and slam [REQUIRES STR 6 / MELEE 2]</span><br>
                                <span class="btn-sub" style="color:#666;">You lack the brute physical power to pin it down before it shrieks.</span>
                            </button>
                        <</if>>

                        <button style="border-left-color:var(--accent-red) !important;">
                            <<link "Tackle it and wrestle it down! (Desperate Struggle)">>
                                <<set $made_noise to true>>
                                <<set $hp -= 15>>
                                <<exert 20>>
                                <<run $(".vn-dialogue-box").scrollTop(0)>>
                                <<replace "#vn-phase2-content">>
                                    You throw your entire body weight into the lunging creature. The two of you crash hard into the steel dumpster with a deafening <i>*BOOM!*</i>
                                    <br><br>
                                    Rotting teeth snap inches from your throat as frantic fingernails gouge across your arm. Spitting blood and freezing rain, you wrench its head sideways and smash its skull repeatedly into the asphalt curb until the thrashing stops.
                                    <br><br>
                                    <b style="color:var(--accent-red);">[INJURY] -15 HP, -20 STAMINA.</b> You lean against the brick wall, bruised and bleeding, chest heaving in the dark.
                                    <br><br>
                                    From the window above, Vane is trembling in panic: <span style="color:var(--accent-red);">"Jesus Christ! The whole alley heard that—get inside, quick!"</span>
                                    <br><br>
                                    The steel crash bar rattles open.
                                    <div class="choice-menu" style="margin-top:20px;">
                                        <button style="border-left-color: var(--accent-red) !important;">
                                            <<link "Scramble through the rear security door ▼">>
                                                <<set $sheriff_phase to 3>>
                                                <<goto "Act3_Sheriff">>
                                            <</link>>
                                            <span class="btn-sub">Escape into the records room corridor.</span>
                                        </button>
                                    </div>
                                <</replace>>
                            <</link>>
                            <span class="btn-sub"><b style="color:var(--accent-red);">[INJURY + NOISE]</b> Costs 20 STAMINA and 15 HP. Brutal brawl. <b style="color:var(--accent-red);">High noise.</b></span>
                        </button>
                    </div>

                <<else>>
                    <br><br>
                    The front of the building is impassable. Your only way inside is to scale or breach the rear maintenance fence alone.

                    <div class="choice-menu" style="margin-top:20px;">
                        <<if $agi >= 6>>
                            <button style="border-left-color: var(--accent-gold) !important;">
                                <<link "Vault off the dumpster lid and grab the open window sill. [AGI 6]">>
                                    <<run $(".vn-dialogue-box").scrollTop(0)>>
                                    <<replace "#vn-phase2-content">>
                                        You take two quick strides, spring off the steel dumpster lid, and catch the wet window sill with your fingertips. In one fluid, acrobatic motion, you pull your chest up and slip through the narrow transom gap, landing lightly in a crouch on the records room linoleum.
                                        <br><br>
                                        <b style="color:var(--accent-green);">Zero noise generated.</b> You reach over and unbolt the rear door from inside.
                                        <div class="choice-menu" style="margin-top:20px;">
                                            <button style="border-left-color: var(--accent-gold) !important;">
                                                <<link "Step into the records corridor ▼">>
                                                    <<set $sheriff_phase to 3>>
                                                    <<goto "Act3_Sheriff">>
                                                <</link>>
                                            </button>
                                        </div>
                                    <</replace>>
                                <</link>>
                                <span class="btn-sub"><b style="color:var(--accent-gold);">[AGI 6]</b> Acrobatic vault. <b style="color:var(--accent-green);">Zero noise.</b></span>
                            </button>
                        <<else>>
                            <button disabled style="opacity:0.4; cursor:not-allowed; border-color:#333;">
                                <span style="text-decoration:line-through;">Dumpster vault [REQUIRES AGI 6]</span><br>
                                <span class="btn-sub" style="color:#666;">You lack the acrobatic agility to reach the window cleanly.</span>
                            </button>
                        <</if>>

                        <<if $str >= 6>>
                            <button style="border-left-color: var(--accent-gold) !important;">
                                <<link "Climb the chain-link fence hand-over-hand. [STR 6]">>
                                    <<exert 10>>
                                    <<run $(".vn-dialogue-box").scrollTop(0)>>
                                    <<replace "#vn-phase2-content">>
                                        You grip the cold steel mesh and haul your weight upward with steady, controlled muscle. Swinging one leg carefully over the top rail to avoid the razor wire, you drop onto the loading dock, absorbing the impact with bent knees.
                                        <br><br>
                                        <b style="color:var(--accent-gold);">Low noise.</b> You pop the window latch and pull yourself into the building.
                                        <div class="choice-menu" style="margin-top:20px;">
                                            <button style="border-left-color: var(--accent-gold) !important;">
                                                <<link "Step into the records corridor ▼">>
                                                    <<set $sheriff_phase to 3>>
                                                    <<goto "Act3_Sheriff">>
                                                <</link>>
                                            </button>
                                        </div>
                                    <</replace>>
                                <</link>>
                                <span class="btn-sub"><b style="color:var(--accent-gold);">[STR 6]</b> Controlled climb. Costs 10 STAMINA. <b style="color:var(--accent-gold);">Low noise.</b></span>
                            </button>
                        <<else>>
                            <button disabled style="opacity:0.4; cursor:not-allowed; border-color:#333;">
                                <span style="text-decoration:line-through;">Climb by strength [REQUIRES STR 6]</span><br>
                                <span class="btn-sub" style="color:#666;">You lack the upper body strength to haul yourself over quietly.</span>
                            </button>
                        <</if>>

                        <<if $equip.weapon == "Crowbar" or $equip.weapon == "Tire Iron" or $inventory.find(i => i.id === "Crowbar")>>
                            <button style="border-left-color: var(--accent-gold) !important;">
                                <<link "Pry the service gate padlock with leverage. [CROWBAR / TIRE IRON]">>
                                    <<run $(".vn-dialogue-box").scrollTop(0)>>
                                    <<replace "#vn-phase2-content">>
                                        You seat the hardened iron pry tip beneath the padlock's shackle and lean your full weight into the bar. The steel housing groans under the pressure—and with a sharp, clean <i>*POP*</i>, the lock snaps.
                                        <br><br>
                                        You catch the chain before it clatters against the pavement and ease the gate open.
                                        <div class="choice-menu" style="margin-top:20px;">
                                            <button style="border-left-color: var(--accent-gold) !important;">
                                                <<link "Step into the records corridor ▼">>
                                                    <<set $sheriff_phase to 3>>
                                                    <<goto "Act3_Sheriff">>
                                                <</link>>
                                            </button>
                                        </div>
                                    <</replace>>
                                <</link>>
                                <span class="btn-sub"><b style="color:var(--accent-gold);">[PRYING TOOL]</b> Snap lock shackle. <b style="color:var(--accent-green);">Zero noise.</b></span>
                            </button>
                        <<else>>
                            <button disabled style="opacity:0.4; cursor:not-allowed; border-color:#333;">
                                <span style="text-decoration:line-through;">Pry gate lock [REQUIRES CROWBAR OR TIRE IRON]</span><br>
                                <span class="btn-sub" style="color:#666;">No heavy prying tool available.</span>
                            </button>
                        <</if>>

                        <<if hasTrait("LOCKSMITH") or $inventory.find(i => i.id === "Lockpicks")>>
                            <button style="border-left-color: var(--accent-gold) !important;">
                                <<link "Pick the gate padlock. [LOCKSMITH / LOCKPICKS]">>
                                    <<run $(".vn-dialogue-box").scrollTop(0)>>
                                    <<replace "#vn-phase2-content">>
                                        Your hands are steady despite the freezing drizzle. You insert the tension wrench and rake the four brass pins. In less than six seconds, the cylinder rotates with a soft mechanical click.
                                        <br><br>
                                        The padlock opens in your palm. The service gate swings inward without a whisper.
                                        <div class="choice-menu" style="margin-top:20px;">
                                            <button style="border-left-color: var(--accent-gold) !important;">
                                                <<link "Step into the records corridor ▼">>
                                                    <<set $sheriff_phase to 3>>
                                                    <<goto "Act3_Sheriff">>
                                                <</link>>
                                            </button>
                                        </div>
                                    <</replace>>
                                <</link>>
                                <span class="btn-sub"><b style="color:var(--accent-gold);">[LOCKSMITH / LOCKPICKS]</b> Pick lock. <b style="color:var(--accent-green);">Zero noise.</b></span>
                            </button>
                        <</if>>

                        <button style="border-left-color:var(--accent-red) !important;">
                            <<link "Scramble frantically over the chain-link! (Brute Force)">>
                                <<exert 15>>
                                <<set $made_noise to true>>
                                <<run $(".vn-dialogue-box").scrollTop(0)>>
                                <<replace "#vn-phase2-content">>
                                    You scramble up the chain-link fence in a desperate rush. The wire mesh rattles violently against the steel posts, echoing down the alley. Your jacket snags on the top barbed wire, tearing with a sharp rip as you tumble over and land hard on the concrete loading dock with a loud metallic crash!
                                    <br><br>
                                    <b style="color:var(--accent-red);">[HIGH NOISE] Costs 15 STAMINA.</b> You scramble through the transom window into the building, heart hammering against your ribs.
                                    <div class="choice-menu" style="margin-top:20px;">
                                        <button style="border-left-color: var(--accent-red) !important;">
                                            <<link "Escape into the records corridor ▼">>
                                                <<set $sheriff_phase to 3>>
                                                <<goto "Act3_Sheriff">>
                                            <</link>>
                                        </button>
                                    </div>
                                <</replace>>
                            <</link>>
                            <span class="btn-sub"><b style="color:var(--accent-red);">[NOISE HAZARD]</b> Costs 15 STAMINA. Rushed scramble. <b style="color:var(--accent-red);">High noise generated.</b></span>
                        </button>
                    </div>
                <</if>>
            </span>
        </div>

/*
══════════════════════════════════════════════════════════════════════════
     PHASE 3 — INTERIOR SEARCH
══════════════════════════════════════════════════════════════════════════
*/
<<elseif $sheriff_phase == 3>>

        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            SUBSTATION — RECORDS & ARMORY CORRIDOR
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-gold); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            <<if not $looted_booking and not $looted_evidence and not $looted_armory>>
                <<if _hasVane>>
                    You push through the back door and drop the interior security bolt into place. Vane leans against the concrete wall, clutching his chest and panting in the dim red emergency light.
                    <br><br>
                    <<chat "Vane" "image/avatars/vane.gif" "right" "The air in here smells like burnt gunpowder and copper... Look down the hall. That's the booking desk and the evidence lockers. Let's see if anyone left a radio log or supplies before whatever happened here happened.">>
                <<else>>
                    You slip inside the rear corridor and pause, listening to the echoing silence.
                    <br><br>
                    The air smells heavily of spent rounds, old coffee, and cold rain. The red emergency strobe pulses down the hallway. Three distinct areas are within reach.
                <</if>>
            <</if>>

            <<run window.animateStatBar('.bar-fill.hp', $hp, $hp_max)>>
            <<run window.animateStatBar('.bar-fill.stamina', $stamina, $stamina_max)>>

            <div class="crisis-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 15px; margin-top: 20px;">

                /* ══ ZONE 1: BOOKING DESK ══ */
                <<if not $looted_booking>>
                    <div class="crisis-card" style="background: rgba(0,40,60,0.2); border: 1px solid #333; padding: 15px; display: flex; flex-direction: column; box-sizing: border-box;">
                        <img src="image/Act3/substation_booking.gif" style="width: 100%; height: 160px; object-fit: cover; border: 1px solid #222; margin-bottom: 10px;">
                        <div style="flex-grow: 1;">
                            <b style="color:var(--accent-blue); font-size:1.1em;">The Booking Desk</b><br><br>
                            Shattered computer screens and scattered patrol logs. An emergency dispatch terminal is still flickering with an active text prompt.
                        </div>
                        <div class="choice-menu" style="margin-top: auto; padding-top: 15px; width: 100%;">
                            <button style="width: 100%; margin: 0; border-left-color: var(--accent-blue) !important;">
                                <<link "Examine the Dispatch Terminal">>
                                    <<addTime 2>>
                                    <<set $looted_booking to true>>
                                    <<goto "Act3_Sheriff">>
                                <</link>>
                                <span class="btn-sub" style="font-size:0.7em;">Check what was typed before the staff fled or fell.</span>
                            </button>
                        </div>
                    </div>
                <<else>>
                    <div class="crisis-card" style="background: rgba(0,40,60,0.1); border: 1px solid #333; padding: 15px; display: flex; flex-direction: column;">
                        <span style="color:var(--accent-green); font-weight:bold;">✓ [DISPATCH TERMINAL SEARCHED]</span>
                        <br><br>
                        <<if $job == "Police Officer">>
                            You punch in a standard county override code. The screen reveals a series of frantic 911 calls that flooded the substation starting around <b>22:00 Saturday night</b>. The final dispatched radio broadcast ordered all surviving staff and civilian refugees to fall back to a fortified perimeter at <b>Timberline Regional High School</b>.
                            <br><br>
                            A chilling unfinished memo is left on the screen:
                            <div style="padding:8px 12px; background:rgba(60,0,0,0.3); border-left:2px solid var(--accent-red); font-size:0.85em; color:#ccc; font-style:italic; margin: 8px 0;">
                                "...perimeter at the high school established by Vice Principal and volunteer staff. Jumpy as hell. Do not approach the school gate on foot without announcing yourself over the horn or having local ID..."
                            </div>
                        <<elseif $int >= 5 or hasTrait("THEORY")>>
                            You scroll through the panicked operator notes. The calls start with violent domestic reports at 10 PM last night, spiraling into total blackout within two hours. A handwritten sticky note on the monitor reads: <i>"FALLBACK: REGIONAL HIGH SCHOOL GYM. BE CAREFUL AT GATES."</i>
                        <<else>>
                            You find an evacuation bulletin printed on the desk:
                            <div style="padding:8px 12px; background:rgba(0,0,0,0.3); border:1px dashed #555; margin:8px 0; font-size:0.85em; color:#ccc; font-style:italic;">
                                ALL UNITS & CIVILIANS FALL BACK TO TIMBERLINE REGIONAL HIGH SCHOOL REFUGEE SANCTUARY.
                            </div>
                        <</if>>
                    </div>
                <</if>>

                /* ══ ZONE 2: EVIDENCE LOCKER ══ */
                <<if not $looted_evidence>>
                    <div class="crisis-card" style="background: rgba(0,40,60,0.2); border: 1px solid #333; padding: 15px; display: flex; flex-direction: column; box-sizing: border-box;">
                        <img src="image/Act3/substation_evidence.gif" style="width: 100%; height: 160px; object-fit: cover; border: 1px solid #222; margin-bottom: 10px;">
                        <div style="flex-grow: 1;">
                            <b style="color:var(--accent-gold); font-size:1.1em;">The Evidence Cage</b><br><br>
                            Heavy steel mesh cage with a padlock on the latch. Inside are stacked tactical vest pouches and emergency field trauma kits.
                            <<if $job == "Doctor" or hasTrait("FIELD MEDIC")>>
                                <br><br>
                                <span style="color:var(--accent-blue); font-size:0.85em; font-style:italic;">
                                    [MEDIC] You spot sealed boxes of broad-spectrum antibiotics and trauma bandages on the second shelf.
                                </span>
                            <</if>>
                        </div>
                        <div class="choice-menu" style="margin-top: auto; padding-top: 15px; width: 100%;">
                            <<if hasTrait("LOCKSMITH") or $inventory.find(i => i.id === "Lockpicks")>>
                                <button style="width: 100%; margin: 0; border-left-color: var(--accent-gold) !important;">
                                    <<link "Pick Evidence Cage">>
                                        <<set $looted_evidence to true>>
                                        <<run setup.addItem("Tactical Vest", 1)>>
                                        <<if $job == "Doctor" or hasTrait("FIELD MEDIC")>>
                                            <<run setup.addItem("Antibiotics", 2)>>
                                            <<run setup.addItem("Painkillers", 2)>>
                                        <</if>>
                                        <<goto "Act3_Sheriff">>
                                    <</link>>
                                    <span class="btn-sub" style="font-size:0.7em;"><b style="color:var(--accent-gold);">[LOCKSMITH]</b> Acquire: <b>Tactical Vest</b><<if $job == "Doctor" or hasTrait("FIELD MEDIC")>>, <b>2× Antibiotics</b>, <b>2× Painkillers</b><</if>>. <b style="color:var(--accent-green);">Zero noise.</b></span>
                                </button>
                            <<elseif $equip.weapon == "Crowbar" or $inventory.find(i => i.id === "Crowbar")>>
                                <button style="width: 100%; margin: 0; border-left-color: var(--accent-gold) !important;">
                                    <<link "Pry Evidence Cage">>
                                        <<set $looted_evidence to true>>
                                        <<run setup.addItem("Tactical Vest", 1)>>
                                        <<if $job == "Doctor" or hasTrait("FIELD MEDIC")>>
                                            <<run setup.addItem("Antibiotics", 1)>>
                                        <</if>>
                                        <<goto "Act3_Sheriff">>
                                    <</link>>
                                    <span class="btn-sub" style="font-size:0.7em;"><b style="color:var(--accent-gold);">[CROWBAR]</b> Acquire: <b>Tactical Vest</b><<if $job == "Doctor" or hasTrait("FIELD MEDIC")>>, <b>1× Antibiotics</b><</if>>. <b style="color:var(--accent-gold);">Low noise.</b></span>
                                </button>
                            <<else>>
                                <button style="width: 100%; margin: 0; border-left-color: var(--accent-red) !important;">
                                    <<link "Smash Cage Lock (Brute Force)">>
                                        <<exert 15>>
                                        <<set $made_noise to true>>
                                        <<set $looted_evidence to true>>
                                        <<run setup.addItem("Tactical Vest", 1)>>
                                        <<goto "Act3_Sheriff">>
                                    <</link>>
                                    <span class="btn-sub" style="font-size:0.7em;"><b style="color:var(--accent-red);">[NOISE]</b> Costs 15 STAMINA. Acquire: <b>Tactical Vest</b>. <b style="color:var(--accent-red);">High noise.</b></span>
                                </button>
                            <</if>>
                        </div>
                    </div>
                <<else>>
                    <div class="crisis-card" style="background: rgba(0,40,60,0.1); border: 1px solid #333; padding: 15px; display: flex; flex-direction: column;">
                        <span style="color:var(--accent-green); font-weight:bold;">✓ [EVIDENCE LOCKER SEARCHED]</span><br>
                        Tactical vest and medical supplies secured.
                    </div>
                <</if>>

                /* ══ ZONE 3: ARMORY SAFE ══ */
                <<if not $looted_armory>>
                    <div class="crisis-card" style="background: rgba(0,40,60,0.2); border: 1px solid #333; padding: 15px; display: flex; flex-direction: column; box-sizing: border-box;">
                        <img src="image/Act3/substation_armory.gif" style="width: 100%; height: 160px; object-fit: cover; border: 1px solid #222; margin-bottom: 10px;">
                        <div style="flex-grow: 1;">
                            <b style="color:var(--accent-red); font-size:1.1em;">The Armory Safe</b><br><br>
                            Reinforced metal cabinet. Beside it stands a personal locker labeled with a nametag: <b>DEP. REYES</b>. Taped inside the louver is a small school photo of a smiling young girl.
                        </div>
                        <div class="choice-menu" style="margin-top: auto; padding-top: 15px; width: 100%;">
                            <<if $job == "Police Officer">>
                                <<if _arrivedLate>>
                                    <button disabled style="width: 100%; margin: 0; opacity:0.4; cursor:not-allowed; border-color:#333;">
                                        <span style="text-decoration:line-through;">Keypad override [OFFLINE]</span>
                                    </button>
                                <<else>>
                                    <button style="width: 100%; margin: 0; border-left-color: var(--accent-gold) !important;">
                                        <<link "Key Municipal Override">>
                                            <<set $looted_armory to true>>
                                            <<run setup.addItem("Remington 870", 1)>>
                                            <<run setup.addItem("Shotgun Shells", 12)>>
                                            <<goto "Act3_Sheriff">>
                                        <</link>>
                                        <span class="btn-sub" style="font-size:0.7em;"><b style="color:var(--accent-gold);">[POLICE]</b> Acquire: <b>Remington 870</b>, <b>12× Shells</b>. <b style="color:var(--accent-green);">Zero noise.</b></span>
                                    </button>
                                <</if>>
                            <<elseif $job == "Burglar" or hasTrait("LOCKSMITH")>>
                                <button style="width: 100%; margin: 0; border-left-color: var(--accent-gold) !important;">
                                    <<link "Pick Reyes's Personal Locker">>
                                        <<set $looted_armory to true>>
                                        <<run setup.addItem("FN Five-Seven", 1)>>
                                        <<run setup.addItem("5.7x28mm Ammo", 20)>>
                                        <<goto "Act3_Sheriff">>
                                    <</link>>
                                    <span class="btn-sub" style="font-size:0.7em;"><b style="color:var(--accent-gold);">[LOCKSMITH]</b> Acquire: <b>FN Five-Seven</b>, <b>20× Ammo</b>. <b style="color:var(--accent-green);">Zero noise.</b></span>
                                </button>
                            <<elseif $skills.tech >= 2 or _hasMultiTool>>
                                <button style="width: 100%; margin: 0; border-left-color: var(--accent-gold) !important;">
                                    <<link "Bypass Solenoid Circuit">>
                                        <<set $looted_armory to true>>
                                        <<run setup.addItem("Remington 870", 1)>>
                                        <<run setup.addItem("Shotgun Shells", 8)>>
                                        <<goto "Act3_Sheriff">>
                                    <</link>>
                                    <span class="btn-sub" style="font-size:0.7em;"><b style="color:var(--accent-gold);">[TECH 2]</b> Acquire: <b>Remington 870</b>, <b>8× Shells</b>. <b style="color:var(--accent-green);">Zero noise.</b></span>
                                </button>
                            <<else>>
                                <button style="width: 100%; margin: 0; border-left-color: var(--accent-red) !important;">
                                    <<link "Sledge Safe Latch (Brute Force)">>
                                        <<exert 20>>
                                        <<set $made_noise to true>>
                                        <<set $looted_armory to true>>
                                        <<run setup.addItem("Remington 870", 1)>>
                                        <<run setup.addItem("Shotgun Shells", 8)>>
                                        <<goto "Act3_Sheriff">>
                                    <</link>>
                                    <span class="btn-sub" style="font-size:0.7em;"><b style="color:var(--accent-red);">[BRUTE FORCE]</b> Costs 20 STAMINA. Acquire: <b>Remington 870</b>, <b>8× Shells</b>. <b style="color:var(--accent-red);">High noise.</b></span>
                                </button>
                            <</if>>
                        </div>
                    </div>
                <<else>>
                    <div class="crisis-card" style="background: rgba(0,40,60,0.1); border: 1px solid #333; padding: 15px; display: flex; flex-direction: column;">
                        <span style="color:var(--accent-green); font-weight:bold;">✓ [ARMORY SEARCHED]</span><br>
                        Firearms and ammunition secured.
                    </div>
                <</if>>

            </div>

            <<if $looted_booking or $looted_evidence or $looted_armory>>
                <div class="choice-menu" style="margin-top:25px;">
                    <button style="border-left-color: var(--accent-red) !important; background: rgba(138,28,28,0.2);">
                        <<link "Make for the rear exit (Loading Dock)">>
                            <<set $sheriff_phase to 4>>
                            <<goto "Act3_Sheriff">>
                        <</link>>
                        <span class="btn-sub">Head back toward the rear loading dock with your gear.</span>
                    </button>
                </div>
            <</if>>
        </div>

/*
══════════════════════════════════════════════════════════════════════════
     PHASE 4 — THE EXIT
══════════════════════════════════════════════════════════════════════════
*/
<<elseif $sheriff_phase == 4>>

    <<if not $made_noise>>
        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            SUBSTATION — LOADING DOCK (SILENT EXIT)
        </div>

        <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
            <img src="image/Act3/substation_loadingdock.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-green); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            You ease back through the records corridor. The red strobe still pulses through the lobby, but the front glass holds. You push the rear exit door open and step out into the freezing pre-dawn air.
            <br><br>
            As you drop off the dock, you freeze.
            <br><br>
            Standing by the maintenance shed fence in the shadows is a woman in a police windbreaker over dark civilian clothes. A tactical respirator hangs loose around her neck, and tinted goggles are pushed up on her forehead. Her face is pale and streaked with soot, her eyes red-rimmed and sunken from hollow grief and hours without sleep.
            <br><br>
            Her hand rests near her holstered sidearm, but she doesn't draw. She stares at you with pure exhaustion.
            <br><br>
            <<if _hasVane>>
                <<chat "Vane" "image/avatars/vane.gif" "right" "...Is she a survivor? How long has she been standing there?">>
                <br>
            <</if>>
            <<chat "Reyes" "image/avatars/reyes.gif" "right" "Easy... I'm not infected. Deputy Reyes. This is my substation. Or it was, until midnight.">>
            <br>
            Her voice is raspy, tight with held-back tears.
            <br><br>
            <<chat "Reyes" "image/avatars/reyes.gif" "right" "I live just down the road. When the 911 calls exploded at ten last night, my radio broadcast told everyone to head for the high school sanctuary. I tried to get my daughter, Emma, there... but the streets were blocked with crashed cars and infected. We were attacked. She didn't make it.">>
            <br>
            She takes a ragged breath, blinking hard against the cold mist.
            <br><br>
            <<chat "Reyes" "image/avatars/reyes.gif" "right" "I couldn't save my own little girl. So I volunteered to scout the roads outside the school on my bike... looking for people who still have a chance. You came out of that station alive, which means you're trying to reach the sanctuary too. But you won't get past the school gates without someone who knows the guards.">>

            <<set $stranger_met to true>>
            <<set $met_reyes to true>>

            <div class="choice-menu" style="margin-top:20px;">
                <button style="border-left-color: var(--accent-blue) !important;">
                    <<link "\"I'm sorry about your daughter. Tell us what's happening at the school.\"">>
                        <<set $stranger_trust to "trusted">>
                        <<set $sheriff_phase to 5>>
                        <<goto "Act3_Sheriff">>
                    <</link>>
                    <span class="btn-sub">Her grief is real. Hear her out and accept her help.</span>
                </button>

                <<if hasTrait("TRUST NO ONE") or hasTrait("LIE DETECTOR")>>
                    <button style="border-left-color: var(--accent-gold) !important;">
                        <<link "\"You've been watching this station the whole time. How do I know you're not leading us into a trap?\" [TRUST NO ONE / LIE DETECTOR]">>
                            <<set $stranger_trust to "interrogated">>
                            <<set $sheriff_phase to 5>>
                            <<goto "Act3_Sheriff">>
                        <</link>>
                        <span class="btn-sub"><b style="color:var(--accent-gold);">[TRUST NO ONE]</b> Read her voice and posture for any sign of deception.</span>
                    </button>
                <</if>>

                <<if hasTrait("DIPLOMAT") or hasTrait("SILVER TONGUE") or $cha >= 7>>
                    <button style="border-left-color: var(--accent-gold) !important;">
                        <<link "\"I'm $firstName. You're doing something brave out here, Deputy. We have a car and we can help each other.\" [DIPLOMAT / CHA 7]">>
                            <<set $stranger_trust to "allied">>
                            <<set $sheriff_phase to 5>>
                            <<goto "Act3_Sheriff">>
                        <</link>>
                        <span class="btn-sub"><b style="color:var(--accent-gold);">[DIPLOMAT / CHA 7]</b> Acknowledge her sacrifice and form a mutual partnership.</span>
                    </button>
                <</if>>
            </div>
        </div>

    <<else>>
        <!-- NOISE WAS GENERATED: EMERGENCY LOCKDOWN -->
        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            SUBSTATION — EMERGENCY ALARM BREACH
        </div>

        <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
            <img src="image/Act3/substation_loadingdock.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
        </div>

        <<run setup.sound.play("siren_alarm", "audio/sfx/car_alarm_wail.mp3", true, 0.8)>>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-red); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            Before you reach the rear exit door, an automated building alarm detonates with a deafening siren that shrieks through the ceiling horns!
            <br><br>
            Heavy motorized fire shutters begin groaning downward, threatening to trap you inside. Through the front glass, infected turn in a frenzy and surge toward the records hallway!
            <br><br>
            <<if _hasVane>>
                <<chat "Vane" "image/avatars/vane.gif" "right" "The emergency shutters are dropping! We're gonna be trapped!">>
                <br>
            <</if>>
            Suddenly, a figure in a police windbreaker and respirator appears at the exterior maintenance console. Her hands slam against the manual release valve. The descending steel shutter screeches and halts fifty centimeters off the concrete!
            <br><br>
            She tosses a burning road flare into the front hallway to distract the infected, then reaches under the shutter toward you.
            <br><br>
            <<chat "Reyes" "image/avatars/reyes.gif" "right" "Deputy Reyes! Slide under the shutter NOW! It's not going to hold!">>

            <<set $stranger_met to true>>
            <<set $met_reyes to true>>

            <div class="choice-menu" style="margin-top:20px;">
                <button style="border-left-color: var(--accent-red) !important;">
                    <<link "Drop and slide under the steel shutter!">>
                        <<set $stranger_trust to "trusted">>
                        <<set $sheriff_phase to 5>>
                        <<goto "Act3_Sheriff">>
                    <</link>>
                    <span class="btn-sub">Roll out onto the loading dock into the alley.</span>
                </button>

                <<if hasTrait("TRUST NO ONE") or hasTrait("LIE DETECTOR")>>
                    <button style="border-left-color: var(--accent-gold) !important;">
                        <<link "\"Who are you and why did you help us?\" [TRUST NO ONE / LIE DETECTOR]">>
                            <<set $stranger_trust to "interrogated">>
                            <<set $sheriff_phase to 5>>
                            <<addTime 1>>
                            <<goto "Act3_Sheriff">>
                        <</link>>
                        <span class="btn-sub"><b style="color:var(--accent-gold);">[LIE DETECTOR]</b> Rapid read as you scramble under the steel bar.</span>
                    </button>
                <</if>>

                <<if hasTrait("DIPLOMAT") or hasTrait("SILVER TONGUE") or $cha >= 7>>
                    <button style="border-left-color: var(--accent-gold) !important;">
                        <<link "\"I'm $firstName. Pull us through and we've got your back.\" [DIPLOMAT / CHA 7]">>
                            <<set $stranger_trust to "allied">>
                            <<set $sheriff_phase to 5>>
                            <<goto "Act3_Sheriff">>
                        <</link>>
                        <span class="btn-sub"><b style="color:var(--accent-gold);">[DIPLOMAT]</b> Establish camaraderie in the heat of the moment.</span>
                    </button>
                <</if>>
            </div>
        </div>
    <</if>>

/*
══════════════════════════════════════════════════════════════════════════
     PHASE 5 — REYES REACTION & VEHICLE CAPACITY
══════════════════════════════════════════════════════════════════════════
*/
<<elseif $sheriff_phase == 5>>

        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            SUBSTATION — ALLEYWAY EXTRACTION
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            <<run setup.sound.stop("siren_alarm")>>

            <<if $stranger_trust == "interrogated">>
                Reyes pulls her respirator down to her chest. Her eyes are heavy with unspeakable fatigue.
                <br><br>
                <<chat "Reyes" "image/avatars/reyes.gif" "right" "I have no reason to lie to you. My house is just down the road—I lived there with my daughter, Emma. When the town collapsed around midnight, I tried to get her to the high school sanctuary. She died in my arms on that road. I don't care about anything now except helping other people reach those gates alive.">>
                <br>
                <<if hasTrait("LIE DETECTOR")>>
                    <div style="padding:10px 14px; background:rgba(0,30,50,0.3); border-left:3px solid var(--accent-blue); margin:10px 0; font-size:0.85em;">
                        <span style="color:var(--accent-blue);">[LIE DETECTOR]</span> Her hands tremble with grief, but her gaze is completely steady. The sorrow over her daughter is raw and genuine. She is telling the absolute truth.
                    </div>
                <</if>>
            <<elseif $stranger_trust == "allied">>
                Reyes gives a faint, appreciative nod, wiping a bead of rain from her eyebrow.
                <br><br>
                <<chat "Reyes" "image/avatars/reyes.gif" "right" "Thanks, $firstName. Having people who can still talk calmly after a night like this gives me hope. Let's get to your vehicle.">>
            <<else>>
                You follow Reyes down the wet gravel path toward the parked sedan.
            <</if>>

            <br>
            As you reach the car, Reyes peers through the window.

            <<if _carFull and _hasKids>>
                <br><br>
                Her gaze immediately locks onto Maya in the back seat, holding young Lily tucked protectively against her jacket, and Diane with her two boys.
                <br><br>
                Reyes's breath catches in her throat. A look of overwhelming, piercing grief washes over her features as she stares at the children. Her hand drops from the car door handle.
                <br><br>
                <<chat "Reyes" "image/avatars/reyes.gif" "right" "You have children in there.">>
                <br>
                She steps back, swallowing hard, her jaw tightening with fierce resolve.
                <br><br>
                <<chat "Reyes" "image/avatars/reyes.gif" "right" "I'm not crowding that car or draining your fuel. I have my mountain bike stashed in the maintenance shed around the corner. I've been riding on two wheels since midnight—silent, fast, and able to squeeze through blocked alleys. I'll ride point and scout the turns ahead. We're going to get those kids to safety. Follow my rear light.">>
                <<set $reyes_rides_bike to true>>
                <<set $sheriff_phase to 6>>

            <<elseif _carFull>>
                <br><br>
                She counts the passengers through the windshield.
                <br><br>
                <<chat "Reyes" "image/avatars/reyes.gif" "right" "That car is at full capacity. Extra weight will only risk blowing a tire on these broken rural roads. I have my mountain bike stashed in the shed—I'll ride point and scout ahead on two wheels.">>
                <<set $reyes_rides_bike to true>>
                <<set $sheriff_phase to 6>>

            <<elseif _hasKids>>
                <br><br>
                She sees the children in the rear seat. Her eyes soften with deep emotion.
                <br><br>
                <<chat "Reyes" "image/avatars/reyes.gif" "right" "Keep the kids comfortable. I'll take my mountain bike from the shed and ride ahead to scout the intersections. It's safer if I check the road first.">>
                <<set $reyes_rides_bike to true>>
                <<set $sheriff_phase to 6>>

            <<else>>
                <br><br>
                <<chat "Reyes" "image/avatars/reyes.gif" "right" "There's room in the passenger seat, or I can pull my mountain bike from the shed and ride point to scout ahead. What do you prefer?">>
            <</if>>

            <<if not _carFull and not _hasKids>>
                <div class="choice-menu" style="margin-top:20px;">
                    <button style="border-left-color: var(--accent-gold) !important;">
                        <<link "Ride point on the bike. Scout the road ahead.">>
                            <<set $reyes_rides_bike to true>>
                            <<set $sheriff_phase to 6>>
                            <<goto "Act3_Sheriff">>
                        <</link>>
                        <span class="btn-sub">She knows the local side streets and can move silently.</span>
                    </button>
                    <button style="border-left-color: var(--accent-blue) !important;">
                        <<link "Get in the car. We stay together.">>
                            <<set $reyes_rides_bike to false>>
                            <<set $sheriff_phase to 6>>
                            <<goto "Act3_Sheriff">>
                        <</link>>
                        <span class="btn-sub">Keep everyone inside the vehicle for maximum protection.</span>
                    </button>
                </div>
            <<else>>
                <div class="choice-menu" style="margin-top:20px;">
                    <button style="border-left-color: var(--accent-gold) !important;">
                        <<link "Prepare to follow Reyes ▼">>
                            <<goto "Act3_Sheriff">>
                        <</link>>
                    </button>
                </div>
            <</if>>
        </div>

/*
══════════════════════════════════════════════════════════════════════════
     PHASE 6 — THE ESCORT OUT
══════════════════════════════════════════════════════════════════════════
*/
<<elseif $sheriff_phase == 6>>

        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            TIMBERLINE — EN ROUTE TO HIGH SCHOOL SANCTUARY
        </div>

        <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
            <img src="image/Act3/substation_exterior.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            <<run setup.sound.stop("siren_alarm")>>

            <<if $reyes_rides_bike>>
                Reyes runs to the maintenance shed and wheels out a matte-black mountain bike. She fastens a small, dim red LED light to the seat post.
                <br><br>
                <<if _hasVane>>
                    <<chat "Vane" "image/avatars/vane.gif" "right" "Smart... silent, fast on rough dirt trails. She's doing everything she can to survive.">>
                <<elseif _hasMaya>>
                    In the backseat, Maya holds Lily close, her eyes shining with quiet gratitude as she watches Reyes prepare the route.
                <<elseif _hasDiane>>
                    Diane watches through the window with a solemn, respectful nod. <span style="color:var(--accent-green);">"A mother who lost everything... she'll fight like hell to protect what's left."</span>
                <</if>>
                <br><br>
                <<chat "Reyes" "image/avatars/reyes.gif" "right" "Follow my red light. Keep about twenty meters behind me so you have room to brake. When we reach the high school perimeter, stay in the car. The Vice Principal and the volunteer guards are scared and jumpy after last night. Let me talk to them first—they know my badge.">>
                <br><br>
                She pushes off the gravel and pedals smoothly into the dark, foggy morning road ahead.
            <<else>>
                Reyes climbs into the car and rests her hands on her knees, staring out at the foggy windshield.
                <br><br>
                <<chat "Reyes" "image/avatars/reyes.gif" "right" "Head north on County Road 4. When we pull up to the high school gate, let me step out first. The Vice Principal has the place locked down tight, and the sentries will be on edge. They know my face.">>
                <br><br>
                She leans back against the headrest, closing her eyes for a brief moment to gather her strength.
            <</if>>

            <br><br>
            The engine hums quietly. You pull out of the substation gravel lot, rolling north through the mist toward <b>Timberline Regional High School</b>.

            <<set $companion_reyes to true>>
            <<set $sheriff_phase to undefined>>

            <div class="choice-menu" style="margin-top:25px;">
                <button style="border-left-color: var(--accent-gold) !important;">
                    <<link "Follow Reyes to Timberline High School Sanctuary">>
                        <<completeObjective "find_intel">>
                        <<addObjective "reach_safehaven" "Find and gain entry into the High School Sanctuary">>
                        <<purgeCompleted>>
                        <<goto "Act3_ArrivalSchool">>
                    <</link>>
                    <span class="btn-sub">She knows the checkpoint sentries. Follow her lead to get past the gates safely.</span>
                </button>
            </div>
        </div>

<</if>>

    </div>
</div>
<</nobr>>