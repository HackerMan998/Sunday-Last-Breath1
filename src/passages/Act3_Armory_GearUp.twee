:: Act3_Armory_GearUp {"position":"750,1650","size":"100,100"}
<<nobr>>
<<if ndef $firstName or $firstName == "???">>
    <<set $firstName to "Neal">>
<</if>>
<<if ndef $lastName>>
    <<set $lastName to "Sage">>
<</if>>
<<set $currentLocation to "screening">>
<<set $inSafehouse to true>>
<<set _arrivedLate to (visited("Act2_5_MarcusCabin"))>>

/* DYNAMIC LEADER CONFIGURATION */
<<set _leaderName to "Commander Hayes">>
<<set _leaderAvatar to "image/avatars/leader_default_hayes.gif">>
<<set _leaderRef to "Commander Hayes">>

<<if $anchor == "partner_f">>
    <<set _leaderName to $anchor_name>>
    <<set _leaderAvatar to "image/avatars/leader_f.gif">>
    <<set _leaderRef to ($anchor_rel ? "your " + $anchor_rel + ", " + $anchor_name : "your girlfriend, " + $anchor_name)>>
    <<set _subj to "she">>
    <<set _obj to "her">>
    <<set _poss to "her">>
    <<set _capSubj to "She">>
<<elseif $anchor == "partner_m">>
    <<set _leaderName to $anchor_name>>
    <<set _leaderAvatar to "image/avatars/leader_m.gif">>
    <<set _leaderRef to ($anchor_rel ? "your " + $anchor_rel + ", " + $anchor_name : "your boyfriend, " + $anchor_name)>>
    <<set _subj to "he">>
    <<set _obj to "him">>
    <<set _poss to "his">>
    <<set _capSubj to "He">>
<<elseif $anchor == "partner_nb">>
    <<set _leaderName to $anchor_name>>
    <<set _leaderAvatar to "image/avatars/leader_nb.gif">>
    <<set _leaderRef to "your partner, " + $anchor_name>>
    <<set _subj to "they">>
    <<set _obj to "them">>
    <<set _poss to "their">>
    <<set _capSubj to "They">>
<<elseif $anchor == "parents">>
    <<set _leaderName to "Dad">>
    <<set _leaderAvatar to "image/avatars/leader_dad.gif">>
    <<set _leaderRef to "your father">>
    <<set _subj to "he">>
    <<set _obj to "him">>
    <<set _poss to "his">>
    <<set _capSubj to "He">>
<<else>>
    <<set _subj to "he">>
    <<set _obj to "him">>
    <<set _poss to "his">>
    <<set _capSubj to "He">>
<</if>>

/* 1. INITIALIZE SANCTUARY STORAGE CHEST (RE-STYLE ITEM BOX) */
<<if ndef $sanctuary_chest>>
    <<set $sanctuary_chest to []>>
<</if>>

/* 2. AUTOMATICALLY UNSEAL AND RETURN CONFISCATED WEAPONS */
<<set _returnedCount to 0>>
<<if def $quartermaster_stash and $quartermaster_stash.length > 0>>
    <<for _i to 0; _i < $quartermaster_stash.length; _i++>>
        <<run $inventory.push($quartermaster_stash[_i])>>
        <<set _returnedCount++>>
    <</for>>
    <<set $quartermaster_stash to []>>
    <<set $weapons_confiscated to false>>
<</if>>

/* 3. ISSUE MILITARY TACTICAL HARNESS (+4 BAG SLOTS EXPANSION) */
<<if ndef $bag_limit or $bag_limit < 16>>
    <<set $bag_limit to 16>>
<</if>>

/* 4. TRACK SORTIE SELECTION & ONE-TIME GEAR UP FLAG */
<<if ndef $armory_gearup_done>>
    <<set $armory_gearup_done to false>>
<</if>>
<<if ndef $sortie_package_chosen>>
    <<set $sortie_package_chosen to "none">>
<</if>>
<</nobr>>

<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">
        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            GROUND FLOOR — SCREENING &amp; TACTICAL ARMORY CAGE
        </div>

        <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
            <img src="image/Act3_Timberline/screening.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-gold); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            <span id="vn-armory-main">
                <<if not $armory_gearup_done>>
                    The overhead PA speaker in the screening cage pops and hums with harsh feedback. Evelyn's voice cuts through the static, raw and breathless:
                    <br><br>
                    <<if $anchor == "parents">>
                        <i style="color:var(--accent-red);">"Vance! Arthur's kid made it—$firstName is alive! Break the seal on the intake lockers and release their confiscated gear immediately! Open the tier-one munitions crate. They are rolling with Reyes to Route 9 right now to get their father!"</i>
                    <<elseif $anchor == "partner_f" or $anchor == "partner_m" or $anchor == "partner_nb">>
                        <i style="color:var(--accent-red);">"Vance! _leaderName's partner is here—it's $firstName! Release their weapons right now! Open the tier-one munitions crate. They are deploying with Reyes to Route 9 to get _leaderName back!"</i>
                    <<else>>
                        <i style="color:var(--accent-red);">"Vance! It's Code Red—Hayes's squad is pinned down! Give $firstName their weapons back immediately and open the heavy weapons crate! They are rolling with Reyes to Route 9 right now to get Hayes out!"</i>
                    <</if>>
                    <br><br>
                    Sgt. Vance kicks the chain-link gate open before the transmission even finishes. The sharp scent of gun solvent, copper, and cosmoline fills the air. He drops your heavy canvas duffel onto the steel counter with a metallic clatter, his eyes darting between the masking-tape tag on the fabric and your face.
                    <br><br>
                    <<if $anchor == "parents">>
                        <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "When you came through my screening desk an hour ago, I just saw another exhausted survivor with road mud on your boots. Wrote '$firstName $lastName' on the tape, tossed your bag onto the intake shelf, and told you to move along...">>
                        <br><br>
                        He shakes his head, staring at you in sheer disbelief as he slashes the zip-tie seals on your bag with a combat blade.
                        <br><br>
                        <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "Then the radio room patches Arthur's broadcast through, screaming your name over the horn, and Evelyn calls down sobbing... I looked down at this tag: $lastName. Holy hell. You're Arthur and Evelyn's kid.">>
                        <br><br>
                        <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "Your old man checked that intake gate fifty times before he rolled out this morning. Kept asking the guards at the gate if any cars had come down the valley road. He was worried sick about you, kid. Now go drag him back out of that freezer.">>
                    <<elseif $anchor == "partner_f" or $anchor == "partner_m" or $anchor == "partner_nb">>
                        <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "When you came through intake an hour ago, I didn't think twice. Tagged your bag, tossed it on the rack, and shoved you toward the foyer...">>
                        <br><br>
                        He shakes his head, staring at you in disbelief as he slashes the zip-tie seals on your bag with a combat blade.
                        <br><br>
                        <<if $anchor == "partner_nb">>
                            <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "Then the radio room patches the Route 9 distress call through, the whole floor hears _leaderName breaking down over the static when they heard your voice, and Evelyn calls down... You're the one they wouldn't stop talking about since the convoy reached Timberline.">>
                            <br><br>
                            <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "_leaderName practically wore a trench in my concrete pacing this room before they left. Kept asking the gate guards if anyone matching your description had been spotted. Go bring them back in one piece.">>
                        <<else>>
                            <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "Then the radio room patches the Route 9 distress call through, the whole floor hears _leaderName breaking down over the static when <<print _subj>> heard your voice, and Evelyn calls down... You're the one <<print _subj>> wouldn't stop talking about since the convoy reached Timberline.">>
                            <br><br>
                            <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "_leaderName practically wore a trench in my concrete pacing this room before <<print _subj>> left. Kept asking the gate guards if anyone matching your description had been spotted. Go bring <<print _obj>> back in one piece.">>
                        <</if>>
                    <<else>>
                        <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "When you came through screening with Reyes, I figured you were just another mouth to feed. Now Evelyn calls down Code Red and Reyes tells me you're the one who dragged her through the road ambushes.">>
                        <br><br>
                        He slashes the zip-tie seals on your bag with a combat blade and dumps your iron onto the counter.
                        <br><br>
                        <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "Commander Hayes didn't want to leave the perimeter, but the hospital ward was going dark. We can't afford to lose our chief tactician on that highway. Let's see what you've got.">>
                    <</if>>
                    <br><br>
                    <<if _arrivedLate>>
                        <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "You rolled in after sunrise with the valley roads crawling, barely got through intake, and now Evelyn's got you gearing right back up for broad daylight combat.">>
                    <<else>>
                        <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "You barely came in out of that freezing rain, boots still dripping wet from the road, and now Evelyn's got you rolling straight back out into the dark.">>
                    <</if>>
                    <br><br>
                    <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "No requisition slips, no signatures today. Here's your iron—clean firing pins, full springs.">>
                    <br><br>
                    He shoves a heavy, reinforced tactical chest harness across the scratched steel.
                    <br><br>
                    <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "Strap this on. Eight modular pouches and double utility sleeves. Don't go fumbling through a civilian backpack while some scav is dumping buckshot into your windshield.">>
                    <br><br>
                    <<if $anchor == "parents">>
                        <<chat "You" "image/avatars/player.gif" "left" "I don't care about the harness, Vance—my dad has minutes left in that cooler. What kind of heavy ordnance did Evelyn clear for us?">>
                    <<elseif $anchor == "partner_f" or $anchor == "partner_m" or $anchor == "partner_nb">>
                        <<chat "You" "image/avatars/player.gif" "left" "I don't care about the harness, Vance—_leaderName is holding that door with six bullets. What kind of fire did Evelyn authorize?">>
                    <<else>>
                        <<chat "You" "image/avatars/player.gif" "left" "Save the lecture, Vance. If we're breaching that 7-Eleven, we need serious stopping power. Show me what Evelyn authorized.">>
                    <</if>>
                    <br><br>
                    <div style="background: rgba(0, 80, 0, 0.25); border: 1px solid var(--accent-green); border-radius: 6px; padding: 12px; margin: 12px 0; font-size: 0.9em;">
                        <b style="color:var(--accent-green);">✔ CONFISCATED ARSENAL RESTORED:</b> All personal weapons returned to your hands.
                        <br>
                        <b style="color:var(--accent-green);">✔ COMBAT HARNESS EQUIPPED:</b> Carrying capacity expanded to <b><<print $bag_limit>> Slots</b> (Current: <<print $inventory.length>> / <<print $bag_limit>>).
                        <<if $sanctuary_chest.length > 0>>
                            <br>
                            <b style="color:var(--accent-gold);">📦 SECURE LOCKER:</b> <<print $sanctuary_chest.length>> items stashed in Vance's cage.
                        <</if>>
                    </div>

                    Vance drops a reinforced military footlocker onto the table, popping the heavy latches with his thumb.
                    <br><br>
                    <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "Listen close. That 7-Eleven is a damn kill box. You've got shattered plate glass, tight snack aisles, and an overturned fuel tanker leaking near the diesel pumps. One stray spark and the whole block turns into a funeral pyre.">>
                    <br><br>
                    <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "Evelyn cleared ONE heavy loadout from our reserve crates. You want raw stopping power for the front door, range to countersnipe the scavs, stealth to flank the alley, or field trauma kits to patch up the wounded? Pick your package and lock it in—Reyes is already revving the engine!">>
                <<else>>
                    Sgt. Vance is hurriedly racking spare magazines into a secondary ammo box, sweat beading on his temple under the humming fluorescent tubes.
                    <br><br>
                    <<chat "Sgt. Vance" "image/avatars/quartermaster_sgtvance.gif" "right" "You're loaded for bear, partner. Reyes has the truck idling by the back gate—stop standing around staring at me! Every second you burn here is another second of glass bowing in that cooler. Get out there and bring them back!">>
                    <br><br>
                    <div style="background: rgba(0, 80, 150, 0.25); border: 1px solid var(--accent-blue); border-radius: 6px; padding: 12px; margin: 12px 0; font-size: 0.9em;">
                        <b style="color:var(--accent-blue);">✔ SORTIE LOADOUT READY:</b> <<print $sortie_package_chosen.toUpperCase()>> KIT LOCKED.
                        <br>
                        <b style="color:var(--accent-green);">✔ GEAR CAPACITY:</b> <<print $inventory.length>> / <<print $bag_limit>> Slots in use.
                        <<if $sanctuary_chest.length > 0>>
                            <br>
                            <b style="color:var(--accent-gold);">📦 SECURE LOCKER:</b> <<print $sanctuary_chest.length>> items stashed in Vance's cage.
                        <</if>>
                    </div>
                <</if>>
            </span>
        </div>

        <div class="choice-menu">
            <!-- BASE STORAGE STASH & RETRIEVE ACTIONS -->
            <<if $inventory.some(i => setup.items[i.id] && setup.items[i.id].type !== "weapon" && setup.items[i.id].type !== "ammo" && !setup.items[i.id].desc.includes("Medical") && !setup.items[i.id].desc.includes("heals") && i.id !== "First Aid Kit" && i.id !== "Bandage" && i.id !== "Antibiotics" && i.id !== "Painkillers")>>
                <button style="border-left-color: var(--accent-gold) !important; background: rgba(80, 60, 0, 0.3); margin-bottom: 12px;">
                    <<link "📦 Stash Non-Combat Clutter into Armory Locker - ITEM BOX">>
                        <<run $(".vn-dialogue-box").scrollTop(0)>>
                        <<for _i to $inventory.length - 1; _i >= 0; _i-->>
                            <<set _id to $inventory[_i].id>>
                            <<set _db to setup.items[_id]>>
                            <<if _db and _db.type !== "weapon" and _db.type !== "ammo" and _id !== "First Aid Kit" and _id !== "Bandage" and _id !== "Antibiotics" and _id !== "Painkillers">>
                                <<run $sanctuary_chest.push($inventory[_i])>>
                                <<run $inventory.splice(_i, 1)>>
                            <</if>>
                        <</for>>
                        <<goto "Act3_Armory_GearUp">>
                    <</link>>
                    <span class="btn-sub"><b style="color:var(--accent-gold);">[BASE LOCKER]</b> Stash non-essential books, trade items, and scrap into Vance's locked locker to maximize combat carrying capacity.</span>
                </button>
            <</if>>

            <<if def $sanctuary_chest and $sanctuary_chest.length > 0>>
                <button style="border-left-color: var(--accent-gold) !important; background: rgba(80, 60, 0, 0.2); margin-bottom: 12px;">
                    <<link "📦 Retrieve All Items from Armory Locker - ITEM BOX">>
                        <<run $(".vn-dialogue-box").scrollTop(0)>>
                        <<run $inventory.push(...$sanctuary_chest)>>
                        <<set $sanctuary_chest to []>>
                        <<goto "Act3_Armory_GearUp">>
                    <</link>>
                    <span class="btn-sub"><b style="color:var(--accent-gold);">[BASE LOCKER]</b> Retrieve all items currently stored in Vance's lockbox.</span>
                </button>
            <</if>>

            <!-- SORTIE PACKAGES: 1-TIME SELECTION ONLY -->
            <<if not $armory_gearup_done>>
                <!-- SORTIE PACKAGE 1: BREACHER (SHOTGUN) -->
                <button style="border-left-color: var(--accent-red) !important;">
                    <<link "💥 Requisition: Breacher Kit - REMINGTON 870 SHOTGUN + 12 SHELLS">>
                        <<run $(".vn-dialogue-box").scrollTop(0)>>
                        <<set $sortie_package_chosen to "breacher">>
                        <<set $armory_gearup_done to true>>
                        <<run setup.addItem("Remington 870", 1)>>
                        <<run setup.addItem("Shotgun Shells", 12)>>
                        <<if $equip.weapon == "none">>
                            <<set $equip.weapon to "Remington 870">>
                        <</if>>
                        <<goto "Act3_Armory_GearUp">>
                    <</link>>
                    <span class="btn-sub"><b style="color:var(--accent-red);">[CQB SPECIALIST]</b> Devastating close-quarters stopping power inside the convenience store. Blows through barricades and stops infected in their tracks.</span>
                </button>

                <!-- SORTIE PACKAGE 2: MARKSMAN (M4A1 CARBINE) -->
                <button style="border-left-color: var(--accent-blue) !important;">
                    <<link "🎯 Requisition: Marksman Kit - M4A1 ASSAULT RIFLE + 60 ROUNDS 5.56MM">>
                        <<run $(".vn-dialogue-box").scrollTop(0)>>
                        <<set $sortie_package_chosen to "marksman">>
                        <<set $armory_gearup_done to true>>
                        <<run setup.addItem("M4A1", 1)>>
                        <<run setup.addItem("5.56mm Ammo", 60)>>
                        <<if $equip.weapon == "none">>
                            <<set $equip.weapon to "M4A1">>
                        <</if>>
                        <<goto "Act3_Armory_GearUp">>
                    <</link>>
                    <span class="btn-sub"><b style="color:var(--accent-blue);">[RAPID FIREPOWER]</b> High-velocity military carbine with lethal mid-range precision. Suppresses armed scavengers and cuts through body armor.</span>
                </button>

                <!-- SORTIE PACKAGE 3: INFILTRATOR (BOW & COMBAT KNIFE) -->
                <button style="border-left-color: var(--accent-gold) !important;">
                    <<link "🥷 Requisition: Silent Infiltrator Kit - COMPOUND BOW + COMBAT KNIFE">>
                        <<run $(".vn-dialogue-box").scrollTop(0)>>
                        <<set $sortie_package_chosen to "infiltrator">>
                        <<set $armory_gearup_done to true>>
                        <<run setup.addItem("Compound Bow", 1)>>
                        <<run setup.addItem("Arrows", 15)>>
                        <<run setup.addItem("Combat Knife", 1)>>
                        <<if $equip.weapon == "none">>
                            <<set $equip.weapon to "Compound Bow">>
                        <</if>>
                        <<goto "Act3_Armory_GearUp">>
                    <</link>>
                    <span class="btn-sub"><b style="color:var(--accent-gold);">[STEALTH FLANK]</b> Silent takedowns and reusable arrows. Perfect for slipping through the alley behind the convenience store undetected.</span>
                </button>

                <!-- SORTIE PACKAGE 4: FIELD MEDIC (SUPPLIES) -->
                <button style="border-left-color: var(--accent-green) !important;">
                    <<link "💉 Requisition: Field Trauma Kit - 2 FIRST AID KITS, 3 BANDAGES, 1 ANTIBIOTICS">>
                        <<run $(".vn-dialogue-box").scrollTop(0)>>
                        <<set $sortie_package_chosen to "medic">>
                        <<set $armory_gearup_done to true>>
                        <<run setup.addItem("First Aid Kit", 2)>>
                        <<run setup.addItem("Bandage", 3)>>
                        <<run setup.addItem("Antibiotics", 1)>>
                        <<goto "Act3_Armory_GearUp">>
                    <</link>>
                    <span class="btn-sub"><b style="color:var(--accent-green);">[FIELD MEDIC]</b> Heavy emergency surgical supplies. Vital for stabilizing wounded survivors and patching catastrophic gunshot trauma.</span>
                </button>

                <div style="margin-top: 15px; padding: 12px; background: rgba(0,0,0,0.4); border: 1px solid #444; border-radius: 4px; text-align: center; color: #aaa; font-size: 0.88em; font-style: italic;">
                    🔒 <b>Rescue Vehicle Locked:</b> Select one of the emergency supply kits above to complete your preparations and unlock the departure vehicle.
                </div>
            <<else>>
                <!-- MOUNT UP WITH REYES (UNLOCKED ONLY AFTER PACKAGE IS CHOSEN) -->
                <div style="margin-top: 15px; border-top: 1px solid #333; padding-top: 15px;">
                    <button style="border-left-color: var(--accent-green) !important; background: rgba(0, 100, 0, 0.35); font-size: 1.05em;">
                        <<link "🚗 Mount up with Reyes in the Pickup & Roll Out - ROUTE 9 RESCUE">>
                            <<run $(".vn-dialogue-box").scrollTop(0)>>
                            <<set $currentLocation to "seven_eleven_outskirts">>
                            <<addTime 15>>
                            <<goto "Act3_7Eleven_Arrival">>
                        <</link>>
                        <span class="btn-sub"><b style="color:var(--accent-green);">[ROLL OUT]</b> Weapon ready, rig secured. Jump into the shotgun seat with Reyes and haul ass to Route 9!</span>
                    </button>

                    <button style="border-left-color: var(--accent-blue) !important; margin-top: 10px;">
                        <<link "🏫 Step back into Ground Floor Corridor - HUB">>
                            <<run $(".vn-dialogue-box").scrollTop(0)>>
                            <<set $currentLocation to "hall_g_east_2">>
                            <<goto "Act3_SchoolGFloor">>
                        <</link>>
                        <span class="btn-sub">Check on other survivors or visit the infirmary before departing.</span>
                    </button>
                </div>
            <</if>>
        </div>
    </div>
</div>

