:: Unit_406 {"position":"0,650","size":"100,100"}
<!-- ======================================================= -->
<!-- INITIALIZATION & SETUP                                  -->
<!-- ======================================================= -->
<<nobr>>
    /* AUDIO: Ticking Clock Room Tone */
    <<run setup.sound.play("ticking_clock", "audio/sfx/tick.mp3", true, 0.2)>>

    <<set $currentLocation to "406">>
    
    /* Variable Defaults */
    <<if not $room406_opened>><<set $room406_opened to false>><</if>>
    <<if not $failed_406_attempts>><<set $failed_406_attempts to 0>><</if>>
    <<if not $studied_406_mechanics>><<set $studied_406_mechanics to false>><</if>>
    <<if not $studied_406_anatomy>><<set $studied_406_anatomy to false>><</if>>
    <<if not $looted_406>><<set $looted_406 to false>><</if>>
    <<if not $read_406_journal>><<set $read_406_journal to false>><</if>>
    <<if not $looted_406_kitchen>><<set $looted_406_kitchen to false>><</if>>

    /* Setup Physical Bypass Costs */
    <<set _baseCost to 15>>
    <<set _halfCost to Math.round(_baseCost / 2)>>
<</nobr>>


<!-- ======================================================= -->
<!-- PHASE 1: EXTERIOR (THE KEYPAD)                          -->
<!-- ======================================================= -->
<<if not $room406_opened>>
    <h2>UNIT 406 — THE KEYPAD</h2>

    Professor Harmon taught history and behavioral sociology at the university. You'd chatted with him in the elevator a few times — he always smelled like old paper and peppermint tea, and he talked about the psychology of collapsing civilizations the way most people talked about the weather. *Inevitable. Interesting. Nothing personal.*

    The door is sealed with an electronic lock. A small keypad glows faintly in the dark, its LEDs casting cold blue light across your fingers. Four blank digits. Waiting.

    Someone has taped a yellowed index card above it. His handwriting, spidery and precise:

    <div style="padding:10px; background:#0a0a0a; border:1px solid #333; font-family:'Courier Prime',monospace; color:#aaa; font-style:italic; margin:10px 0; text-align:center;">
    *"If I'm not answering, I'm either dead or at the library.*
    *Either way, you're not getting in."*
    </div>

    You almost smile. Almost.

    <br>
    <<chat "You" "image/avatars/player.gif" "left" "Dark sense of humor. I hope you made it out of here, Professor.">>
    <br>

    <!-- ------------------------------------------------------- -->
    <!-- KEYPAD STATE: BRICKED                                   -->
    <!-- ------------------------------------------------------- -->
    <<if $room406_locked_out>>
        <div style="padding:10px; background:rgba(138,28,28,0.3); border:1px solid var(--accent-red); color:#ff6b6b; margin:10px 0;">
            ⛔ <b>PERMANENTLY LOCKED OUT.</b> The keypad triggered its security failsafe after three wrong attempts. The software is sealed. You will have to bypass it physically.
        </div>
        <br>
        <<chat "You" "image/avatars/player.gif" "left" "Damn it. It bricked itself. Time to do this the hard way.">>
        <br>

    <!-- ------------------------------------------------------- -->
    <!-- KEYPAD STATE: ACTIVE                                    -->
    <!-- ------------------------------------------------------- -->
    <<else>>
        <div style="margin-top:20px; padding:15px; background:rgba(0,0,0,0.3); border-left:3px solid var(--accent-blue);">
            <b style="color:var(--accent-blue);">⚙️ HOW DO YOU PROCEED?</b><br><br>

            <div class="choice-menu">

                <!-- SECRET LORE CHECK: HIDDEN PATH KEPT -->
                <<if visited("Prologue_Phone")>>
                    <button>
                        <<link "📱 Enter the code you saw on your phone — 8-4-4-5">>
                            <<set $room406_opened to true>>
                            <<goto "Unit_406">>
                        <</link>>
                        <span class="btn-sub">1 Minute | You saw it in a text thread. Didn't know what it was for at the time. Now you do.</span>
                    </button>
                <</if>>

                <!-- FAILED ATTEMPT WARNING -->
                <<if $failed_406_attempts > 0>>
                    <div style="padding:8px; background:rgba(138,28,28,0.2); border:1px solid #8a1c1c; color:#ff9999; margin-bottom:10px;">
                        ⚠️ <b>WRONG CODE.</b> Attempts remaining: <<print 3 - $failed_406_attempts>>. Three failures trigger the lockout permanently.
                    </div>
                <</if>>

                <!-- MANUAL ENTRY -->
                <<textbox "$player_code_attempt" "" autofocus>>
                <button>
                    <<link "🔢 Enter a code manually">>
                        <<if $player_code_attempt == "8445">>
                            <<set $room406_opened to true>>
                            <<goto "Unit_406">>
                        <<else>>
                            <<addTime 1>>
                            <<set $failed_406_attempts += 1>>
                            <<if $failed_406_attempts >= 3>>
                                <<set $room406_locked_out to true>>
                            <</if>>
                            <<goto "Unit_406">>
                        <</if>>
                    <</link>>
                    <span class="btn-sub">1 Minute | Four digits. Think carefully — you only get three attempts before the failsafe triggers.</span>
                </button>
            </div>
        </div>
    <</if>>


    <!-- ======================================================= -->
    <!-- HARDWARE BYPASS GRID (Always available)                 -->
    <!-- ======================================================= -->
    <div style="margin-top:20px; padding:15px; background:rgba(80,0,0,0.2); border-left:3px solid var(--accent-gold);">
        <b style="color:var(--accent-gold);">⚠️ HARDWARE BYPASS</b><br><br>

        <!-- FAILED BRUTE FORCE WARNING MESSAGE -->
        <<if $room406_bruteforce_fail>>
            <div style="padding:10px; background:rgba(138,28,28,0.3); border:1px solid var(--accent-red); color:#ff6b6b; margin-bottom:15px; text-align:center;">
                ❌ <b>BRUTE FORCE FAILED.</b> You battered the housing, but the internal deadbolt didn't budge. Your hands are bleeding, and you just wasted precious energy. 
            </div>
            <<unset $room406_bruteforce_fail>>
        <</if>>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;" class="choice-menu">

            <!-- 1. PLAYER JOB: BURGLAR -->
            <<if $job == "Burglar">>
                <button style="height: 100%;">
                    <<link "Override the electronic latch [BURGLAR]">>
                        <<addTime 2>><<exert _halfCost>><<set $room406_opened to true>><<goto "Unit_406">>
                    <</link>>
                    <span class="btn-sub"><b style="color:var(--accent-gold);">[JOB]</b> Cost: <<print _halfCost>> STAMINA (Halved). You've cracked tougher systems than this apartment lock.</span>
                </button>
            <<else>>
                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                    <span style="text-decoration: line-through;">Override the electronic latch</span><br>
                    <span class="btn-sub" style="color: #666;">[REQUIRES BURGLAR] You lack the specialized occupational knowledge to trick the locking mechanism.</span>
                </button>
            <</if>>

            <!-- 2. PLAYER TRAIT: LOCKSMITH -->
            <<if hasTrait("LOCKSMITH")>>
                <button style="height: 100%;">
                    <<link "Exploit the mechanical failsafe [LOCKSMITH]">>
                        <<addTime 3>><<exert _halfCost>><<set $room406_opened to true>><<goto "Unit_406">>
                    <</link>>
                    <span class="btn-sub"><b style="color:var(--accent-gold);">[TRAIT]</b> Cost: <<print _halfCost>> STAMINA (Halved). Every electronic lock has a physical override pin. You find it.</span>
                </button>
            <<else>>
                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                    <span style="text-decoration: line-through;">Exploit the failsafe</span><br>
                    <span class="btn-sub" style="color: #666;">[REQUIRES LOCKSMITH TRAIT] You don't know where the physical override pin is located.</span>
                </button>
            <</if>>

            <!-- 3. PLAYER SKILL: TECH 2 -->
            <<if $skills.tech >= 2>>
                <button style="height: 100%;">
                    <<link "Bypass the keypad circuit [TECH 2]">>
                        <<addTime 4>><<exert _halfCost>><<set $room406_opened to true>><<goto "Unit_406">>
                    <</link>>
                    <span class="btn-sub"><b style="color:var(--accent-gold);">[SKILL]</b> Cost: <<print _halfCost>> STAMINA (Halved). You pull the panel, find the latch relay wire, and bridge the circuit.</span>
                </button>
            <<else>>
                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                    <span style="text-decoration: line-through;">Bypass the keypad circuit</span><br>
                    <span class="btn-sub" style="color: #666;">[REQUIRES TECH 2] You lack the technical knowledge to safely hotwire the circuit board.</span>
                </button>
            <</if>>

            <!-- 4. PLAYER ITEM: MULTI-TOOL -->
            <<if $inventory.find(i => i.id === "Multi-Tool")>>
                <button style="height: 100%;">
                    <<link "Disassemble the housing [MULTI-TOOL]">>
                        <<addTime 3>><<exert _halfCost>><<set $room406_opened to true>><<goto "Unit_406">>
                    <</link>>
                    <span class="btn-sub"><b style="color:var(--accent-gold);">[ITEM]</b> Cost: <<print _halfCost>> STAMINA (Halved). You unscrew the faceplate and manually retract the deadbolt with pliers.</span>
                </button>
            <<else>>
                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                    <span style="text-decoration: line-through;">Disassemble the housing</span><br>
                    <span class="btn-sub" style="color: #666;">[REQUIRES MULTI-TOOL] You don't have a screwdriver or pliers to take the faceplate off.</span>
                </button>
            <</if>>

            <!-- 5. PLAYER ATTRIBUTE: PERCEPTION 60 -->
            <<if $per >= 60 and not $room406_locked_out>>
                <button style="height: 100%;">
                    <<link "Read the finger smudges [PER 60]">>
                        <<exert 0>><<set $room406_opened to true>><<goto "Unit_406">>
                    <</link>>
                    <span class="btn-sub"><b style="color:var(--accent-gold);">[ATTRIBUTE]</b> Cost: 0 STAMINA. The 8, 4, and 5 keys have heavy oil smudges. It only takes a second to guess the sequence.</span>
                </button>
            <<else>>
                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                    <span style="text-decoration: line-through;">Read the finger smudges</span><br>
                    <span class="btn-sub" style="color: #666;">[REQUIRES PER 60 AND ACTIVE KEYPAD] Your eyes aren't sharp enough to pick up the wear patterns on the keys.</span>
                </button>
            <</if>>

            <!-- 6. LAST RESORT: BRUTE FORCE (RNG) -->
            <button style="grid-column: span 2; border-left-color: var(--accent-red) !important;">
                <<link "Smash the keypad housing [BRUTE FORCE]">>
                    <<addTime 3>>
                    <<exert _baseCost>>
                    <!-- DYNAMIC RNG LOGIC -->
                    <<if $str >= 60>>
                        <<set $room406_opened to true>>
                    <<else>>
                        <<if random(1, 100) <= 70>>
                            <<set $room406_opened to true>>
                        <<else>>
                            <<set $room406_bruteforce_fail to true>>
                        <</if>>
                    <</if>>
                    <<goto "Unit_406">>
                <</link>>
                <span class="btn-sub">
                    <<if $str >= 60>>
                        <b style="color:var(--accent-red);">[LAST RESORT: 100% SUCCESS]</b> Cost: <<print _baseCost>> STAMINA. Your high Strength guarantees you can shatter the housing.
                    <<else>>
                        <b style="color:var(--accent-red);">[LAST RESORT: 70% SUCCESS CHANCE]</b> Cost: <<print _baseCost>> STAMINA. You batter the plastic housing, hoping the internal mechanism breaks free.
                    <</if>>
                    <br><i style="color:#ff9999;">(If you lack the Stamina, this will drain your HP).</i>
                </span>
            </button>

        </div>
    </div>

    <!-- RETREAT BUTTON -->
    <div class="choice-menu" style="margin-top:20px;">
        <button>
        <<link "🚪 Give up — return to the hallway">>
            <<unset $room406_bruteforce_fail>> <!-- Clears the fail flag if they leave -->
            <<run setup.sound.fade("ticking_clock", 1000)>>
            <<set $hallwaySection to 1>>
            <<goto "Hallway">>
        <</link>>
        <span class="btn-sub">Back to the corridor. Section 1.</span>
        </button>
    </div>


<!-- ======================================================= -->
<!-- PHASE 2: INSIDE THE STUDY (OPENED)                      -->
<!-- ======================================================= -->
<<else>>
    <h2>UNIT 406 — THE PROFESSOR'S STUDY</h2>

    The door swings open into darkness.

    The smell reaches you first. Old paper. Dust. Something faintly sweet — peppermint. The kind of smell that has been in a space for so long it has become the space itself.

    Every surface is covered in books. Floor-to-ceiling shelves on all four walls. Journals and monographs stacked three deep on the coffee table. Annotated syllabi pinned to a corkboard above the desk, beside a hand-drawn timeline that stretches across three taped-together sheets of graph paper.

    The Professor is not here.

    His reading glasses sit folded on an open book — *The Fall of Rome*, marked with a yellow sticky note:

    <div style="padding:10px; background:#0a0a0a; border:1px solid #333; font-family:'Courier Prime',monospace; color:#aaa; font-style:italic; margin:10px 0;">
    *"Every empire ends. We're just living in the intermission."*
    </div>

    <br>
    <<chat "You" "image/avatars/player.gif" "left" "He saw this coming from miles away. I just hope he had enough time to appreciate being right.">>
    <br>

    <!-- ------------------------------------------------------- -->
    <!-- STUDY ACTIONS & LOOTING                                 -->
    <!-- ------------------------------------------------------- -->
    <div style="margin-top:20px; padding:15px; background:rgba(0,0,0,0.3); border-left:3px solid var(--accent-blue);">
        <b style="color:var(--accent-blue);">📚 WHAT DO YOU DO?</b><br><br>

        <div class="choice-menu">

            <!-- ACTION: STUDY MECHANICS -->
            <<if not $studied_406_mechanics>>
                <button>
                    <<link "📖 Study 'Advanced Mechanics & Engineering' (30 minutes)">>
                        <<addTime 29>>
                        <<set $studied_406_mechanics to true>>
                        <<set $skills.tech += 1>>
                        <<goto "Unit_406">>
                    <</link>>
                    <span class="btn-sub">TECH +1. His annotations turn a textbook into a field guide. You learn more in thirty minutes than you expected to retain.</span>
                </button>
            <<else>>
                <div style="padding:6px; color:#555; font-style:italic; font-size:0.9em; margin-bottom:6px;">📖 You've already read the engineering text. The margins are full of his handwriting.</div>
            <</if>>

            <!-- ACTION: STUDY ANATOMY -->
            <<if not $studied_406_anatomy>>
                <button>
                    <<link "📖 Study 'Gray's Anatomy — Medical Edition' (30 minutes)">>
                        <<addTime 29>>
                        <<set $studied_406_anatomy to true>>
                        <<set $skills.medicine += 1>>
                        <<goto "Unit_406">>
                    <</link>>
                    <span class="btn-sub">MEDICINE +1. He flagged every relevant chapter. The man prepared for something. Maybe this, specifically.</span>
                </button>
            <<else>>
                <div style="padding:6px; color:#555; font-style:italic; font-size:0.9em; margin-bottom:6px;">📖 You've already read the anatomy text. You can feel the knowledge settling into you.</div>
            <</if>>

            <!-- ACTION: READ LORE JOURNAL -->
            <<if not $read_406_journal>>
                <button>
                    <<link "📓 Read the Professor's personal journal (10 minutes)">>
                        <<set $read_406_journal to true>>
                        <<set $per += 3>>
                        <<addTime 9>>
                        /* ADD TO LORE DATABASE */
                        <<run window.addLore("Professor Harmon's Journal", "His entries don't just track the virus—they track the cover-up. He documented unmarked FEMA transports at night, the CDC's blackout protocols, and the psychological breakdown of the public. His last entry reads: 'The state lies because panic moves faster than infection. But cognitive dissonance is the real plague. I watch my neighbors ignore the sirens, convinced the National Guard has it handled. We are actively choosing not to see the end.'")>>
                        <<goto "Unit_406">>
                    <</link>>
                    <span class="btn-sub">PERCEPTION +3. His entries don't just track the virus—they track the cover-up. He documented unmarked FEMA transports at night, the CDC's blackout protocols, and the psychological breakdown of the public. Reading it changes how you see the threat.</span>
                </button>
            <<else>>
                <div style="padding:6px; color:#555; font-style:italic; font-size:0.9em; margin-bottom:6px;">📓 The journal sits where you left it. His last entry: <i>"The state lies because panic moves faster than infection. But cognitive dissonance is the real plague. I watch my neighbors ignore the sirens, convinced the National Guard has it handled. We are actively choosing not to see the end."</i></div>
                <br>
                <<chat "You" "image/avatars/player.gif" "left" "They knew. FEMA, the CDC... they were covering it up while we were all just sitting in our living rooms.">>
                <br>
            <</if>>

            <!-- ACTION: LOOT KITCHEN -->
            <<if not $looted_406_kitchen>>
                <button>
                    <<link "🍵 Search the kitchen (3 minutes)">>
                        <<set $looted_406_kitchen to true>>
                        <<addTime 2>>
                        <<run setup.addItem("Canned Food", 1)>>
                        <<run setup.addItem("Energy Bar", 1)>>
                        /* WATER LOOT FOR FAILED RNG ATTEMPTS */
                        <<run setup.addItem("Bottled Water", 2)>>
                        <<goto "Unit_406">>
                    <</link>>
                    <span class="btn-sub">He kept his kitchen the same way he kept his study — methodical. A can of food, a wrapped energy bar, and two sealed bottles of water tucked beside the kettle.</span>
                </button>
            <</if>>

            <!-- ACTION: LOOT STUDY -->
            <<if not $looted_406>>
                <button>
                    <<link "🔍 Search the study thoroughly (5 minutes)">>
                        <<addTime 4>>
                        <<set $looted_406 to true>>
                        <<run setup.addItem("Encyclopedia", 1)>>
                        <<run setup.addItem("Flashlight", 1)>>
                        <<goto "Unit_406">>
                    <</link>>
                    <span class="btn-sub">An encyclopedia — heavy, but useful as reference or blunt force. And a flashlight in the desk drawer, fully charged, batteries new.</span>
                </button>
            <<else>>
                <div style="padding:6px; color:#555; font-style:italic; font-size:0.9em; margin-bottom:6px;">You've already searched the study. Nothing left but books and the ghost of peppermint tea.</div>
            <</if>>

            <!-- COMPLETION STATE -->
            <<if $studied_406_mechanics and $studied_406_anatomy and $read_406_journal and $looted_406_kitchen and $looted_406>>
                <br>
                <div style="padding:10px; background:rgba(0,100,0,0.2); border:1px solid var(--accent-green); font-style:italic; color:#99cc99;">
                    You've taken everything of value here — knowledge and supplies both. You hope he made it somewhere with good books.
                </div>
                <br>
                <<chat "You" "image/avatars/player.gif" "left" "Thanks, Professor. I'll put this to good use.">>
            <</if>>

            <br>
            <button>
                <<link "🚪 Leave and return to the hallway">>
                    <<run setup.sound.fade("ticking_clock", 1000)>>
                    <<set $hallwaySection to 1>>
                    <<goto "Hallway">>
                <</link>>
                <span class="btn-sub">Back to the corridor. Section 1.</span>
            </button>

        </div>
    </div>
<</if>>