:: Unit_401 {"position":"300,625","size":"100,100"}
<!-- ================================================================= -->
<!-- 1. INITIALIZATION & SETUP                                         -->
<!-- ================================================================= -->
<<nobr>>
    <<set $currentLocation to "401">>

    /* AUDIO: Muffled Pop Music Loop */
    <<if not $turned_off_music>>
        <<run setup.sound.play("party_music", "audio/sfx/bestsongeversample.mp3", true, 0.6)>>
    <</if>>

    /* Default Room Variables */
    <<if not $shelf_lifted>><<set $shelf_lifted to false>><</if>>
    <<if not $looted_401_alcohol>><<set $looted_401_alcohol to false>><</if>>
    <<if not $turned_off_music>><<set $turned_off_music to false>><</if>>
    <<if not $looted_401_kitchen>><<set $looted_401_kitchen to false>><</if>>
    <<if not $looted_401_pockets>><<set $looted_401_pockets to false>><</if>>
    <<if not $looted_401_bathroom>><<set $looted_401_bathroom to false>><</if>>

    /* Setup Physical Bypass Costs */
    <<set _baseCost to 20>>
    <<set _halfCost to Math.round(_baseCost / 2)>>
<</nobr>>

<<nobr>>
<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">

        <!-- ================================================================= -->
        <!-- PHASE 1: THE FALLEN SHELF (KEYS TRAPPED)                          -->
        <!-- ================================================================= -->
        <<if not $shelf_lifted>>
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                UNIT 401 - THE PARTY THAT ENDED
            </div>

            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                The door is wide open. The music hits you before the smell does. <i>"...and we danced all night to the best song ever..."</i>
                <br><br>
                Red solo cups are everywhere — crushed on the floor, stacked on the kitchen counter, floating in a punch bowl filled with something pink and congealed. The air is dense with stale beer and cheap cologne.
                <br><br>
                You follow the hallway to the living room. That's where you find him.
                <br><br>
                A massive oak entertainment center has toppled forward, catching a young, blond man across the chest and pinning him flat to the floor. The heavy wood must weigh at least three hundred pounds. His chest is not moving.
                <br><br>
                His right arm is outstretched. His fingers are still loosely curled around a set of car keys.
                <br><br>
                Looking at the deep scuff marks on the hardwood floor, it suddenly clicks. The rustling and heavy footsteps you heard from your room earlier... it was a stampede. When the panic started, everyone scrambled for the door. In the blind rush to escape, someone shoved the massive shelf, bringing it down on him as he was reaching for his keys. They left him behind.
                <br><br>
                Behind the wreckage, the speakers keep going. <i>"...danced all night to the best song ever..."</i>
            </div>

            <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
                
                <!-- WRAPPER UNTUK MENYEMBUNYIKAN MENU SAAT MINIGAME AKTIF -->
                <div id="room401-interactions">
                    <div style="margin-bottom:20px; padding:15px; background:rgba(0,0,0,0.3); border-left:3px solid var(--accent-gold);">
                        <b style="color:var(--accent-gold);">🪑 THE SHELF IS CRUSHING HIM. YOU NEED TO MOVE IT TO REACH THE KEYS.</b><br><br>

                        <!-- FAILED MINIGAME WARNING -->
                        <<if $room401_lift_fail>>
                            <div style="padding:10px; background:rgba(138,28,28,0.3); border:1px solid var(--accent-red); color:#ff6b6b; margin-bottom:15px; text-align:center;">
                                ❌ <b>LIFT FAILED.</b> The oak shelf slipped from your grip and slammed back down. You tore a muscle in your back and lost HP.
                            </div>
                            <<unset $room401_lift_fail>>
                        <</if>>

                        <!-- PHYSICAL BYPASS GRID (2 COLUMNS) -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">

                            <!-- 1. PLAYER JOB (CONSTRUCTION) -->
                            <<if $job == "Construction Worker">>
                                <button style="height: 100%;">
                                    <<link "Leverage weak points [CONSTRUCTION]">>
                                        <<addTime 1>><<exert _halfCost>><<set $shelf_lifted to true>><<run setup.addItem("Car Keys", 1)>>
                                        <<goto "Unit_401">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[JOB]</b> Cost: <<print _halfCost>> STAMINA. You know exactly where the center of mass is. You tilt it easily.</span>
                                </button>
                            <<else>>
                                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                    <span style="text-decoration: line-through;">Leverage weak points</span><br>
                                    <span class="btn-sub" style="color: #666;">[REQUIRES CONSTRUCTION WORKER] You lack the occupational knowledge to find the pivot point.</span>
                                </button>
                            <</if>>

                            <!-- 2. PLAYER TRAIT (BREACHER / IRON GRIP) -->
                            <<if hasTrait("BREACHER") or hasTrait("IRON GRIP")>>
                                <button style="height: 100%;">
                                    <<link "Lift it clean [TRAIT]">>
                                        <<addTime 1>><<exert _halfCost>><<set $shelf_lifted to true>><<run setup.addItem("Car Keys", 1)>>
                                        <<goto "Unit_401">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[BREACHER/IRON GRIP]</b> Cost: <<print _halfCost>> STAMINA. You lift it like it's cheap furniture.</span>
                                </button>
                            <<else>>
                                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                    <span style="text-decoration: line-through;">Lift it clean</span><br>
                                    <span class="btn-sub" style="color: #666;">[REQUIRES BREACHER/IRON GRIP] You don't have the specialized physical training to lift this safely.</span>
                                </button>
                            <</if>>

                            <!-- 3. PLAYER SKILL (TECH 2) -->
                            <<if $skills.tech >= 2>>
                                <button style="height: 100%;">
                                    <<link "Dismantle the joints [TECH 2]">>
                                        <<addTime 4>><<exert _halfCost>><<set $shelf_lifted to true>><<run setup.addItem("Car Keys", 1)>>
                                        <<goto "Unit_401">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[TECH 2]</b> Cost: <<print _halfCost>> STAMINA. You pop the hinges and break the shelf apart in pieces.</span>
                                </button>
                            <<else>>
                                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                    <span style="text-decoration: line-through;">Dismantle the joints</span><br>
                                    <span class="btn-sub" style="color: #666;">[REQUIRES TECH 2] You don't know how to break down this furniture without tools.</span>
                                </button>
                            <</if>>

                            <!-- 4. PLAYER ITEM (CROWBAR / TIRE IRON) -->
                            <<if $equip.weapon == "Crowbar" or $equip.weapon == "Tire Iron">>
                                <button style="height: 100%;">
                                    <<link "Pry it up with <<print $equip.weapon>>">>
                                        <<addTime 2>><<exert _halfCost>><<set $shelf_lifted to true>><<run setup.addItem("Car Keys", 1)>>
                                        <<goto "Unit_401">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[ITEM]</b> Cost: <<print _halfCost>> STAMINA. You wedge the steel under the frame and use it as a fulcrum.</span>
                                </button>
                            <<else>>
                                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                    <span style="text-decoration: line-through;">Pry it up with a tool</span><br>
                                    <span class="btn-sub" style="color: #666;">[REQUIRES PRYING TOOL] You don't have a crowbar or tire iron to create leverage.</span>
                                </button>
                            <</if>>

                            <!-- 5. LAST RESORT: BRUTE FORCE (MINIGAME SCALING) -->
                            <<if $str >= 6>>
                                <button style="grid-column: span 2; border-left-color: var(--accent-gold) !important;">
                                    <<link "Deadlift with raw strength [STR 6/6]">>
                                        <<addTime 1>><<exert _halfCost>><<set $shelf_lifted to true>><<run setup.addItem("Car Keys", 1)>>
                                        <<goto "Unit_401">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[STR <<print $str>>/6]</b> Cost: <<print _halfCost>> STAMINA. You plant your feet and muscle it upward. You are strong enough to do this cleanly.</span>
                                </button>
                            <<else>>
                                <button style="grid-column: span 2; border-left-color: var(--accent-red) !important;">
                                    <<link "Throw your entire body weight into it [MINIGAME]">>
                                        <<run $("#room401-interactions").hide(); $("#qte-wrapper-401").fadeIn(300);>>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-red);">[STR <<print $str>>/6]</b> Cost: <<print _baseCost>> STAMINA. You have no leverage and lack the raw strength. You will have to time your surge perfectly to avoid tearing a muscle.</span>
                                </button>
                            <</if>>

                        </div>
                    </div>

                    <hr style="border-color: #333; margin: 20px 0;">
                    <button style="background: rgba(255,255,255,0.05) !important; border-color: #555 !important;">
                        <<link "🚪 Leave — the keys aren't worth the injury">>
                            <<run setup.sound.stop("party_music")>>
                            <<set $hallwaySection to 4>>
                            <<goto "Hallway">>
                        <</link>>
                    </button>
                </div> <!-- END OF ROOM 401 INTERACTIONS -->

                <!-- PEMANGGILAN WIDGET MINIGAME UNTUK 401 (STRENGTH) -->
                <div id="qte-wrapper-401" style="display: none; padding-top: 15px;">
                    <!-- Kalkulasi Dinamis Berdasarkan Kekuatan (Target STR = 6) -->
                    <<set _statDiff to (6 - $str)>>
                    <<set _qteSpeed to 2.0 + (_statDiff * 0.8)>>
                    <<set _qteWidth to 30 - (_statDiff * 5)>>

                    <<Minigame_QTE _qteSpeed _qteWidth>>
                    
                    <span style="display:none;">
                        <span id="qte-win-trigger">
                            <<link "WIN">>
                                <<addTime 3>><<exert _baseCost>><<set $shelf_lifted to true>><<run setup.addItem("Car Keys", 1)>><<goto "Unit_401">>
                            <</link>>
                        </span>
                        <span id="qte-lose-trigger">
                            <<link "LOSE">>
                                <<set $hp -= 15>>
                                <<addTime 3>><<exert _baseCost>><<set $room401_lift_fail to true>><<goto "Unit_401">>
                            <</link>>
                        </span>
                    </span>
                </div>

            </div>

        <!-- ================================================================= -->
        <!-- PHASE 2: INSIDE THE APARTMENT (LOOTING)                           -->
        <!-- ================================================================= -->
        <<else>>
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                UNIT 401 - THE PARTY THAT ENDED
            </div>

            <!-- AI GENERATED IMAGE HERE -->
            <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
                <img src="image/unit401.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
            </div>

            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                The heavy oak shelf is off him.
                <br><br>
                You straighten up slowly, hands shaking, lower back screaming from the effort. The car keys are safely in your palm. You don't remember prying them from his stiff fingers. Your hands just did it on autopilot.
                <br><br>
                You look at his face once. Then you look away.
                <br><br>
                <<chat "You" "image/avatars/player.gif" "left" "'He's somebody's kid. I didn't know him. I'm not going to start crying for him now.'">>
                <br>
                The music keeps playing. 
                <br><br>
                <i>"...danced all night to the best song ever..."</i>
                <br><br>
                The same three seconds loop over and over from a scratched CD. The apartment smells like beer, grief, and the particular staleness of a party that ended in sheer terror. You are the only living thing left in here. The place is yours.
            </div>

            <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
                <div style="margin-bottom:20px; padding:15px; background:rgba(0,0,0,0.3); border-left:3px solid var(--accent-blue);">
                    <b style="color:var(--accent-blue);">🎵 THE APARTMENT IS YOURS. WHAT DO YOU DO?</b><br><br>

                    <!-- LOOT: KITCHEN -->
                    <<if not $looted_401_kitchen>>
                        <button>
                            <<link "🍕 Raid the kitchen (2 minutes)">>
                                <<set $looted_401_kitchen to true>>
                                <<addTime 1>>
                                <<run setup.addItem("Energy Bar", 2)>>
                                <<run setup.addItem("Bottled Water", 1)>>
                                <<goto "Unit_401">>
                            <</link>>
                            <span class="btn-sub">Two energy bars and a sealed water bottle shoved to the back of a cabinet. Party food. Not much — but unopened.</span>
                        </button>
                    <</if>>

                    <!-- LOOT: BATHROOM -->
                    <<if not $looted_401_bathroom>>
                        <button>
                            <<link "🪥 Check the medicine cabinet (2 minutes)">>
                                <<set $looted_401_bathroom to true>>
                                <<addTime 1>>
                                <<run setup.addItem("Painkillers", 2)>>
                                <<run setup.addItem("Bandage", 1)>>
                                <<goto "Unit_401">>
                            <</link>>
                            <span class="btn-sub">Painkillers and a bandage roll. Someone came to this party already hurting. Now you're taking their meds.</span>
                        </button>
                    <</if>>

                    <!-- LOOT: ALCOHOL -->
                    <<if not $looted_401_alcohol>>
                        <button>
                            <<link "🍺 Take the alcohol from the counter (2 minutes)">>
                                <<set $looted_401_alcohol to true>>
                                <<addTime 1>>
                                <<run setup.addItem("Bottle of Vodka", 1)>>
                                <<run setup.addItem("Whiskey", 1)>>
                                <<goto "Unit_401">>
                            <</link>>
                            <span class="btn-sub">Full bottles. Vodka for wounds, whiskey for everything else. Both make decent Molotov material.</span>
                        </button>
                    <</if>>

                    <!-- LOOT: POCKETS -->
                    <<if not $looted_401_pockets>>
                        <button>
                            <<link "🔍 Go through his jacket pockets (1 minute)">>
                                <<set $looted_401_pockets to true>>
                                <<run setup.addItem("Lighter", 1)>>
                                <<goto "Unit_401">>
                            <</link>>
                            <span class="btn-sub">A crumpled bill and a lighter. You leave the cash — money means nothing anymore. You take the lighter.</span>
                        </button>
                    <</if>>

                    <!-- ACTION: TURN OFF MUSIC -->
                    <<if not $turned_off_music>>
                        <button>
                            <<link "🔇 Turn off the music (1 minute)">>
                                <<run setup.sound.fade("party_music", 1000)>>
                                <<set $turned_off_music to true>>
                                <<goto "Unit_401">>
                            <</link>>
                            <span class="btn-sub"><b style="color:var(--accent-green);"></b> Turn off the music on this unit then the silence will replaces the noise.</span>
                        </button>
                    <<else>>
                        <div style="padding:8px; background:rgba(255,255,255,0.05); color:#888; font-style:italic; font-size:0.85em; margin-bottom:10px; text-align:center;">
                            🔇 The music is off. The silence in here is complete. It's worse.
                        </div>
                    <</if>>

                    <!-- EMPTY ROOM STATE -->
                    <<if $looted_401_kitchen and $looted_401_bathroom and $looted_401_alcohol and $looted_401_pockets and $turned_off_music>>
                        <div style="padding:15px; background:rgba(0,100,0,0.1); border-left:3px solid var(--accent-green); text-align:center; color:#99cc99; margin-bottom:20px;">
                            <i>There's nothing left here. Just the body, the dark, and the silence where the music used to be.</i>
                        </div>
                    <</if>>
                </div>

                <hr style="border-color: #333; margin: 20px 0;">
                <button style="background: rgba(255,255,255,0.05) !important; border-color: #555 !important;">
                    <<link "🚪 Leave the apartment and return to the hallway">>
                        <<run setup.sound.stop("party_music")>>
                        <<set $hallwaySection to 4>>
                        <<goto "Hallway">>
                    <</link>>
                </button>
            </div>
        <</if>>

    </div>
</div>
<</nobr>>