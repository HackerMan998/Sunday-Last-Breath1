:: Prologue_Hacking {"position":"300,400","size":"100,100"}
<<nobr>>
<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: center; align-items: center; max-height: 100vh !important; padding: 20px;">
        
        <div style="width: 100%; max-width: 650px; margin: 0 auto; background: #020202; border: 2px solid #333; border-top: 4px solid var(--accent-green); border-radius: 4px; box-shadow: 0 10px 30px rgba(0,255,0,0.1); overflow: hidden; position: relative;">
            
            <div style="background: #0a0a0a; padding: 8px 15px; display: flex; justify-content: space-between; font-family: 'Share Tech Mono', monospace; font-size: 0.8em; color: var(--accent-green); border-bottom: 1px solid #222;">
                <span>SYS_ADMIN - SECURE_NODE_04</span>
                <span class="glitch" style="color:var(--accent-red);">[ENCRYPTED]</span>
            </div>
            
            <div id="scramble-terminal" style="padding: 20px; font-family: 'Courier Prime', monospace; font-size: 0.9em; line-height: 1.6; color: #4af626; text-shadow: 0 0 5px rgba(74, 246, 38, 0.4); min-height: 250px;">
            </div>
            
        </div>

        <div id="terminal-finish" style="display:none; text-align:center; margin-top: 25px;">
            <div style="max-width: 600px; margin: 0 auto 20px auto; font-family: 'Courier Prime', monospace; color: #ccc; text-align: center;">
                <b style="color:var(--accent-red);">'SECTOR PURGE AT 0600 HOURS.'</b> The military isn't trying to contain the outbreak. They are going to wipe the entire city off the map at dawn. You need to leave. Right now.
                <br><br>
                But you got something else. A <b>Tier-1 Military Clearance Passkey</b> saved directly to your device. It won't help you fight your way out of this hallway, but if you survive this nightmare... it might be your only ticket into the national safe zones.
            </div>

            <div class="choice-menu" style="max-width: 400px; margin: 0 auto;">
                <button>
                    <<link "WIPE DRIVE & CLOSE LAPTOP">>
                        <<run window.addLore(
                            "DoD Intercept: Operation WILDFIRE", 
                            "The outbreak is uncontained. The military considers the city a lost cause and has ordered a 'Sector Purge' (firebombing) at 0600 hours. I managed to download a Tier-1 Military Clearance Passkey before severing the connection."
                        )>>
                        <<set $military_clearance_key to true>>
                        <<goto "Prologue">>
                    <</link>>
                    <span class="btn-sub">Save the Tier-1 Passkey to your PDA and log off.</span>
                </button>
            </div>
        </div>

    </div>
</div>
<</nobr>>

<<script>>
    setup.sound.play("static", "audio/sfx/static.mp3", true, 0.1);

    var hackingText = [
        "> BYPASSING 256-BIT AES ENCRYPTION...",
        "> ACCESSING SECURE MILITARY NODE...",
        "> DOWNLOADING CLASSIFIED DIRECTIVE: OPR_WILDFIRE",
        "------------------------------------------------",
        "THREAT LEVEL : CATEGORY 5 (EXTINCTION)",
        "PATHOGEN     : NEURO-AGGRESSIVE MUTAGEN (UNKNOWN ORIGIN)",
        "STATUS       : QUARANTINE FAILED. INFECTION RATE 87%.",
        "DIRECTIVE    : INITIATE SECTOR PURGE (FIREBOMBING) AT 0600 HOURS.",
        "------------------------------------------------",
        "> DOWNLOADING ATTACHMENT: EVAC_PROTOCOLS.DAT",
        "> EXTRACTION POINT 'ECHO' COORDINATES SECURED.",
        "> GENERATING TIER-1 MILITARY CLEARANCE PASSKEY...",
        "------------------------------------------------",
        "[!] WARNING: TRACE DETECTED. SEVERING CONNECTION."
    ];

    var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*<>";
    var lineIndex = 0;

    function scrambleLine() {
        var terminal = document.getElementById("scramble-terminal");
        if (!terminal) {
            setup.sound.stop("static");
            return;
        }

        if (lineIndex >= hackingText.length) {
            var finishBtn = document.getElementById("terminal-finish");
            if (finishBtn) finishBtn.style.display = "block";
            setup.sound.stop("static");
            return;
        }

        var originalText = hackingText[lineIndex];
        var lineDiv = document.createElement("div");
        
        if (originalText.includes("PURGE") || originalText.includes("[!]")) {
            lineDiv.style.color = "var(--accent-red)";
            lineDiv.style.textShadow = "0 0 5px rgba(255, 0, 0, 0.6)";
        } else if (originalText.includes("TIER-1")) {
            lineDiv.style.color = "var(--accent-gold)";
        }

        terminal.appendChild(lineDiv);

        var iterations = 0;
        var maxIterations = 20; 
        
        var interval = setInterval(function() {
            if (!document.getElementById("scramble-terminal")) {
                clearInterval(interval);
                return;
            }

            var currentText = "";
            for (var i = 0; i < originalText.length; i++) {
                if (i < (iterations / maxIterations) * originalText.length) {
                    currentText += originalText[i];
                } else {
                    if (originalText[i] === " ") {
                        currentText += " ";
                    } else {
                        currentText += chars[Math.floor(Math.random() * chars.length)];
                    }
                }
            }
            
            lineDiv.innerText = currentText;
            iterations++;

            if (iterations > maxIterations) {
                clearInterval(interval);
                lineDiv.innerText = originalText; 
                lineIndex++;
                setTimeout(scrambleLine, 400); 
            }
        }, 30); 
    }

    setTimeout(scrambleLine, 500);
<</script>>