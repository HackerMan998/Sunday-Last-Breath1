:: Act3_Arrival_Observe {"position":"550,1400","size":"100,100"}
<<nobr>>
/* =====================================================================
     ACT 3: ARRIVAL - OBSERVATION RESOLUTION
   ===================================================================== */

<<set $currentLocation to "Town_Outskirts">>

/* 1. TIME OF DAY CHECK */
<<set _arrivedLate to (visited("Act2_5_MarcusCabin"))>>

/* 2. COMPANION EXISTENCE CHECKS (FIXED: Independent Status Checks) */
<<set _hasVane to ($vane_status == "joined")>>
<<set _hasMaya to ($maya_status == "joined")>>
<<set _hasDiane to ($diane_status == "joined")>>
<</nobr>>

<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">

        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            THE OUTSKIRTS — OBSERVATION
        </div>

        /* --- VISUALS --- */
        <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
            <img src="image/Act3/crossroads_fog.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-gold); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            
            <span id="vn-text-obs">
                <<if _arrivedLate>>
                    You twist the key and the sedan's engine dies with a low, ticking sigh. The headlights flicker out, and the pale, freezing mist of morning presses against the glass. The heavy rain from the night has stopped, but the fog rolling off the pine canopy is thick, illuminated by a weak gray sun struggling to rise. 
                    <br><br>
                    Ten minutes pass in silence. In the cold light of day, you watch both structures carefully, picking apart the details.
                <<else>>
                    You twist the key and the sedan's engine dies with a low, ticking sigh. The headlights flicker out, plunging the car into the absolute blackness of 4:30 AM. The rain continues to beat a relentless, cold drum against the metal roof. You are running on nothing but empty fuel vapors and raw adrenaline.
                    <br><br>
                    Ten minutes pass in silence. In the dead of night, you wait for your eyes to fully adjust, studying the shadows.
                <</if>>

                <div class="choice-menu" style="margin-top:20px;">
                    <button style="border-left-color: var(--accent-gold) !important; background: rgba(255,255,255,0.05);">
                        <<link "Analyze the Structures ▼">>
                            <<run $(".vn-dialogue-box").scrollTop(0)>>
                            <<replace "#vn-text-obs">>
                                
                                <!-- TACTICAL OBSERVATION CARDS -->
                                <div class="crisis-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">

                                    <!-- SUBSTATION INTEL -->
                                    <div class="crisis-card" style="background: rgba(138,28,28,0.1); border: 1px solid #333; padding: 10px;">
                                        <img src="image/Act3/substation_exterior.gif" style="width: 100%; height: 120px; object-fit: cover; border: 1px solid #222; margin-bottom: 10px;">
                                        <b style="color:var(--accent-red); font-size:0.9em; display:block; text-align:center;">LEFT: SUBSTATION 4</b>
                                        <hr style="border-color:#222; margin: 8px 0;">
                                        <div style="font-size:0.85em; color:#bbb;">
                                            <<if _arrivedLate>>
                                                The dark mounds blocking the glass doors are bodies—stiff, cold, and covered in morning dew. The emergency red strobe is dead, and the backup generator is completely silent, having run out of fuel.
                                                <br><br>
                                                The east-side fence is wired shut from the <i>outside</i>. Because the generator is dead, the building is in total darkness and the digital security systems are entirely offline.
                                            <<else>>
                                                The dark mounds blocking the glass doors are bodies—freshly killed deputies and civilians. Through the dark, you hear the loud roar of an emergency generator powering a red strobe.
                                                <br><br>
                                                The east-side fence is wired shut from the <i>outside</i>. Because the power is active, the station's digital security systems are still online.
                                            <</if>>
                                        </div>
                                    </div>

                                    <!-- SUBURBAN HOME INTEL -->
                                    <div class="crisis-card" style="background: rgba(0,40,60,0.2); border: 1px solid #333; padding: 10px;">
                                        <<if _arrivedLate>>
                                            <img src="image/Act3/suburban_house_morning.gif" style="width: 100%; height: 120px; object-fit: cover; border: 1px solid #222; margin-bottom: 10px;">
                                        <<else>>
                                            <img src="image/Act3/suburban_house_night.gif" style="width: 100%; height: 120px; object-fit: cover; border: 1px solid #222; margin-bottom: 10px;">
                                        <</if>>
                                        <b style="color:var(--accent-blue); font-size:0.9em; display:block; text-align:center;">RIGHT: COLONIAL HOME</b>
                                        <hr style="border-color:#222; margin: 8px 0;">
                                        <div style="font-size:0.85em; color:#bbb;">
                                            <<if _arrivedLate>>
                                                The dark wool blanket pinned over the window looks highly conspicuous in the daylight. The candle has burned down to a dead wax stub.
                                                <br><br>
                                                A fresh bicycle track leads around toward the back garage. The occupant is likely exhausted after a long night of watching and may be asleep.
                                            <<else>>
                                                The blanket covering the window is pinned precisely to prevent light leaks, but a bright, warm amber candle glow escapes from the bottom edge.
                                                <br><br>
                                                A fresh bicycle track leads around toward the back garage. The occupant is awake, using a fresh candle, and likely hyper-vigilant in the dark.
                                            <</if>>
                                        </div>
                                    </div>
                                </div>

                                <div class="choice-menu">
                                    <button style="border-left-color: var(--accent-gold) !important; background: rgba(255,255,255,0.05);">
                                        <<link "Relay intel to the group ▼">>
                                            <<run $(".vn-dialogue-box").scrollTop(0)>>
                                            <<replace "#vn-text-obs">>

                                                You lean back from the windshield, relaying what your eyes picked up from the darkness.
                                                <br><br>

                                                <!-- COMPANION DIALOGUE SECTIONS (INDEPENDENT) -->
                                                <<if _hasVane>>
                                                    Vane pulls his jacket tighter around his slender shoulders, adjusting his glasses nervously.
                                                    <br><br>
                                                    <<if _arrivedLate>>
                                                        <<chat "Vane" "image/avatars/vane.gif" "right" "U-um... so the station is dead quiet. If the generator ran out of fuel, that means the digital keypads to their weapon lockers are dead too. We're going to have to smash our way in to get gear. That makes noise.">>
                                                    <<else>>
                                                        <<chat "Vane" "image/avatars/vane.gif" "right" "H-hear that hum? The station's generator is still running. If we can get past those bodies, we might be able to bypass their electronic locks and raid the armory cleanly while the systems are up.">>
                                                    <</if>>
                                                    <br>
                                                <</if>>

                                                <<if _hasMaya>>
                                                    From the backseat, Maya holds Lily tight against her chest. She looks at the colonial home, her expression purely pragmatical and deeply protective of her niece.
                                                    <br><br>
                                                    <<if _arrivedLate>>
                                                        <<chat "Maya" "image/avatars/maya.gif" "right" "The candle in the house is out. Whoever is living there has been awake all night; they're probably exhausted and sleeping right now. I'm not dragging a seven-year-old into a loud fight at a police station if we have a quiet option to clear that house.">>
                                                    <<else>>
                                                        <<chat "Maya" "image/avatars/maya.gif" "right" "Look at that fresh candle glow. Whoever is hiding in that house is awake, paranoid, and holding a gun at the door right now. I'm not risking Lily on a jumpy survivor in the pitch black.">>
                                                    <</if>>
                                                    <br>
                                                <</if>>

                                                <<if _hasDiane>>
                                                    Outside, Diane leans out from the window of her truck. The loss of Marcus has hardened her, and her primary focus remains the twin boys sleeping in her backseat.
                                                    <br><br>
                                                    <<if _arrivedLate>>
                                                        <<chat "Diane" "image/avatars/diane.gif" "right" "The morning is cold, and their candle is dead. If they're resting, we have the advantage. We should take the house quietly, for the kids' sake. We just need shelter.">>
                                                    <<else>>
                                                        <<chat "Diane" "image/avatars/diane.gif" "right" "That candle is bright. They're awake in the dark. It's a sanctuary, not a loot drop. If we go to the house, we need to approach with our hands up.">>
                                                    <</if>>
                                                    <br>
                                                <</if>>

                                                <<if ndef $companions or $companions.length === 0>>
                                                    You sit alone in the driver's seat, mapping the variables in your head. 
                                                    <br><br>
                                                    <<if _arrivedLate>>
                                                        The silent substation is a tomb—its generator dead, its digital locks frozen shut, requiring brute force. The colonial house is quiet; its candle has burned out, meaning the survivor inside may have finally succumbed to exhaustion and gone to sleep.
                                                    <<else>>
                                                        The roaring generator at the substation means the power is still active, keeping electronic systems alive if you can get past the fresh bodies. The colonial house's bright candle means someone is awake, paranoid, and waiting with a gun pointed at the door.
                                                    <</if>>
                                                    <br><br>
                                                <</if>>

                                                <!-- CHOICE MENU -->
                                                <div class="choice-menu" style="margin-top:25px;">
                                                    <!-- Option A: Sheriff Substation -->
                                                    <button>
                                                        <<link "Investigate the concrete substation to the left">>
                                                            <<addTime 5>>
                                                            <<set $act3_location to "sheriff">>
                                                            <<goto "Act3_Sheriff">>
                                                        <</link>>
                                                        <<if _arrivedLate>>
                                                            <span class="btn-sub">Approach the quiet yard. The generator is dead; electronic systems are offline, requiring physical force to clear path.</span>
                                                        <<else>>
                                                            <span class="btn-sub">Approach the active yard. The generator is loud; electronic systems are online and bypassable if you move fast.</span>
                                                        <</if>>
                                                    </button>

                                                    <!-- Option B: Suburban Home -->
                                                    <button>
                                                        <<link "Search the two-story home to the right">>
                                                            <<addTime 5>>
                                                            <<set $act3_location to "suburban_home">>
                                                            <<goto "Act3_Home">>
                                                        <</link>>
                                                        <<if _arrivedLate>>
                                                            <span class="btn-sub">Approach the colonial home. The candle is out; the occupant may be exhausted and sleeping, making stealth easier.</span>
                                                        <<else>>
                                                            <span class="btn-sub">Approach the colonial home. A fresh candle burns behind the blanket; the occupant is awake and highly alert in the dark.</span>
                                                        <</if>>
                                                    </button>
                                                </div>

                                            <</replace>>
                                        <</link>>
                                    </button>
                                </div>
                            <</replace>>
                        <</link>>
                    </button>
                </div>
            </span>
        </div>
    </div>
</div>