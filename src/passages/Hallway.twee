:: Hallway {"position":"150,500","size":"200,100"}
<<nobr>>
<<set $droneFile to "audio/bgm/hallway_drone.mp3">>

<<set $ambientSounds to[
    {file: "audio/sfx/distant_scream1.mp3", volume: 0.8},
    {file: "audio/sfx/distant_scream2.mp3", volume: 0.8},
    {file: "audio/sfx/distant_scream3.mp3", volume: 0.8},
    {file: "audio/sfx/door1.mp3", volume: 0.6},
    {file: "audio/sfx/door2.mp3", volume: 0.6},
    {file: "audio/sfx/door3.mp3", volume: 0.6},
    {file: "audio/sfx/doorclosed1.mp3", volume: 0.5},
    {file: "audio/sfx/doorclosed2.mp3", volume: 0.5},
    {file: "audio/sfx/doorclosed3.mp3", volume: 0.5},
    {file: "audio/sfx/steppedglass.mp3", volume: 0.4},
    {file: "audio/sfx/glass_break.mp3", volume: 0.9},
    {file: "audio/sfx/walking1.mp3", volume: 0.3},
    {file: "audio/sfx/walkingfast1.mp3", volume: 0.5},
    {file: "audio/sfx/walkingfast2.mp3", volume: 0.5},
    {file: "audio/sfx/waterdrip1.mp3", volume: 0.4},
    {file: "audio/sfx/waterdrip2.mp3", volume: 0.4},
    {file: "audio/sfx/zombiewalking1.mp3", volume: 0.6}
]>>

<<if not $hallwaySection>>
    <<set $hallwaySection to 1>>
<</if>>

<<set $currentLocation to "Hallway_" + $hallwaySection>>

<<script>>
setTimeout(function() {
    var sv = State.variables;
    var alreadyInHallway = sv.isInHallway === true;
    
    if (!alreadyInHallway) {
        if (setup.sound && setup.sound.tracks && setup.sound.tracks.atmosphere) {
            setup.sound.stop('atmosphere');
        }
        
        if (typeof Howler !== 'undefined') {
            Howler.unload();
        }
        
        if (setup && setup.sound && setup.sound.tracks) {
            setup.sound.tracks = {};
        }
        
        sv.isInHallway = true;
        
        setTimeout(function() {
            if (window.HallwayAmbience) {
                window.HallwayAmbience.start(sv.droneFile, sv.ambientSounds, true);
            }
        }, 500);
    }
}, 10);
<</script>>

<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">

        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            THE ASCOTT RESIDENCY - 4TH FLOOR
        </div>

        <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
            <<if $hallwaySection == 1>>
                <img src="image/hallway/hall_406_407.gif" style="width: 100%; height: auto; display: block; opacity: 0.85; filter: contrast(1.1) brightness(0.9);">
            <<elseif $hallwaySection == 2>>
                <img src="image/hallway/hall_404_405.gif" style="width: 100%; height: auto; display: block; opacity: 0.85; filter: contrast(1.1) brightness(0.9);">
            <<elseif $hallwaySection == 3>>
                <img src="image/hallway/hall_402_403.gif" style="width: 100%; height: auto; display: block; opacity: 0.85; filter: contrast(1.1) brightness(0.9);">
            <<elseif $hallwaySection == 4>>
                <img src="image/hallway/hall_end.gif" style="width: 100%; height: auto; display: block; opacity: 0.85; filter: contrast(1.1) brightness(0.9);">
            <</if>>
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            <<if $hallwaySection == 1>>
                The door to your apartment clicks shut behind you, sealing away the only safe place you have left. 
                <br><br>
                <span style="color:var(--accent-blue); font-weight:bold;">UPPER HALLWAY.</span> The emergency lights above are failing, casting long, twitching shadows across the cheap carpet. It's too quiet here, making every distant scream outside echo through the vents. To your right is your unit (407). To your left is <b>Unit 408</b>.
            
            <<elseif $hallwaySection == 2>>
                <span style="color:var(--accent-blue); font-weight:bold;">MID-HALLWAY.</span> Dust motes dance in the flickering light. You can hear a dog barking relentlessly from behind door 404, its claws scratching desperately against the wood. Across the hall, the reinforced door of <b>Unit 405</b> stands silent. The air here smells faintly of gunpowder.
            
            <<elseif $hallwaySection == 3>>
                <span style="color:var(--accent-blue); font-weight:bold;">LOWER HALLWAY.</span> The lights are completely dead in this section. The metallic, coppery tang of blood mixes with the smell of ozone. Jarringly, soft classical music plays from behind the chained door of <b>Unit 402</b>. Across from it is <b>Unit 403</b>.
            
            <<elseif $hallwaySection == 4>>
                <span style="color:var(--accent-blue); font-weight:bold;">HALLWAY END.</span> The corridor terminates at the heavy fire doors leading to the stairwell. Bloody handprints smear the glass viewing pane. From <b>Unit 401</b>, loud, obnoxious pop music thumps through the wood, completely masking the sounds of the nightmare happening outside.
            <</if>>
        </div>

        <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
            <<if $hallwaySection == 1>>
                <button>
                    <<link "INVESTIGATE UNIT 408">>
                        <<set $isInHallway to false>>
                        <<run window.HallwayAmbience.stop()>>
                        <<goto "Unit_408">>
                    <</link>>
                    <span class="btn-sub">The Professor's door. Electronic lock. Total silence inside.</span>
                </button>

            <<elseif $hallwaySection == 2>>
                <button>
                    <<link "INVESTIGATE UNIT 405">>
                        <<set $isInHallway to false>>
                        <<run window.HallwayAmbience.stop()>>
                        <<goto "Unit_405">>
                    <</link>>
                    <span class="btn-sub">The Hunter's door. Heavy steel frame. Faint smell of cordite.</span>
                </button>

            <<elseif $hallwaySection == 3>>
                <button>
                    <<link "INVESTIGATE UNIT 402">>
                        <<set $isInHallway to false>>
                        <<run window.HallwayAmbience.stop()>>
                        <<goto "Unit_402">>
                    <</link>>
                    <span class="btn-sub">The Andersons' door. Chained from the inside. Classical music playing.</span>
                </button>

            <<elseif $hallwaySection == 4>>
                <button>
                    <<link "INVESTIGATE UNIT 401">>
                        <<set $isInHallway to false>>
                        <<run window.HallwayAmbience.stop()>>
                        <<goto "Unit_401">>
                    <</link>>
                    <span class="btn-sub">The Party door. Slightly ajar. Music is loud enough to hide your footsteps.</span>
                </button>
                <button>
                    <<link "CHECK UTILITY CLOSET">>
                        <<set $isInHallway to false>>
                        <<run window.HallwayAmbience.stop()>>
                        <<goto "Utility_Closet">>
                    <</link>>
                        <span class="btn-sub">Maintenance room. The handle feels jammed.</span>
                </button>
                <button style="border-left-color: var(--accent-red) !important; margin-top: 15px;">
                    <<link "ENTER STAIRWELL (EXIT)">>
                        <<set $isInHallway to false>>
                        <<run window.HallwayAmbience.stop()>>
                        <<purgeCompleted>>
                        <<goto "Stairwell_Entrance">>
                    <</link>>
                    <span class="btn-sub" style="color:#ff9999;">Point of no return. Push through the bloody fire doors and head down.</span>
                </button>
            <</if>>

            <hr style="border-color: #333; margin: 20px 0;">
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:15px;">
                
                <<if $hallwaySection > 1>>
                    <button style="background: rgba(255,255,255,0.05) !important; border-color: #555 !important;">
                        <<link "▲ RETREAT UP THE HALL">>
                            <<set $hallwaySection -= 1>>
                            <<goto "Hallway">>
                        <</link>>
                    </button>
                <<else>>
                    <div style="opacity:0.3; border:1px solid #333; padding:10px; text-align:center; background: rgba(0,0,0,0.3); font-family: 'Oswald', sans-serif;">DEAD END</div>
                <</if>>

                <<if $hallwaySection < 4>>
                    <button style="background: rgba(255,255,255,0.05) !important; border-color: #555 !important;">
                        <<link "▼ ADVANCE DOWN THE HALL">>
                            <<set $hallwaySection += 1>>
                            <<goto "Hallway">>
                        <</link>>
                    </button>
                <<else>>
                    <div style="opacity:0.3; border:1px solid #333; padding:10px; text-align:center; background: rgba(0,0,0,0.3); font-family: 'Oswald', sans-serif;">STAIRWELL DOORS</div>
                <</if>>

            </div>
        </div> 

    </div>
</div>
<</nobr>>