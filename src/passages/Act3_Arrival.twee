:: Act3_Arrival {"position":"450,1400","size":"100,100"}
<<nobr>>
/* =====================================================================
     ACT 3: ARRIVAL — INITIALIZATION & STATE CHECK
     =====================================================================
*/
<<set $currentLocation to "Town_Outskirts">>
<<set $gameClockActive to true>>

<<completeObjective "reach_timberline">>
<<addObjective "find_intel" "Search the outskirts for intel on the sanctuary">>
<<purgeCompleted>>

/* Act 3 one-time state init */
<<if ndef $made_noise>>      <<set $made_noise to false>><</if>>
<<if ndef $stranger_trust>>  <<set $stranger_trust to "none">><</if>>
<<if ndef $companion_reyes>> <<set $companion_reyes to false>><</if>>
<<if ndef $act3_observed>>   <<set $act3_observed to false>><</if>>

/* 1. AUDIO TRANSITION */
<<run setup.sound.stopAll()>>
<<run setup.sound.play("outskirts_wind", "audio/bgm/outskirts_wind.mp3", true, 0.3)>>

/* 2. ARRIVAL TIME LOGIC */
<<if visited("Act2_5_MarcusCabin")>>
    <<set _arrivedLate to true>>
    <<set $gameDate.hour to 8>>
    <<set $gameDate.minute to 15>>
<<else>>
    <<set _arrivedLate to false>>
    <<set $gameDate.hour to 4>>
    <<set $gameDate.minute to 30>>
<</if>>

/* 3. MODULAR DIALOGUE PRE-PROCESSING */
<<set _hasVane to ($vane_status == "joined")>>
<<set _hasMaya to ($maya_status == "joined")>>
<<set _hasDiane to ($diane_status == "joined")>>
<</nobr>>

<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">

        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            ACT 3: TIMBERLINE OUTSKIRTS
        </div>

        /* --- VISUALS --- */
        <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
            <<if _arrivedLate>>
                <img src="image/Act3/outskirts_morning.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
            <<else>>
                <img src="image/Act3/outskirts_night.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
            <</if>>
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            
            <span id="vn-text-arrival">
                /* --- 1. ATMOSPHERIC ARRIVAL TEXT --- */
                <<if _arrivedLate>>
                    The sedan's engine idles in a low, sputtering rattle as you coast down the hill. A pale, freezing mist rises off the wet asphalt, lit by a weak gray morning sun struggling to pierce the thick canopy of pines. 
                    <br><br>
                    You slept a few hours at the cabin, but exhaustion still sits heavy in your joints. The air out here carries the smell of pine resin and dead leaves. Clean, compared to the smoke-choked city. But it is too quiet. The kind of quiet that means all the birds left.
                <<else>>
                    You have been driving on fumes for hours—steering through freezing rain until it died into a thick, suffocating fog. The road is pitch black, headlights cutting weak cones through mist that swallows landmarks whole. 
                    <br><br>
                    It is the dead of night. The cold, hollow hours before dawn when even your own breathing feels like a violation of the silence. Your eyes burn.
                <</if>>

                <div class="choice-menu" style="margin-top:20px;">
                    <button style="border-left-color: var(--accent-blue) !important; background: rgba(255,255,255,0.05);">
                        <<link "Next ▼">>
                            <<run $(".vn-dialogue-box").scrollTop(0)>>
                            <<replace "#vn-text-arrival">>
                                You bring the car to a crawl at a skewed intersection. A rusted metal signpost hangs from a bent post overhead, bullet-pocked and tilted from what might have been a vehicle impact days ago:

                                <div style="margin: 15px 0; padding: 10px 15px; border-left: 3px solid #555; background: rgba(0,0,0,0.4); font-family: 'Courier Prime', monospace; font-size: 0.9em; color: #aaa; letter-spacing: 1px; text-align:center;">
                                    <i>WELCOME TO TIMBERLINE — POP. 4,200</i>
                                </div>

                                The outskirts. Less dense than the concrete maze you fled, but the virus doesn't care about zip codes. The ditches are littered with abandoned cars, doors left wide open to the cold as if their owners simply stepped out and never came back.

                                <div class="choice-menu" style="margin-top:20px;">
                                    <button style="border-left-color: var(--accent-blue) !important; background: rgba(255,255,255,0.05);">
                                        <<link "Next ▼">>
                                            <<run $(".vn-dialogue-box").scrollTop(0)>>
                                            <<replace "#vn-text-arrival">>
                                                
                                                /* --- 2. THE STAKES (INDEPENDENT COMPANION CHECKS) --- */
                                                <<if _hasVane>>
                                                    Vane nervously taps the dashboard fuel gauge. The needle is buried entirely past the red line. <span style="color:var(--accent-blue);">"We're completely out of gas. Whatever we pick here, we're committing on foot if we're wrong."</span>
                                                    <br><br>
                                                <</if>>

                                                <<if _hasMaya>>
                                                    In the back of your sedan, Maya rubs her seven-year-old niece's arms. Lily's lips are pale from the dropping temperature. <span style="color:var(--accent-gold);">"Lily is freezing. We need to get inside somewhere. Just pick a safe door."</span>
                                                    <br><br>
                                                <</if>>

                                                <<if _hasDiane>>
                                                    Outside, Diane's pickup truck rolls to a stop alongside your sedan. She rolls down her rain-slicked window, glancing back at her sleeping twins in her backseat. <span style="color:var(--accent-gold);">"My boys need to get out of this cold. Pick a door, I'll follow your lead."</span>
                                                    <br><br>
                                                <</if>>

                                                <<if ndef $companions or $companions.length === 0>>
                                                    You tap the dashboard. The fuel gauge is dead. The silence inside the cabin is heavy and suffocating. You are completely alone, and whatever you choose here, you are committing to it on foot.
                                                    <br><br>
                                                <</if>>

                                                You cut the headlights. Through the fogged windshield, two structures emerge from the mist at the fork in the road.
                                                <br><br>
                                                To the <b>left</b>: a squat, reinforced concrete block of a building behind a chain-link fence. Barred windows. A heavy steel door. A rusted blue star emblem on the facade, too dirty to read from here. No lights visible. The front approach is partially blocked by what looks like a pile of dark debris.
                                                <br><br>
                                                To the <b>right</b>: an overgrown cul-de-sac winds into a dark suburban development. Prominent at the corner, a large two-story colonial home. In the mist, you can see one of the ground-floor windows has been covered from the inside with what appears to be a dark curtain or blanket. The front door is closed. The porch light is dead.
                                                <br><br>
                                                Two options. Very different silences. You need to decide.

                                                /* --- 3. CHOICE MENU --- */
                                                <div class="choice-menu" style="margin-top:25px;">

                                                    /* Option A: Sheriff Substation */
                                                    <button>
                                                        <<link "Investigate the concrete building to the left">>
                                                            <<addTime 15>>
                                                            <<set $act3_location to "sheriff">>
                                                            <<goto "Act3_Sheriff">>
                                                        <</link>>
                                                        <span class="btn-sub">The reinforced structure behind the fence. It looks like it was built to last.</span>
                                                    </button>

                                                    /* Option B: Suburban Home */
                                                    <button>
                                                        <<link "Search the two-story home to the right">>
                                                            <<addTime 15>>
                                                            <<set $act3_location to "suburban_home">>
                                                            <<goto "Act3_Home">>
                                                        <</link>>
                                                        <span class="btn-sub">The colonial house with the intact windows. Someone covered the ground floor from the inside.</span>
                                                    </button>

                                                    /* Option C: Observe First */
                                                    <<if $per >= 5 or hasTrait("NIGHT OWL") or hasTrait("TRACKER") or $skills.stealth >= 2>>
                                                        <button>
                                                            <<link "Kill the engine and observe both locations first">>
                                                                <<addTime 10>>
                                                                <<set $act3_observed to true>>
                                                                <<goto "Act3_Arrival_Observe">>
                                                            <</link>>
                                                            <span class="btn-sub"><b style="color:var(--accent-gold);">[PER 5 / STEALTH 2 / TRACKER]</b> 10 Minutes. Spend time tracking and reading the environment for hidden tactical details before committing.</span>
                                                        </button>
                                                    <<else>>
                                                        <button disabled style="opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                                            <span style="text-decoration: line-through;">Observe from a distance first</span><br>
                                                            <span class="btn-sub" style="color: #666;">[REQUIRES PER 5 / STEALTH 2 / TRACKER] You lack the trained eye to read the environment for hidden clues before moving.</span>
                                                        </button>
                                                    <</if>>

                                                </div>

                                            <</replace>>
                                        <</link>>
                                    </button>
                                </div>
                            <</replace>>
                        <</link>>
                    </button>
                </div>
            </span>
        </div>
    </div>
</div>