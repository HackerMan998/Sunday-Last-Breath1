:: Utility_Closet {"position":"400,650","size":"100,100"}
<!-- ======================================================= -->
<!-- INITIALIZATION & SETUP                                  -->
<!-- ======================================================= -->
<<nobr>>
    /* AUDIO: Fluorescent hum and dripping water */
    <<run setup.sound.play("utility_hum", "audio/sfx/neon_flicker_buzz.mp3", true, 0.4)>>

    <<set $currentLocation to "utility">>
    
    /* Variable Defaults (Matching engines.js) */
    <<if not $utility_opened>><<set $utility_opened to false>><</if>>
    <<if not $read_utility_log>><<set $read_utility_log to false>><</if>>
    <<if not $looted_utility_flashlight>><<set $looted_utility_flashlight to false>><</if>>
    <<if not $looted_utility_bleach>><<set $looted_utility_bleach to false>><</if>>
    <<if not $looted_utility_gloves>><<set $looted_utility_gloves to false>><</if>>
    <<if not $looted_utility_tape>><<set $looted_utility_tape to false>><</if>>
    <<if not $looted_utility_rope>><<set $looted_utility_rope to false>><</if>>
    <<if not $looted_utility_batteries>><<set $looted_utility_batteries to false>><</if>>

    /* Setup Physical Bypass Costs */
    <<set _baseCost to 15>>
    <<set _halfCost to Math.round(_baseCost / 2)>>
<</nobr>>

<<nobr>>
<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">

        <!-- ======================================================= -->
        <!-- PHASE 1: EXTERIOR (THE STEEL DOOR)                      -->
        <!-- ======================================================= -->
        <<if not $utility_opened>>
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                4TH FLOOR - UTILITY ROOM
            </div>

            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                At the end of the residential corridor, the carpet transitions to bare concrete. Ahead is a heavy, industrial steel door. Fading yellow paint stenciled across the front reads: <b>MAINTENANCE - AUTHORIZED PERSONNEL ONLY</b>.
                <br><br>
                The door is sealed tight. Unlike the wooden apartment doors, this one has a reinforced steel frame and a heavy-duty magnetic swipe lock. A faint, sickening smell of industrial bleach and raw copper seeps out from the gap underneath.
                <br><br>
                Through the thick metal, you hear the erratic buzz of a failing fluorescent light.
                <br><br>
                <<chat "You" "image/avatars/player.gif" "left" "Janitor's closet. If anyone had tools or master keys to this building, it would be in there.">>
            </div>

            <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
                
                <div id="utility-interactions">
                    <div style="margin-bottom:20px; padding:15px; background:rgba(0,0,0,0.3); border-left:3px solid var(--accent-gold);">
                        <b style="color:var(--accent-gold);">🔧 THE STEEL DOOR IS LOCKED. HOW DO YOU GET IN?</b><br><br>

                        <!-- FAILED BRUTE FORCE WARNING MESSAGE -->
                        <<if $utility_bruteforce_fail>>
                            <div style="padding:10px; background:rgba(138,28,28,0.3); border:1px solid var(--accent-red); color:#ff6b6b; margin-bottom:15px; text-align:center;">
                                ❌ <b>BRUTE FORCE FAILED.</b> You threw your weight against the heavy steel, but the magnetic lock didn't flinch. Your shoulder is bruised.
                            </div>
                            <<unset $utility_bruteforce_fail>>
                        <</if>>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">

                            <!-- 1. PLAYER JOB: BURGLAR -->
                            <<if $job == "Burglar">>
                                <button style="height: 100%;">
                                    <<link "Pick the manual override cylinder">>
                                        <<addTime 2>><<exert _halfCost>><<set $utility_opened to true>><<goto "Utility_Closet">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[BURGLAR]</b> Cost: <<print _halfCost>> STAMINA. The card reader has a hidden physical cylinder underneath. You pick it clean.</span>
                                </button>
                            <<else>>
                                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                    <span style="text-decoration: line-through;">Pick the override cylinder</span><br>
                                    <span class="btn-sub" style="color: #666;">[REQUIRES BURGLAR] You lack the specialized knowledge to bypass industrial locks.</span>
                                </button>
                            <</if>>

                            <!-- 2. PLAYER SKILL: TECH 2 -->
                            <<if $skills.tech >= 2>>
                                <button style="height: 100%;">
                                    <<link "Hotwire the magnetic reader">>
                                        <<addTime 3>><<exert _halfCost>><<set $utility_opened to true>><<goto "Utility_Closet">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[TECH 2]</b> Cost: <<print _halfCost>> STAMINA. You pop the faceplate off the reader and short the mag-lock circuit.</span>
                                </button>
                            <<else>>
                                <button disabled style="height: 100%; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                    <span style="text-decoration: line-through;">Hotwire the magnetic reader</span><br>
                                    <span class="btn-sub" style="color: #666;">[REQUIRES TECH 2] You don't know how to bypass an active magnetic lock system.</span>
                                </button>
                            <</if>>

                            <!-- 3. PLAYER ITEM: CROWBAR / TIRE IRON -->
                            <<if $equip.weapon == "Crowbar" or $equip.weapon == "Tire Iron">>
                                <button style="height: 100%; grid-column: span 2;">
                                    <<link "Pry the steel door with <<print $equip.weapon>>">>
                                        <<addTime 2>><<exert _halfCost>><<set $utility_opened to true>><<goto "Utility_Closet">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[ITEM: <<print $equip.weapon>>]</b> Cost: <<print _halfCost>> STAMINA. You wedge the heavy steel tool into the gap and use raw leverage to break the magnet's hold.</span>
                                </button>
                            <<else>>
                                <button disabled style="height: 100%; grid-column: span 2; opacity: 0.4; cursor: not-allowed; border-color: #333;">
                                    <span style="text-decoration: line-through;">Pry the steel door</span><br>
                                    <span class="btn-sub" style="color: #666;">[REQUIRES CROWBAR OR TIRE IRON] You cannot pry a commercial steel door with your bare hands or small tools.</span>
                                </button>
                            <</if>>

                            <!-- 4. LAST RESORT: BRUTE FORCE (MINIGAME SCALING) -->
                            <<if $str >= 7>>
                                <button style="grid-column: span 2; border-left-color: var(--accent-gold) !important;">
                                    <<link "Shoulder ram the steel door [STR 7/7]">>
                                        <<addTime 1>><<exert _baseCost>><<set $utility_opened to true>><<goto "Utility_Closet">>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-gold);">[STR <<print $str>>/7]</b> Cost: <<print _baseCost>> STAMINA. Your immense strength is enough to violently break the magnetic seal.</span>
                                </button>
                            <<else>>
                                <button style="grid-column: span 2; border-left-color: var(--accent-red) !important;">
                                    <<link "Shoulder ram the steel door [MINIGAME]">>
                                        <<run $("#utility-interactions").hide(); $("#qte-wrapper-utility").fadeIn(300);>>
                                    <</link>>
                                    <span class="btn-sub"><b style="color:var(--accent-red);">[STR <<print $str>>/7]</b> Cost: <<print _baseCost>> STAMINA. You aren't strong enough to just push it open. You'll have to time a massive, full-body slam perfectly.</span>
                                </button>
                            <</if>>

                        </div>
                    </div>

                    <hr style="border-color: #333; margin: 20px 0;">
                    <button style="background: rgba(255,255,255,0.05) !important; border-color: #555 !important;">
                        <<link "🚪 Step back into the hallway">>
                            <<unset $utility_bruteforce_fail>>
                            <<run setup.sound.fade("utility_hum", 1000)>>
                            /* Update hallwaySection target based on your map layout */
                            <<set $hallwaySection to 4>> 
                            <<goto "Hallway">>
                        <</link>>
                    </button>
                </div>

                <!-- PEMANGGILAN WIDGET MINIGAME UNTUK UTILITY (STRENGTH) -->
                <div id="qte-wrapper-utility" style="display: none; padding-top: 15px;">
                    <!-- Target STR = 7 (This is a heavy industrial door) -->
                    <<set _statDiff to (7 - $str)>>
                    <<set _qteSpeed to 2.2 + (_statDiff * 0.9)>>
                    <<set _qteWidth to 25 - (_statDiff * 4)>>

                    <<Minigame_QTE _qteSpeed _qteWidth>>
                    
                    <span style="display:none;">
                        <span id="qte-win-trigger">
                            <<link "WIN">>
                                <<addTime 3>><<exert _baseCost>><<set $utility_opened to true>><<goto "Utility_Closet">>
                            <</link>>
                        </span>
                        <span id="qte-lose-trigger">
                            <<link "LOSE">>
                                <<set $hp -= 10>>
                                <<addTime 3>><<exert _baseCost>><<set $utility_bruteforce_fail to true>><<goto "Utility_Closet">>
                            <</link>>
                        </span>
                    </span>
                </div>

            </div>

        <!-- ======================================================= -->
        <!-- PHASE 2: INSIDE THE UTILITY ROOM                        -->
        <!-- ======================================================= -->
        <<else>>
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                4TH FLOOR - UTILITY ROOM
            </div>

            <!-- AI GENERATED IMAGE HERE -->
            <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
                <img src="image/act1/utility_room.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
            </div>

            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                The heavy door gives way.
                <br><br>
                The air inside is thick and stinging, saturated with the harsh, chemical smell of industrial bleach. A single, failing fluorescent tube flickers on the ceiling, casting chaotic, strobe-like shadows across bare concrete walls.
                <br><br>
                Heavy metal racks line the perimeter, packed with maintenance supplies: plastic jugs of chemicals, extension cords, and rusted tools. In the center of the room, a yellow mop bucket is tipped over, a puddle of soapy water mixing with a dark, dried smear leading toward the back corner.
                <br><br>
                A small metal desk sits tucked against the far wall, buried under schematics and a logbook.
                <br><br>
                It is quiet in here. Just the electric hum of the light above.
            </div>

            <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
                <div style="margin-bottom:20px; padding:15px; background:rgba(0,0,0,0.3); border-left:3px solid var(--accent-blue);">
                    <b style="color:var(--accent-blue);">🛠️ SEARCH THE ROOM</b><br><br>

                    <!-- ACTION: READ LORE LOG -->
                    <<if not $read_utility_log>>
                        <button>
                            <<link "📓 Read the maintenance logbook (2 minutes)">>
                                <<set $read_utility_log to true>>
                                <<set $per += 1>>
                                <<addTime 2>>
                                <<run window.addLore("Maintenance Log - 4th Floor", "The final entry is rushed and erratic. 'Tenants in 402 complaining about a chemical smell again. Told them I'm not a maid. Feeling feverish today. My joints are burning. Taking some aspirin from the kit and locking myself in here to sleep it off until shift ends.'")>>
                                <<goto "Utility_Closet">>
                            <</link>>
                            <span class="btn-sub"><b style="color:var(--accent-green);">[PER +1]</b> The last entry is disturbing. He locked himself in here because he was feeling feverish. He never clocked out.</span>
                        </button>
                    <<else>>
                        <div style="padding:8px; background:rgba(255,255,255,0.05); color:#888; font-style:italic; font-size:0.85em; margin-bottom:10px; text-align:center;">
                            📓 You've already read the log. The janitor turned while locked inside this room.
                        </div>
                    <</if>>

                    <!-- ACTION: LOOT THE CART (BLEACH & GLOVES) -->
                    <<if not $looted_utility_bleach and not $looted_utility_gloves>>
                        <button>
                            <<link "🧽 Search the tipped cleaning cart (2 minutes)">>
                                <<set $looted_utility_bleach to true>>
                                <<set $looted_utility_gloves to true>>
                                <<addTime 2>>
                                <<run setup.addItem("Bleach", 1)>>
                                <<run setup.addItem("Rubber Gloves", 1)>>
                                <<goto "Utility_Closet">>
                            <</link>>
                            <span class="btn-sub">The cart is a mess, but you manage to salvage an unopened jug of industrial Bleach and a pair of thick Rubber Gloves.</span>
                        </button>
                    <</if>>

                    <!-- ACTION: LOOT THE SHELVES (TAPE & ROPE) -->
                    <<if not $looted_utility_tape and not $looted_utility_rope>>
                        <button>
                            <<link "🧰 Scavenge the metal shelves (3 minutes)">>
                                <<set $looted_utility_tape to true>>
                                <<set $looted_utility_rope to true>>
                                <<addTime 3>>
                                <<run setup.addItem("Duct Tape", 1)>>
                                <<run setup.addItem("Rope", 1)>>
                                <<goto "Utility_Closet">>
                            <</link>>
                            <span class="btn-sub">You clear out the useful hardware. A heavy roll of Duct Tape and a bundle of strong nylon Rope. Essential survival gear.</span>
                        </button>
                    <</if>>

                    <!-- ACTION: LOOT THE DESK (FLASHLIGHT & BATTERIES) -->
                    <<if not $looted_utility_flashlight and not $looted_utility_batteries>>
                        <button>
                            <<link "🔦 Check the drawers of the metal desk (2 minutes)">>
                                <<set $looted_utility_flashlight to true>>
                                <<set $looted_utility_batteries to true>>
                                <<addTime 2>>
                                <<run setup.addItem("Flashlight", 1)>>
                                <<run setup.addItem("Batteries", 2)>>
                                <<goto "Utility_Closet">>
                            <</link>>
                            <span class="btn-sub">Tucked beneath a pile of blueprints, you find a heavy-duty Flashlight and two spare Batteries.</span>
                        </button>
                    <</if>>

                    <!-- COMPLETION STATE -->
                    <<if $read_utility_log and $looted_utility_bleach and $looted_utility_tape and $looted_utility_flashlight>>
                        <div style="padding:15px; background:rgba(0,100,0,0.1); border-left:3px solid var(--accent-green); text-align:center; color:#99cc99; margin-bottom:20px;">
                            <i>You have stripped the maintenance room of everything useful. Your bag is heavier, but you are far better equipped for what lies ahead.</i>
                        </div>
                    <</if>>
                </div>

                <hr style="border-color: #333; margin: 20px 0;">
                <button style="background: rgba(255,255,255,0.05) !important; border-color: #555 !important;">
                    <<link "🚪 Return to the hallway">>
                        <<run setup.sound.fade("utility_hum", 1000)>>
                        <<set $hallwaySection to 4>>
                        <<goto "Hallway">>
                    <</link>>
                </button>
            </div>
        <</if>>

    </div>
</div>
<</nobr>>