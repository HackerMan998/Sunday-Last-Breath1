:: StoryInit {"position":"0,0","size":"100,100"}
/*  
    =================================================================
    STORYINIT: THE CORE ENGINE DATABASE
    Sunday's Last Breath - Twine Survival Horror
    =================================================================
*/

/* -----------------------------------------------------------------
   1. PLAYER IDENTITY & PROGRESSION
   ----------------------------------------------------------------- */
<<set $firstName to "???">>
<<set $lastName to "???">>
<<set $name to "???">>
<<set $gender to "???">>
<<set $job to "???">>

<<set $level to 1>>
<<set $xp to 0>>
<<set $xp_req to 100>>
<<set $chapter to 0>>

/* Control flag: Set to false in the Prologue to enable hunger/thirst decay */
<<set $inCharCreation to true>>


/* -----------------------------------------------------------------
   2. VITALS (0 - 100 SCALE)
   ----------------------------------------------------------------- */
<<set $hp to 100>> 
<<set $hp_max to 100>>

<<set $stamina to 100>> 
<<set $base_stamina_max to 100>> 
<<set $stamina_max to 100>>

<<set $hunger to 100>>  /* 100 = Full, 0 = Starving */
<<set $thirst to 100>>  /* 100 = Hydrated, 0 = Dehydrated */
<<set $hum to 50>>      /* 0 = Monster, 100 = Saint */


/* -----------------------------------------------------------------
   3. ATTRIBUTES (1 - 10 SCALE)
   ----------------------------------------------------------------- */
<<set $str to 3>>
<<set $int to 3>>
<<set $agi to 3>>
<<set $cha to 3>>
<<set $per to 3>>

/* Customization points for the 'Student' class on a 1-10 scale */
<<set $studentPoints to 5>> 


/* -----------------------------------------------------------------
   4. SKILLS (Proficiency Levels)
   ----------------------------------------------------------------- */
<<set $skills to {
    shooting: 0,
    melee: 0,
    stealth: 0,
    tech: 0,
    medicine: 0,
    scavenging: 0
}>>


/* -----------------------------------------------------------------
   5. TRAITS & LORE LOGIC
   ----------------------------------------------------------------- */
<<set $traits to []>>
<<set $acquiredTraits to []>>
<<set $loreDatabase to []>>   /* Stores unlocked flavor text and logs */
<<set $hobbyStep to 1>>        /* Track progress through hobby selection */
<<set $pickedHobbies to []>>   /* Prevents picking the same hobby twice */


/* -----------------------------------------------------------------
   6. INVENTORY & EQUIPMENT SYSTEM
   ----------------------------------------------------------------- */
<<set $inventory to []>>
<<set $bag_limit to 12>>

<<set $equip to {
    head: "none",
    body: "none",
    pants: "none",
    boots: "none",
    weapon: "none"
}>>

/* Tracks items dropped in specific passages */
<<set $floorItems to {}>> 


/* -----------------------------------------------------------------
   7. WORLD TIME & CLOCK
   ----------------------------------------------------------------- */
<<set $gameDate to {
    dayName: "SATURDAY",
    month: "OCT",
    date: 25,
    year: 2025,
    hour: 23,
    minute: 45,
    dayCount: 0
}>>

<<set setup.days to ["SATURDAY", "SUNDAY", "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"]>>
<<set $gameClockActive to false>>


