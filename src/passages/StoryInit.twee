/* -----------------------------------------------------------------
   10. ENGINE FUNCTIONS (JAVASCRIPT HELPERS)
   ----------------------------------------------------------------- */

/* --- ADD ITEM (WITH SPILLOVER LOGIC) --- */
<<set setup.addItem = function(id, qty = 1, fromFloor = false) {
    if (!setup.items[id]) return false;
    
    var targetList = State.variables.inventory;
    var stack = setup.items[id].stack;
    
    /* 1. Try to stack in bag */
    if (stack) {
        let found = targetList.find(i => i.id === id);
        if (found) { 
            found.qty += qty; 
            return true; 
        }
    }
    
    /* 2. Check for empty slots */
    if (targetList.length < State.variables.bag_limit) {
        targetList.push({ id: id, qty: qty });
        return true;
    }
    
    /* 3. Spillover (Bag is full) */
    if (fromFloor) {
        return false;
    } else {
        var currentPassage = passage();
        if (!State.variables.floorItems) {
            State.variables.floorItems = {};
        }
        if (!State.variables.floorItems[currentPassage]) {
            State.variables.floorItems[currentPassage] = [];
        }
        
        var roomLoot = State.variables.floorItems[currentPassage];
        
        if (stack) {
            let floorStack = roomLoot.find(i => i.id === id);
            if (floorStack) {
                floorStack.qty += qty;
                alert("Inventory Full! The " + id + " fell to the floor.");
                return true;
            }
        }
        
        roomLoot.push({ id: id, qty: qty });
        alert("Inventory Full! The " + id + " fell to the floor.");
        return true; 
    }
}>>

/* --- REMOVE ITEM --- */
<<set setup.removeItem = function(id) {
    var index = State.variables.inventory.findIndex(i => i.id === id);
    if (index > -1) {
        State.variables.inventory.splice(index, 1);
    }
}>>


/* -----------------------------------------------------------------
   11. INITIAL MAP CONFIGURATION
   ----------------------------------------------------------------- */
<<set $activeTab to "main">>
<<set $currentLocation to "407">>
<<set $activeMap to "4th Floor">>
<<set $hallwaySection to 1>>

/* Map Special Element: Exclamation Indicator */
<<set $exclaim to "<span style='font-size:2em; color:white;'>!</span>">>



/* Safe-house flags */
<<set $inSafehouse to false>>
<<set $safehouseTrust to 0>>

/* -----------------------------------------------------------------
 9. ACTIVE OBJECTIVES SYSTEM
 ----------------------------------------------------------------- */
<<set $objectives to [
    { id: "pack_gear", desc: "Gather your starter gear from the table", status: "active" },
    { id: "leave_apt", desc: "Leave your apartment and head outside", status: "locked" }
]>>