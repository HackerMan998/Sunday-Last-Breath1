:: Act3_School_DeptOffices {"position":"700,1900","size":"100,100"}
<<nobr>>
<<set $currentLocation to "dept_offices">>
<<set $activeMap to "Highschool 1st Floor">>
<<set _arrivedLate to (visited("Act2_5_MarcusCabin"))>>
<</nobr>>

<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">
        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            1ST FLOOR — DEPARTMENT OFFICES
        </div>

        <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
            <<if _arrivedLate>>
                <img src="image/Act3_Timberline/faculty_morning.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
            <<else>>
                <img src="image/Act3_Timberline/faculty_night.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
            <</if>>
        </div>

        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            <span id="vn-dept-main">
                The school's faculty offices have been hastily converted into an operations room and off-duty barracks for the volunteer militia. 
                <br><br>
                Desks once piled with lesson plans and exam papers are now cluttered with radio chargers, half-eaten ration bars, and ammunition crates. The large whiteboard on the wall still shows last week's school calendar, now scrawled over in dry-erase marker with patrol sectors and guard rosters.
                <br><br>
                <<if _arrivedLate>>
                    Pale morning light cuts through the dusty Venetian blinds. Several sentries are sprawled across folding cots or slumped over desks in full tactical gear, catching fitful sleep after holding the school perimeter through the night. A pot of bitter coffee sits cold in the corner.
                <<else>>
                    The office is dim, illuminated only by red emergency glow-sticks and the dull blue light of tactical monitors. Two sentries sit in silence at the corner desks, field-stripping their rifles and checking magazine springs. Every creak in the hallway puts them on edge.
                <</if>>
            </span>
        </div>

        <div class="choice-menu">
            <button style="border-left-color: var(--accent-blue) !important;">
                <<link "🚪 Exit Department Offices to Hallway [NORTH]">>
                    <<set $currentLocation to "hall_1_east_1">>
                    <<goto "Act3_School1Floor">>
                <</link>>
                <span class="btn-sub">Return to the East Hallway corridor.</span>
            </button>
        </div>
    </div>
</div>
