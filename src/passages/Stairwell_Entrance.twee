:: Stairwell_Entrance {"position":"200,700","size":"100,100"}
<<completeObjective "escape_building">> /* Finishes old escape task */
<<purgeCompleted>>
/* =================================================================
   PASSAGE: STAIRWELL ENTRANCE
   Player decides how to navigate down the dark emergency stairs.
================================================================= */

<<nobr>>
    /* ─── 1. MAP & LOCATION SETUP ─── */
    /* Swap the UI map to the 4F segment and place the player pin */
    <<set $activeMap to "Stairwell 4F">>
    <<set $currentLocation to "F4 Entrance">>
<</nobr>>


/* ─── 2. SCENE AUDIO ─── */
<<script>>
    /* Transition from the 4th floor to the stairwell */
    if (setup.sound.tracks["atmosphere"]) setup.sound.fade("atmosphere", 2000);

    /* Play heavy door slam immediately upon entering */
    setup.sound.play("firedoor_slam", "audio/sfx/firedoor_slam.mp3", false, 0.8);

    /* Start the ambient generator hum (looping) */
    setup.sound.play("generator_hum", "audio/sfx/generator_hum.mp3", true, 0.4);
<</script>>


<!-- ======================================================= -->
<!-- 3. NARRATIVE TEXT & ATMOSPHERE                          -->
<!-- ======================================================= -->

<center>
    <h1 style="color:var(--accent-red);">STAIRWELL DESCENT</h1>
</center>

The heavy fire door slams shut behind you, sealing off the 4th floor. 

The stairwell is bathed in the pulsing, dim red glow of emergency backup lights. It’s hard to see the bottom of the steps. The silence here is heavy, broken only by the distant, vibrating hum of a generator. 

You need to get down to the ground floor. 


<!-- ======================================================= -->
<!-- 4. PLAYER DECISION: DESCENT METHOD                      -->
<!-- ======================================================= -->

<div style="margin-top:20px; padding:15px; background:rgba(0,0,0,0.3); border-left:3px solid var(--accent-blue);">
    <b style="color:var(--accent-blue);">⚙️ HOW DO YOU DESCEND?</b><br><br>

    <<nobr>>
        /* ─── CHECK INVENTORY FOR DYNAMIC OPTIONS ─── */
        <<set _hasFlashlight to $inventory.find(i => i.id === "Flashlight")>>
        <<set _hasLighter to $inventory.find(i => i.id === "Lighter")>>
    <</nobr>>

    <div class="choice-menu">
        
        <!-- OPTION 1: QUICK DESCENT (Always Available) -->
        <button>
            <<link "🏃 Move Quickly (2 minutes)">>
                <<run setup.sound.play("boots_run", "audio/sfx/boots_run_concrete.mp3", false, 0.8)>>
                <<set $descentMethod to "quick">>
                <<addTime 1>>
                <<goto "Stairwell_Landing">>
            <</link>>
            <span class="btn-sub"><b style="color:var(--accent-gold);">[AGI CHECK]</b> Get down as fast as possible. You risk slipping in the dark.</span>
        </button>

        <!-- OPTION 2: SLOW DESCENT (Always Available) -->
        <button>
            <<link "🚶 Move Slowly and Carefully (10 minutes)">>
                <<run setup.sound.play("boots_slow", "audio/sfx/boots_slow_concrete.mp3", false, 0.6)>>
                <<set $descentMethod to "slow">>
                <<addTime 9>>
                <<goto "Stairwell_Landing">>
            <</link>>
            <span class="btn-sub"><b style="color:var(--accent-green);">[SAFE]</b> Take it step by step. Uses much more time, but guarantees you won't fall.</span>
        </button>

        <!-- OPTION 3: FLASHLIGHT DESCENT -->
        <<if _hasFlashlight>>
            <button>
                <<link "🔦 Use your Flashlight (4 minutes)">>
                    <<run setup.sound.play("flashlight", "audio/sfx/flashlight_click.mp3", false, 0.8)>>
                    <<set $descentMethod to "flashlight">>
                    <<addTime 3>>
                    <<goto "Stairwell_Landing">>
                <</link>>
                <span class="btn-sub"><b style="color:var(--accent-gold);">[GEAR]</b> Illuminates the path perfectly. Fast and safe.</span>
            </button>
        <</if>>

        <!-- OPTION 4: LIGHTER DESCENT -->
        <<if _hasLighter>>
            <button>
                <<link "🔥 Use your Lighter (6 minutes)">>
                    <<run setup.sound.play("lighter", "audio/sfx/lighter_flick.mp3", false, 0.8)>>
                    <<set $descentMethod to "lighter">>
                    <<addTime 5>>
                    <<goto "Stairwell_Landing">>
                <</link>>
                <span class="btn-sub"><b style="color:var(--accent-gold);">[GEAR]</b> A flickering flame. Better than nothing, but forces you to move somewhat slowly.</span>
            </button>
        <</if>>

        <!-- FALLBACK: NO LIGHT SOURCE (Diegetic Hint) -->
        <<if not _hasFlashlight and not _hasLighter>>
            <button disabled style="opacity: 0.4; cursor: not-allowed; border-color: #333;">
                <span style="text-decoration: line-through;">💡 Illuminate the stairwell</span><br>
                <span class="btn-sub" style="color: #666;">[REQUIRES LIGHT SOURCE] It's too dark to see the steps clearly. You don't have a flashlight or a lighter to cut through the gloom.</span>
            </button>
        <</if>>

    </div> <!-- End of Choice Menu -->
</div> <!-- End of Interaction Box -->