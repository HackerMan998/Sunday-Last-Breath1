:: Act3_7Eleven_RescueSuccess {"position":"750,2150","size":"100,100"}
<<nobr>>
<<if ndef $firstName or $firstName == "???">>
    <<set $firstName to "Neal">>
<</if>>
<<set $currentLocation to "headmaster_office">>
<<set $inSafehouse to true>>
<<set $activeMap to "Highschool 1st Floor">>
<<set _arrivedLate to (visited("Act2_5_MarcusCabin"))>>
<</nobr>>

<h2>1ST FLOOR — COMMAND OFFICE VICTORIOUS RETURN</h2>
/* DYNAMIC LEADER CONFIGURATION */
<<set _leaderName to "Commander Hayes">>
<<set _leaderAvatar to "image/avatars/leader_default_hayes.gif">>
<<set _leaderRef to "Commander Hayes">>

<div style="margin-bottom: 15px; text-align: center;">
    <img src="image/Act3_Timberline/headmaster.gif" style="max-width: 100%; border: 1px solid #333;">
</div>
<<if $anchor == "partner_f">>
    <<set _leaderName to $anchor_name>>
    <<set _leaderAvatar to "image/avatars/leader_f.gif">>
    <<set _leaderRef to "your girlfriend, " + $anchor_name>>
<<elseif $anchor == "partner_m">>
    <<set _leaderName to $anchor_name>>
    <<set _leaderAvatar to "image/avatars/leader_m.gif">>
    <<set _leaderRef to "your boyfriend, " + $anchor_name>>
<<elseif $anchor == "partner_nb">>
    <<set _leaderName to $anchor_name>>
    <<set _leaderAvatar to "image/avatars/leader_nb.gif">>
    <<set _leaderRef to "your partner, " + $anchor_name>>
<<elseif $anchor == "parents">>
    <<set _leaderName to "Dad">>
    <<set _leaderAvatar to "image/avatars/leader_dad.gif">>
    <<set _leaderRef to "your father">>
<</if>>

You, Reyes, and Commander Miller enter the 1st Floor Command Office.
<br><br>
Matriarch Evelyn gasps in relief, rushing around the mahogany desk to check Miller's bandaged shoulder.
<br><br>
<<chat "Matriarch Evelyn" "image/avatars/matriarch_evelyn.gif" "right" "Thank God you made it back! We brought the fuel truck into the courtyard locker room.">>
/* CLEARANCE FLAGS */
<<set $senior_council_clearance to true>>
<<set $leader_rescued to true>>
<</nobr>>

<br><br>
<<chat "Commander Miller" "image/avatars/quartermaster_sgtvance.gif" "right" "It's all thanks to this one right here. Stood shoulder to shoulder with Reyes and pulled us out of a death trap.">>
<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">
        <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
            1ST FLOOR — COMMAND OFFICE VICTORIOUS RETURN
        </div>

<br><br>
Miller turns to you, placing a heavy hand on your shoulder.
<br><br>
<<chat "Commander Miller" "image/avatars/quartermaster_sgtvance.gif" "right" "You're no longer just a refugee in Timberline High. As of today, you are a full member of our Senior Defense Council. Full clearance across all wings of the sanctuary.">>
        <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
            <img src="image/Act3_Timberline/headmaster.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
        </div>

<br><br>
<div style="padding:15px; background:rgba(0,100,0,0.25); border:1px solid var(--accent-green); text-align:center;">
    <b style="color:var(--accent-green); font-size:1.3em;">🏆 SENIOR COUNCIL CLEARANCE UNLOCKED</b>
    <br>
    <span style="color:#aaa;">You now have full access to all military reserves, radio feeds, and perimeter defenses in Timberline.</span>
</div>
        <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-green); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
            <span id="vn-711-success-main">
                You, Reyes, and <<print _leaderName>> climb the wide interior staircase and step through the double oak doors of the Command Office.
                <br><br>
                Outside the windows, guards cheer as the diesel fuel truck rolls through the reinforced bus barricades. Inside, the overwhelming tension in the air breaks in an instant.
                <br><br>
                <<if $anchor == "parents">>
                    Matriarch Evelyn gasps, clutching her chest before running straight around the heavy mahogany desk. Tears stream down her face as she throws her arms around your father, burying her face into his shoulder.
                    <br><br>
                    <<chat "Mom (Evelyn)" "image/avatars/matriarch_evelyn.gif" "right" "Thank God... almighty God... you're both back! You're both alive!">>
                    <br><br>
                    Your father gently holds her, then reaches an arm out and pulls you firmly into the embrace.
                    <br><br>
                    <<chat "Dad" "image/avatars/leader_dad.gif" "right" "It's all thanks to our kid, Evelyn. $firstName stood shoulder to shoulder with Reyes, cut through that ambush, and pulled me out of a death trap.">>
                    <br><br>
                    <<chat "Mom (Evelyn)" "image/avatars/matriarch_evelyn.gif" "right" "I always believed you would find us, $firstName. Against everything that took the world... our family survived together.">>
                <<elseif $anchor == "partner_f" or $anchor == "partner_m" or $anchor == "partner_nb">>
                    Matriarch Evelyn looks up from the radio receiver with profound relief in her eyes as you enter together.
                    <br><br>
                    <<print _leaderName>> drops the heavy shotgun onto the briefing table, turning to you with eyes full of emotion before pulling you into a fierce, breathless embrace.
                    <br><br>
                    <<chat _leaderName _leaderAvatar "right" "When the bullets were chewing through the glass and that cooler was shaking... all I kept telling myself was that I had to hold on because you were looking for me. Thank you for saving my life, $firstName.">>
                    <br><br>
                    Evelyn watches you two with a gentle, approving nod.
                    <br><br>
                    <<chat "Matriarch Evelyn" "image/avatars/matriarch_evelyn.gif" "right" "I haven't seen <<print _leaderName>> smile like that since the world ended. You two have something rare and unbreakable—and Timberline High is honored to have you here.">>
                <<else>>
                    Matriarch Evelyn gasps in relief, rushing around the mahogany desk to inspect Commander Hayes's bandaged arm.
                    <br><br>
                    <<chat "Matriarch Evelyn" "image/avatars/matriarch_evelyn.gif" "right" "Thank God you made it back! The generator crew already has the diesel connected to the boiler room.">>
                    <br><br>
                    <<chat "Commander Hayes" "image/avatars/leader_default_hayes.gif" "right" "It's all thanks to $firstName right here. Stood shoulder to shoulder with Reyes and pulled us out of an absolute slaughterhouse.">>
                <</if>>
                <br><br>
                <<print _leaderName>> turns squarely toward you, extending a firm hand in salute.
                <br><br>
                <<chat _leaderName _leaderAvatar "right" "You're no longer just a newcomer seeking shelter behind our walls. As of this moment, you hold full Senior Defense Council clearance. Timberline High School is your home, and every door is open to you.">>
                <br><br>
                <div style="padding: 16px; background: rgba(0, 100, 0, 0.3); border: 2px solid var(--accent-green); border-radius: 6px; text-align: center;">
                    <b style="color: var(--accent-green); font-size: 1.25em; letter-spacing: 1px;">🏆 SENIOR COUNCIL CLEARANCE UNLOCKED</b>
                    <br>
                    <span style="color: #ccc; font-size: 0.9em;">You now hold unconditional access to all military reserves, armories, and secure wings of Timberline Sanctuary.</span>
                </div>
            </span>
        </div>

<br><br>
<div class="choice-menu">
    <button style="border-left-color: var(--accent-blue) !important;">
        <<link "🏫 Return to the Safehouse Corridor" "Act3_SchoolGFloor">>
            <<set $currentLocation to "hall_g_center">>
        <</link>>
        <span class="btn-sub">Explore the fully unlocked Timberline Sanctuary.</span>
    </button>
        <div class="choice-menu">
            <button style="border-left-color: var(--accent-blue) !important; background: rgba(0, 50, 100, 0.25);">
                <<link "🏢 Step out to 1st Floor Upper Hallway [NORTH]">>
                    <<run $(".vn-dialogue-box").scrollTop(0)>>
                    <<set $currentLocation to "hall_1_center">>
                    <<goto "Act3_School1Floor">>
                <</link>>
                <span class="btn-sub">Visit the upper laboratories, server room, and department offices.</span>
            </button>

            <button style="border-left-color: var(--accent-gold) !important; background: rgba(100, 75, 0, 0.25);">
                <<link "🏫 Descend to Ground Floor Main Corridor [SOUTH]">>
                    <<run $(".vn-dialogue-box").scrollTop(0)>>
                    <<set $currentLocation to "hall_g_center">>
                    <<goto "Act3_SchoolGFloor">>
                <</link>>
                <span class="btn-sub">Visit the Canteen, Infirmary, Locker Rooms, and Main Foyer.</span>
            </button>
        </div>
    </div>
</div>
