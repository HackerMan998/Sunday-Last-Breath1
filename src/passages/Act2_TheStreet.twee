:: Act2_TheStreet {"position":"500,800","size":"100,100"}
/* =======================================================================
   SYSTEM INITIALIZATION
======================================================================= */
/* Clear the map when leaving the building */
<<set $activeMap to undefined>>

<<nobr>>
    /* INIT PHASE & AUDIO ONLY ONCE */
    <<if ndef $street_phase>>
        <<set $street_phase to 1>>
        <<script>>
            /* Stop the lobby drone/ambience to ensure a clean slate */
            if (typeof window.HallwayAmbience !== 'undefined') window.HallwayAmbience.stop();
            setup.sound.stopAll(); 
            
            /* Play the heavy city riot track immediately on load */
            setup.sound.play("city_riot", "audio/bgm/city_riot_heavy.mp3", true, 0.8);
        <</script>>
    <</if>>
<</nobr>>

<div class="vn-container">
    <div class="vn-dialogue-box" style="justify-content: flex-start; align-items: center; max-height: 100vh !important; padding: 20px; overflow-y: auto;">

        <!-- ══════════════════════════════════════════════════════════════════════════
           SCENE 1: THE STREETS
           ══════════════════════════════════════════════════════════════════════════ -->
        <<if $street_phase == 1>>
            
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                THE STREETS
            </div>

            <!-- IMAGE 1: THE MOB -->
            <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid #333; overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.8);">
                <img src="image/Act2Street/themob.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
            </div>
            
            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-red); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                
                <span id="vn-text-street">
                    The cold air hits you the moment you push through the lobby doors, but it offers no relief. The street is a warzone.
                    <br><br>
                    A tide of human panic surges down the avenue. You don't even get a chance to pick a direction before the crowd hits you. It is a wave of pure, blind terror—elbows, shoulders, the overwhelming stench of sweat, exhaust, and blood. You are shoved violently, your boots sliding on asphalt slick with things you don't want to look at.
                    
                    <div class="choice-menu" style="margin-top:20px;">
                        <button style="border-left-color: var(--accent-red) !important; background: rgba(138,28,28,0.2);">
                            <<link "Next ▼">>
                                <<run window.shakeScreen(20)>>
                                <<replace "#vn-text-street">>
                                    You fight against the brutal current, throwing your weight sideways until you tear yourself out of the crush, stumbling into a narrow, shadowed alleyway between two high-rises. You lean against a brick wall, your lungs burning.
                                    <br><br>
                                    
                                    /* --- COMPANION CHECK: VANE --- */
                                    <<if $vane_status == "joined">>
                                        <span style="color:var(--accent-blue);">Vane</span> tumbles into the alley right behind you, slamming his heavy camera case against the brick wall. His designer jacket is torn, and his perfectly styled hair is plastered to his forehead with sweat and rain.
                                        <br><br>
                                        He bends over, hands on his knees, panting hard. He's bleeding from a scrape on his cheek, but his dark eyes are wide and sharply focused. He gasps, looking back at the stampede.
                                        <br><br>
                                        <<chat "Vane" "image/avatars/vane.gif" "right" "Okay... okay. Not exactly the VIP exit I'm used to.">>
                                        <br>
                                        He tries to joke, but his voice shakes. He looks at you, his facade dropping completely.
                                        <br><br>
                                        <<chat "Vane" "image/avatars/vane.gif" "right" "This whole city is a death trap. My followers always said I was dramatic about crowds, but this is insane. We can't stay here.">>
                                    <</if>>

                                    /* --- COMPANION CHECK: MAYA --- */
                                    <<if $maya_status == "joined">>
                                        <<if $vane_status == "joined">><br><br><</if>>
                                        <span style="color:var(--accent-gold);">Maya</span> staggers into the alleyway right after you, her arms wrapped fiercely around Lily. She presses the little girl's face into her coat, shielding her from the horrors on the street. 
                                        <br><br>
                                        <<chat "Maya" "image/avatars/maya.gif" "right" "I've got you, baby. Auntie Maya's got you. Just don't look back there.">>
                                        <br>
                                        She looks up at you, her chest heaving. The weight of her dead sister's promise is written all over her exhausted face.
                                        <br><br>
                                        <<chat "Maya" "image/avatars/maya.gif" "right" "We need to get off the streets. Now. If that crowd shifts into this alley, we'll be trampled.">>
                                    <</if>>

                                    <<if $vane_status != "joined" and $maya_status != "joined">>
                                        The apartment building was a tomb, but the city is a slaughterhouse. You need to leave. Tonight.
                                    <</if>>

                                    <div class="choice-menu" style="margin-top:20px;">
                                        <button>
                                            <<link "Catch your breath">>
                                                <<completeObjective "survive_streets">>
                                                <<addObjective "explore_alley" "Find a way out of the alleyway">>
                                                <<purgeCompleted>>
                                                
                                                /* --- AUDIO TRANSITION --- */
                                                <<run setup.sound.crossfade("city_riot", "alley_riot", "audio/bgm/alley_muffled_riot.mp3", 2000, 0.6)>>
                                                
                                                /* --- PLAY THE JUMPSCARE SOUNDS --- */
                                                <<run setup.sound.play("screech", "audio/sfx/falling_screech_doppler.mp3", false, 0.8)>>
                                                <<run setTimeout(function() { 
                                                    setup.sound.play("crunch", "audio/sfx/meat_asphalt_crunch.mp3", false, 1.0); 
                                                    setup.sound.play("tearing", "audio/sfx/frenzied_tearing.mp3", true, 0.7); 
                                                }, 800)>>

                                                <<set $street_phase to "alley_jumpscare">>
                                                <<goto "Act2_TheStreet">>
                                            <</link>>
                                            <span class="btn-sub">Step deeper into the alleyway.</span>
                                        </button>
                                    </div>
                                <</replace>>
                            <</link>>
                        </button>
                    </div>
                </span>
            </div>


        <!-- ══════════════════════════════════════════════════════════════════════════
           SCENE 2: THE ALLEYWAY JUMPSCARE
           ══════════════════════════════════════════════════════════════════════════ -->
        <<elseif $street_phase == "alley_jumpscare">>
            
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                THE ALLEYWAY
            </div>

            <!-- IMAGE 2: THE JUMPSCARE -->
            <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid var(--accent-red); overflow: hidden; position: relative; box-shadow: 0 0 15px rgba(138,28,28,0.4);">
                <img src="image/Act2Street/alley_jumpscare.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
            </div>
            
            <<run window.shakeScreen(30)>>

            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-red); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                
                <span id="vn-text-alley">
                    You take one deep breath. You don't get a second.
                    <br><br>
                    A screech echoes from above. Before you can even look up, a heavy mass plummets from a fire escape three stories overhead. 
                    <br><br>
                    It hits the pavement with a wet, sickening <i>CRUNCH</i> of asphalt and bone, completely flattening a civilian who had been running blindly down the alley. 

                    <div class="choice-menu" style="margin-top:20px;">
                        <button style="border-left-color: var(--accent-red) !important; background: rgba(138,28,28,0.2);">
                            <<link "Next ▼">>
                                <<replace "#vn-text-alley">>
                                    The thing that fell doesn't stay down. 
                                    <br><br>
                                    Its legs are shattered, bent at impossible angles, but it drags itself up by its arms with terrifying speed and immediately sinks its jagged teeth into the screaming civilian's neck. Blood sprays across the brick wall.
                                    
                                    <<if $maya_status == "joined">>
                                        <br><br>
                                        Maya shoves Lily behind her, turning the little girl's face into her coat so she can't see the carnage. Maya's eyes meet yours in absolute horror.
                                    <</if>>

                                    <div class="choice-menu" style="margin-top:20px;">
                                        <!-- OPTION A: KILL IT -->
                                        <button style="border-left-color: var(--accent-red) !important;">
                                            <<link "Kill it! [COMBAT]">>
                                                <<run setup.sound.stop("tearing")>>
                                                <<run setup.sound.play("crush", "audio/sfx/skull_crush_heavy.mp3", false, 1.0)>>
                                                <<set $street_phase to "alley_kill">>
                                                <<goto "Act2_TheStreet">>
                                            <</link>>
                                            <span class="btn-sub"><b style="color:var(--accent-red);">[COMBAT]</b> Silence it before it finishes feeding.</span>
                                        </button>
                                        
                                        <!-- OPTION B: FLEE -->
                                        <button style="border-left-color: var(--accent-gold) !important;">
                                            <<link "Run the other way [FLEE]">>
                                                <<completeObjective "explore_alley">>
                                                <<addObjective "getaway_vehicle" "Find a way to start the blue sedan">>
                                                <<purgeCompleted>>
                                                
                                                <<run setup.sound.stop("tearing")>>
                                                <<run setup.sound.play("chainlink", "audio/sfx/chainlink_crash.mp3", false, 0.9)>>
                                                <<set $hum -= 5>>
                                                <<set $street_phase to "alley_flee">>
                                                <<goto "Act2_TheStreet">>
                                            <</link>>
                                            <span class="btn-sub"><b style="color:var(--accent-gold);">[FLEE]</b> Bypass the carnage and run deeper into the alley.</span>
                                        </button>
                                    </div>
                                <</replace>>
                            <</link>>
                        </button>
                    </div>
                </span>
            </div>


        <!-- ══════════════════════════════════════════════════════════════════════════
           SCENE 3: ALLEY RESOLUTION
           ══════════════════════════════════════════════════════════════════════════ -->
        <<elseif $street_phase == "alley_kill">>
            
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                THE ALLEYWAY - RESOLUTION
            </div>

            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-red); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                You don't hesitate. Your weapon comes down hard, crushing the infected's skull before it can fully tear the man's throat out. It goes limp. 
                <br><br>
                The civilian underneath is gurgling, eyes rolling back. He is already gone.
                <br><br>
                <<if $vane_status == "joined">>
                    Vane looks away, swallowing hard, gripping his camera case like a lifeline. 
                <</if>>
                You step over them and push deeper into the alley, emerging out the other side.
            </div>

            <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
                <button>
                    <<link "Step out into the parking lot">>
                        <<completeObjective "explore_alley">>
                        <<addObjective "getaway_vehicle" "Find a way to start the blue sedan">>
                        <<purgeCompleted>>
                        <<run setup.sound.fade("alley_riot", 2000)>>
                        <<run setup.sound.play("parking_ambience", "audio/bgm/parking_lot_wind.mp3", true, 0.5)>>
                        <<set $street_phase to "parking_lot">>
                        <<goto "Act2_TheStreet">>
                    <</link>>
                    <span class="btn-sub">Leave the alley behind.</span>
                </button>
            </div>

        <<elseif $street_phase == "alley_flee">>
            
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                THE ALLEYWAY - RESOLUTION
            </div>

            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-red); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                You stumble backward in horror. You turn and sprint in the opposite direction, cutting through a narrow chain-link gate to put a barrier between you and the feeding frenzy.
                <br><br>
                You burst through the gate, chest heaving, and find yourself in a wide, open space.
                <br><br>
                <span style="color:var(--accent-red); font-weight:bold;">[-5 HUMANITY]</span>
                <<run window.animateStatBar('.bar-fill.humanity', $hum, 100)>>
            </div>

            <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
                <button>
                    <<link "Catch your breath and look around">>
                        <<run setup.sound.fade("alley_riot", 2000)>>
                        <<run setup.sound.play("parking_ambience", "audio/bgm/parking_lot_wind.mp3", true, 0.5)>>
                        <<set $street_phase to "parking_lot">>
                        <<goto "Act2_TheStreet">>
                    <</link>>
                    <span class="btn-sub">Assess your surroundings.</span>
                </button>
            </div>


        <!-- ══════════════════════════════════════════════════════════════════════════
           SCENE 4: THE PARKING LOT (CAR ESCAPE)
           ══════════════════════════════════════════════════════════════════════════ -->
        <<elseif $street_phase == "parking_lot">>
            
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                THE PARKING LOT
            </div>

            <!-- IMAGE 3: THE GETAWAY CAR -->
            <div style="width: 100%; max-width: 700px; margin: 0 auto 20px auto; border: 2px solid var(--accent-blue); overflow: hidden; position: relative; box-shadow: 0 5px 20px rgba(93, 141, 181, 0.4);">
                <img src="image/Act2Street/blue_sedan.gif" style="width: 100%; height: auto; display: block; opacity: 0.9; filter: contrast(1.1) brightness(0.9);">
            </div>

            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                You are standing in a gated parking lot behind a mid-rise office building. It's mostly empty, but parked near the exit ramp is a blue four-door sedan. The windows are intact. The tires are fully inflated. 
                <br><br>
                It is your ticket out of this hellhole. You just need to get it running.
            </div>

            <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
                
                <!-- CHECK 1: CAR KEYS -->
                <<if $inventory.find(i => i.id === "Car Keys")>>
                    <button style="border-left-color: var(--accent-gold) !important;">
                        <<link "Use the Car Keys you found">>
                            <<run setup.sound.play("chirp", "audio/sfx/keyfob_chirp.mp3", false, 0.8)>>
                            <<run setTimeout(function(){ setup.sound.play("unlock", "audio/sfx/heavy_door_clack.mp3", false, 1.0); }, 600)>>
                            <<set $street_phase to "ignition_keys">>
                            <<goto "Act2_TheStreet">>
                        <</link>>
                        <span class="btn-sub"><b style="color:var(--accent-gold);">[ITEM: CAR KEYS]</b> Use the keys you took from Unit 401.</span>
                    </button>

                <!-- CHECK 2: ASK VANE -->
                <<elseif $vane_status == "joined">>
                    <button style="border-left-color: var(--accent-blue) !important;">
                        <<link "Ask Vane if he knows how to start it">>
                            <<run setup.sound.play("smash", "audio/sfx/elbow_smash_glass.mp3", false, 0.9)>>
                            <<run setTimeout(function(){ setup.sound.play("engine", "audio/sfx/engine_sputter_roar.mp3", false, 0.8); }, 1500)>>
                            <<set $street_phase to "ignition_vane">>
                            <<goto "Act2_TheStreet">>
                        <</link>>
                        <span class="btn-sub"><b style="color:var(--accent-blue);">[COMPANION]</b> See if Vane has any hidden talents.</span>
                    </button>

                <!-- CHECK 3: HOTWIRE (TECH) -->
                <<elseif hasTrait("HOTWIRE") or $skills.tech >= 2>>
                    <button style="border-left-color: var(--accent-gold) !important;">
                        <<link "Hotwire the sedan [TECH]">>
                            <<run setup.sound.play("smash", "audio/sfx/elbow_smash_glass.mp3", false, 0.9)>>
                            <<run setTimeout(function(){ setup.sound.play("engine", "audio/sfx/engine_sputter_roar.mp3", false, 0.8); }, 1500)>>
                            <<set $street_phase to "ignition_hotwire">>
                            <<goto "Act2_TheStreet">>
                        <</link>>
                        <span class="btn-sub"><b style="color:var(--accent-gold);">[TECH 2 / MECHANIC]</b> Strip the wires and bypass the ignition.</span>
                    </button>

                <!-- CHECK 4: BRUTE FORCE -->
                <<else>>
                    <button style="border-left-color: var(--accent-red) !important;">
                        <<link "Smash the window and search for keys">>
                            <<run setup.sound.play("smash", "audio/sfx/elbow_smash_glass.mp3", false, 0.9)>>
                            <<run setTimeout(function(){ setup.sound.play("alarm", "audio/sfx/car_alarm_wail.mp3", true, 0.9); }, 500)>>
                            <<set $street_phase to "ignition_smash">>
                            <<goto "Act2_TheStreet">>
                        <</link>>
                        <span class="btn-sub"><b style="color:var(--accent-red);">[RISK: NOISE]</b> You don't have keys or tools. Break in and hope for the best.</span>
                    </button>
                <</if>>

            </div>

        <!-- ══════════════════════════════════════════════════════════════════════════
           SCENE 5: IGNITION RESOLUTIONS (ALL LEADING TO COMBAT)
           ══════════════════════════════════════════════════════════════════════════ -->
        
        <!-- KEYS RESOLUTION -->
        <<elseif $street_phase == "ignition_keys">>
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                IGNITION
            </div>
            
            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-green); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                <span id="vn-text-keys">
                    You reach into your pocket and pull out the keys you pried from the dead man's fingers in Unit 401. 
                    <br><br>
                    You hit the unlock button. The sedan chirps happily, its headlights flashing brightly in the dark. The doors unlock with a heavy <i>*clack*</i>. In the middle of the apocalypse, it feels like absolute magic.
                    
                    <<if $vane_status == "joined">>
                        <br><br>
                        Vane stares at you, a slow, genuinely impressed smile spreading across his exhausted face.
                        <br><br>
                        <<chat "Vane" "image/avatars/vane.gif" "right" "Okay. Remind me never to underestimate you. And here I thought my unboxing videos were slick.">>
                    <</if>>
                    
                    <div class="choice-menu" style="margin-top:20px;">
                        <button style="border-left-color: var(--accent-red) !important; background: rgba(138,28,28,0.2);">
                            <<link "Next ▼">>
                                <<replace "#vn-text-keys">>
                                    But the magic doesn't last. The sudden bright flash of the headlights and the sharp chirp of the horn echo like a dinner bell through the empty lot.
                                    <br><br>
                                    From the deep shadows, three infected step into the amber glow of the streetlights, drawn by the sudden noise and light. 
                                    <br><br>
                                    You're going to have to defend the car while the engine warms up.
                                    
                                    <div class="choice-menu" style="margin-top:20px;">
                                        <button style="border-left-color: var(--accent-red) !important;">
                                            <<link "Draw your weapon">>
                                                <<goto "Act2_ParkingLot_Combat">>
                                            <</link>>
                                        </button>
                                    </div>
                                <</replace>>
                            <</link>>
                        </button>
                    </div>
                </span>
            </div>

        <!-- VANE RESOLUTION -->
        <<elseif $street_phase == "ignition_vane">>
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                IGNITION
            </div>
            
            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-blue); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                <span id="vn-text-vane">
                    You look at the steering column, then look at Vane.
                    <br><br>
                    Vane smirks, a sudden, sharp flash of confidence cutting through his terror. He wraps his jacket around his elbow and smashes the driver's window inward, clearing the glass quickly before sliding into the seat.
                    <br><br>
                    <<chat "Vane" "image/avatars/vane.gif" "right" "Watch the paint.">>
                    
                    <div class="choice-menu" style="margin-top:20px;">
                        <button style="border-left-color: var(--accent-red) !important; background: rgba(138,28,28,0.2);">
                            <<link "Next ▼">>
                                <<replace "#vn-text-vane">>
                                    He pulls a multi-tool from his pocket, wedges it under the steering column, and pops the plastic casing with practiced ease. 
                                    <br><br>
                                    <<chat "Vane" "image/avatars/vane.gif" "right" "Misspent youth. Before the brand deals and the sponsorships, I hung out with a very different crowd.">>
                                    <br>
                                    He strips two wires, twists them together, and the engine roars to life. But the roaring engine and the shattered glass shatter the silence of the parking lot. 
                                    <br><br>
                                    From the darkness, three infected sprint toward the sound. Vane ducks lower inside the car. 
                                    <br><br>
                                    <<chat "Vane" "image/avatars/vane.gif" "right" "I'll get it in gear! Just keep them off me for thirty seconds!">>
                                    
                                    <div class="choice-menu" style="margin-top:20px;">
                                        <button style="border-left-color: var(--accent-red) !important;">
                                            <<link "Defend the car">>
                                                <<goto "Act2_ParkingLot_Combat">>
                                            <</link>>
                                        </button>
                                    </div>
                                <</replace>>
                            <</link>>
                        </button>
                    </div>
                </span>
            </div>

        <!-- HOTWIRE RESOLUTION -->
        <<elseif $street_phase == "ignition_hotwire">>
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                IGNITION
            </div>
            
            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-gold); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                <span id="vn-text-hotwire">
                    You smash the driver's side window with your elbow, clear the glass, and unlock the door. 
                    <br><br>
                    Diving under the steering column, you rip away the plastic paneling. You strip the ignition wires and strike them together. A spark flashes in the dark, and the engine roars to life on the second try. 
                    
                    <div class="choice-menu" style="margin-top:20px;">
                        <button style="border-left-color: var(--accent-red) !important; background: rgba(138,28,28,0.2);">
                            <<link "Next ▼">>
                                <<replace "#vn-text-hotwire">>
                                    The engine is running, but it's acting like a beacon. The roaring mechanical sound cuts through the night air.
                                    <br><br>
                                    From the shadows of the parking lot, three infected step into the amber glow of the streetlights, drawn directly to you. You have to clear them out before you can safely get in and drive away.
                                    
                                    <div class="choice-menu" style="margin-top:20px;">
                                        <button style="border-left-color: var(--accent-red) !important;">
                                            <<link "Draw your weapon">>
                                                <<goto "Act2_ParkingLot_Combat">>
                                            <</link>>
                                        </button>
                                    </div>
                                <</replace>>
                            <</link>>
                        </button>
                    </div>
                </span>
            </div>

        <!-- SMASH RESOLUTION (COMBAT TRIGGER) -->
        <<elseif $street_phase == "ignition_smash">>
            <div style="text-align:center; color:#888; font-size:0.8em; margin-bottom:15px; letter-spacing:3px; font-family: 'Oswald', sans-serif;">
                IGNITION
            </div>
            
            <div style="background: rgba(0,0,0,0.6); padding: 20px; border-left: 3px solid var(--accent-red); font-family: 'Courier Prime', monospace; color: #ccc; font-size: 0.95em; line-height: 1.5; margin: 0 auto 25px auto; max-width: 700px; width: 100%; box-sizing: border-box; text-align: left;">
                You have no idea how to hotwire a car, and you don't have the keys. You wrap your jacket around your fist and smash the driver's side window. 
                <br><br>
                <i>BEEP! BEEP! BEEP!</i>
                <br><br>
                The car alarm immediately triggers, a deafening wail echoing off the concrete buildings. You frantically tear through the glovebox and center console—nothing. 
                <br><br>
                <<run window.shakeScreen(15)>>
                
                /* STOP PARKING LOT AMBIENCE BECAUSE THE ALARM IS TOO LOUD */
                <<run setup.sound.stop("parking_ambience")>>
                
                From the shadows of the parking lot, three infected step into the amber glow of the streetlights, drawn by the noise. You're going to have to fight for this car.
                <br><br>
                <span style="color:var(--accent-red); font-weight:bold;">[CAR ALARM TRIGGERED - PREPARE FOR COMBAT]</span>
            </div>

            <div class="choice-menu" style="max-width: 700px; width: 100%; margin: 0 auto;">
                <button style="border-left-color: var(--accent-red) !important; background: rgba(138,28,28,0.2);">
                    <<link "Draw your weapon">>
                        <<goto "Act2_ParkingLot_Combat">>
                    <</link>>
                </button>
            </div>

        <</if>>

    </div>
</div>