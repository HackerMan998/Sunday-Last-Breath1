:: Prologue {"position":"200,300","size":"100,100"}
<<set $inCharCreation to false>>
<<set $stamina to $stamina_max>>
<<set $hp to $hp_max>>
<<set $hubStep to 1>>

<!-- ======================================================= -->
<!-- 1. JAVASCRIPT SETUP & AUDIO INITIALIZATION              -->
<!-- ======================================================= -->
<<script>>
    State.variables.gameClockActive = true;
    
    if(State.variables.creation_music) {
        setup.sound.fade("creation_theme", 2000);
        setTimeout(function() {
            setup.sound.stop("creation_theme");
            setup.sound.play("atmosphere", "audio/bgm/atmosphere.mp3", true, 0.6);
        }, 2000);
        State.variables.creation_music = false;
        
        ['clock', 'static', 'siren', 'scream'].forEach(function(id) {
            if (setup.sound.tracks[id]) setup.sound.stop(id);
        });
    }

    if (!State.variables.hasPacked && State.variables.inventory && State.variables.inventory.length > 0) {
        State.variables.tableStash = clone(State.variables.inventory);
        State.variables.inventory = [];
    }
<</script>>

<!-- ======================================================= -->
<!-- 2. VN LAYOUT WRAPPER                                    -->
<!-- ======================================================= -->
<div class="vn-container">
    
    <div class="vn-stage">
        <img src="image/living_room_red.gif" class="tv-static-img">
    </div>

    <div class="vn-dialogue-box">
        
        <div id="vn-text">
            <!-- PAGE 1: FIRST VISIT ONLY -->
            <<if not $prologue_intro_seen>>
                You turn away from the glass. The silence in your apartment breaks—not with a scream, but with a tone.
                <div style="border: 2px solid #8a1c1c; background: rgba(50, 0, 0, 0.3); padding: 10px 15px; margin: 10px 0 15px 0; box-shadow: 0 0 15px #8a1c1c;">
                    <div class="glitch" style="font-size: 1.2em; color: #e74c3c; font-weight: bold; width: 100%; text-align: center; letter-spacing: 2px; margin-top: 0;">
                        EMERGENCY ALERT SYSTEM
                    </div>
                    <div style="text-align: center; color: white; letter-spacing: 4px; border-top: 1px solid #8a1c1c; margin-top: 5px; padding-top: 5px; font-family: 'Oswald', sans-serif;">
                        CIVIL DANGER WARNING
                    </div>
                    <p style="color: #ffcccc; font-family: 'Courier Prime', monospace; font-size: 0.9em; margin-top: 10px; margin-bottom: 0;">
                        "The following message is transmitted at the request of the King County Sheriff's Office. This is not a test.<br><br>
                        A Civil Danger Warning is in effect for the Seattle metropolitan area. At 21:46, authorities reported a rapidly spreading biological hazard. Affected individuals exhibit extreme, unprovoked violence. The pathogen is highly contagious through fluid contact.<br><br>
                        Shelter in place immediately. Major interstates are closed. Lock all doors, turn off lights, and remain completely silent. Do not approach infected individuals.<br><br>
                        The National Guard has been deployed. Lethal force is authorized."
                    </p>
                </div>
                <<script>>
                    /* PLAY TTS EMERGENCY BROADCAST HERE (Set to loop until cut off) */
                    setup.sound.play("ebs_warning", "audio/sfx/ebs_warning.mp3", true, 0.8);
                <</script>>
            <</if>>
        </div>
        
        <div id="vn-action-area">
            <!-- RETURNING PLAYERS SEE MENU INSTANTLY -->
            <<if $prologue_intro_seen>>
                <<include "Prologue_Menu">>
            <</if>>
        </div>
        
        <<if not $prologue_intro_seen>>
            <div class="vn-prompt-text">
                CLICK TO CONTINUE <span class="vn-prompt-icon">▶</span>
            </div>
        <</if>>

        <div id="vn-advance" style="display:none;">
            <<link "Next">>
                <<set $hubStep++>>
                
                <!-- PAGE 2: THE REACTION -->
                <<if $hubStep is 2>>
                    <<replace "#vn-text">>
                        <<script>>
                            /* KILLS THE ROBOTIC VOICE AND RESTARTS THE CREEPY STATIC */
                            setup.sound.stop("ebs_warning");
                            setup.sound.play("static", "audio/sfx/static.mp3", true, 0.3);
                        <</script>>
                        The robotic voice cuts out. Static returns to the TV. 
                        <br><br>
                        <<chat "You" "image/avatars/player.gif" "left" "'Lethal force authorized...' They don't lock down the whole city for a standard riot. Something is very wrong.">>
                    <</replace>>
                    
                <!-- PAGE 3: THE GEAR -->
                <<elseif $hubStep is 3>>
                    <<replace "#vn-text">>
                        <div class="vn-speaker">LIVING ROOM</div><br>
                        You are standing in the middle of your living room in your pajamas. You feel naked. Vulnerable. 
                        <br><br>
                        Your <b>Starter Gear</b> is scattered across your cramped desk, illuminated by the red glow of the TV.
                        <br><br>
                        
                        <div style="background:rgba(255,255,255,0.05); padding:10px; border:1px dashed #444; margin: 5px auto; max-width: 600px; border-radius: 4px;">
                            <<if $tableStash && $tableStash.length > 0>>
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(80px, 1fr)); gap: 15px;">
                                    <<for _i range $tableStash>>
                                        <div style="text-align:center;">
                                            <<print setup.items[_i.id].icon>><br>
                                            <span style="font-size:0.7em; color:#aaa; display: block; margin-top: 5px;">_i.id</span>
                                        </div>
                                    <</for>>
                                </div>
                            <<else>>
                                <div style="text-align:center; color:#666; font-style:italic;">(Table is empty)</div>
                            <</if>>
                        </div>
                    <</replace>>
                    
                <!-- PAGE 4: THE MENU -->
                <<elseif $hubStep is 4>>
                    <<set $prologue_intro_seen to true>>
                    <<run $('.vn-prompt-text').remove()>>
                    <<replace "#vn-text">><</replace>>
                    <<replace "#vn-action-area">>
                        <<include "Prologue_Menu">>
                    <</replace>>
                <</if>>
            <</link>>
        </div>
    </div>
</div>